{% for video in libraryVideos %}<label class="calendar-video-card"><input type="radio" name="videos[]" value="{{ video.id }}" required><span class="calendar-video-preview"><video src="{{ path('app_video_stream',{id:video.id}) }}#t=0.1" preload="none" muted playsinline aria-hidden="true" data-calendar-target="preview"></video><span>{{ (video.duration/60)|round(0,'floor') }}:{{ '%02d'|format(video.duration|round(0,'floor') % 60) }}</span></span><span class="calendar-video-info"><strong>{{ video.title }}</strong><small>{{ video.height > video.width ? 'Vertical' : (video.height == video.width ? 'Carré' : 'Horizontal') }} · {{ video.mimeType == 'video/mp4' ? 'MP4' : 'WebM' }}</small></span></label>{% else %}<p class="calendar-no-results">Aucune vidéo trouvée. Essaie un autre nom.</p>{% endfor %}
