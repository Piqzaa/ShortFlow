{% extends 'studio/base.html.twig' %}
{% block title %}Confirmer l’action — VydFlow{% endblock %}
{% block studio_content %}
{% set backUrl = action == 'delete' ? path('app_dashboard',{tab:'drafts'}) : path('app_draft',{id:draft.id}) %}
<div class="video-delete-panel"><a class="account-secondary" href="{{ backUrl }}">← {{ action == 'delete' ? 'Revenir aux brouillons' : 'Revenir à la préparation' }}</a><h1>{{ action == 'delete' ? 'Supprimer cette préparation ?' : (action == 'cancel' ? 'Annuler la programmation ?' : 'Reprendre la préparation ?') }}</h1><p>{{ draft.title }}</p><p>{{ action == 'delete' ? 'Les vidéos de ta bibliothèque et les contenus sociaux sont conservés.' : (action == 'cancel' ? 'Les textes restent enregistrés. L’annulation est possible tant que le départ du lot n’est pas engagé.' : 'Toute programmation encore active sera désarmée. Tu devras confirmer à nouveau les textes et le créneau avant un envoi.') }}</p>{{ form_start(form) }}{{ form_errors(form) }}<div class="batch-actions"><button class="button{{ action == 'delete' ? ' button-danger' : '' }}" type="submit">{{ action == 'delete' ? 'Supprimer la préparation' : (action == 'cancel' ? 'Confirmer l’annulation' : 'Reprendre et modifier') }}</button><a class="account-secondary" href="{{ backUrl }}">Garder la préparation</a></div>{{ form_end(form) }}</div>
{% endblock %}
