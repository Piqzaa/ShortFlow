{% set url = item.draft_id ? path('app_draft',{id:item.draft_id}) : (item.episode_id ? path('app_series_episode',{id:item.episode_id}) : path('app_series_show',{id:item.series_id})) %}
{% if view == 'agenda' %}
<a class="calendar-production" data-production-state="{{ item.state }}" aria-label="{{ item.origin }} · {{ item.title }}, {{ productionLabels[item.state] }}, créneau visé le {{ item.at|date('d/m/Y à H:i',zone) }}" href="{{ url }}"><time>{{ item.at|date('d/m',zone) }}<span>{{ item.at|date('H:i',zone) }}</span></time><span><strong>{{ item.title }}</strong><small>{{ productionLabels[item.state] }} · {{ item.origin }}</small><small>Créneau visé · publication à confirmer</small></span><span aria-hidden="true">↗</span></a>
{% else %}
<a class="{{ view == 'grid' ? 'calendar-entry calendar-production' : 'calendar-production-pending' }}" data-production-state="{{ item.state }}" aria-label="{{ item.origin }} · {{ item.title }}, {{ productionLabels[item.state] }}, {{ view == 'grid' ? 'créneau visé' : 'sans date' }}" title="{{ item.title }} · {{ productionLabels[item.state] }} · {{ view == 'grid' ? 'créneau visé' : 'sans date' }}" href="{{ url }}">{% if view == 'grid' %}<time>{{ item.at|date('H:i',zone) }} · visé</time>{% endif %}<strong>{{ item.title }}</strong><span>{{ productionLabels[item.state] }}</span><small>{{ item.origin }}{% if view == 'grid' %} · publication à confirmer{% else %} · sans date{% endif %}</small></a>
{% endif %}
