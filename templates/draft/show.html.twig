{% extends 'studio/base.html.twig' %}
{% block title %}{{ draft.title }} — VydFlow{% endblock %}
{% block studio_content %}
{% if draft.episode %}<a class="account-secondary composer-back" href="{{ path('app_series_episode',{id:draft.episode.id}) }}">← {{ draft.episode.title }}</a><p class="library-note">Préparation liée à la version vidéo choisie dans cet épisode. Changer la validation de l’épisode ne remplace pas cette vidéo.</p>{% endif %}
<a class="account-secondary" href="{{ path('app_preparations') }}">← Toutes les préparations</a>
<div class="studio-heading"><div><span class="eyebrow">{{ labels[states[draft.id]] }}</span><h1 class="draft-title">{{ draft.title }}</h1><p>Sauvegardée le {{ draft.updatedAt|date('d/m/Y à H:i') }} · version {{ draft.revision }}</p></div></div>
{% if draft.notice %}<div class="account-notice" role="status">{{ draft.notice }}</div>{% endif %}
{% if states[draft.id] == 'missed' %}<div class="account-notice" role="status">Le créneau est dépassé. Aucun nouveau départ ne sera lancé : modifie la préparation et confirme une nouvelle date.</div>{% endif %}
{% if draft.scheduledAt %}<div class="batch-total"><strong>↗</strong><p>{{ draft.scheduledAt|date('d/m/Y à H:i',draft.timezone) }} · {{ draft.timezone }}<br>{{ draft.status == 'draft' ? 'Créneau proposé, non confirmé.' : 'Créneau de la préparation.' }}</p></div>{% endif %}
<div class="batch-actions">{% if draft.status != 'dispatched' %}<a class="button small button-outline" href="{{ (draft.status == 'draft' ? path('app_composer_start',{draft:draft.id}) : path('app_draft_action',{id:draft.id,action:'edit'})) }}">{{ draft.status == 'scheduled' ? 'Désarmer et modifier' : 'Modifier les textes et réseaux' }}</a>{% if draft.status == 'draft' and not draft.episode %}<a class="account-secondary" href="{{ path('app_draft_sources',{id:draft.id}) }}">Modifier les vidéos</a>{% endif %}{% if draft.status in ['scheduled','blocked'] %}<a class="account-secondary" href="{{ path('app_draft_action',{id:draft.id,action:'cancel'}) }}">Annuler la programmation</a>{% endif %}{% if draft.status in ['draft','cancelled'] %}<a class="video-delete-link" href="{{ path('app_draft_action',{id:draft.id,action:'delete'}) }}">Supprimer la préparation</a>{% endif %}{% else %}<a class="button small" href="{{ path('app_publications') }}">Suivre les destinations ↗</a>{% endif %}</div>
{% for item in draft.items %}{% if not item.source %}<p class="account-notice" role="alert">{{ item.title }} : la source a été supprimée. Modifie la sélection avant de publier.</p>{% endif %}{% endfor %}

{% if networks %}{% include 'publication/_batch_review.html.twig' %}{% else %}<div class="draft-previews">{% for item in draft.items %}{% include 'draft/_preview.html.twig' %}{% endfor %}</div><p class="library-note">Aucun réseau choisi. Reprends la préparation pour choisir tes destinations.</p>{% endif %}
{% if draft.status == 'draft' %}<section class="draft-planning"><h2>Quand publier ?</h2><p class="library-note">Le récapitulatif suivant demande ta confirmation. Choisir une date n’active aucun envoi.</p>{{ form_start(form,{attr:{class:'publication-form account-form batch-form','data-controller':'unsaved','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}{{ form_errors(form) }}{% include 'draft/_plan_fields.html.twig' %}<button class="button" type="submit">Vérifier et confirmer ↗</button>{{ form_end(form) }}</section>{% endif %}
{% endblock %}
