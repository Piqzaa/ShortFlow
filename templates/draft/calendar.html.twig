{% extends 'studio/base.html.twig' %}
{% block title %}Calendrier — VydFlow{% endblock %}
{% block studio_content %}
<div class="calendar-workspace" data-controller="calendar" data-calendar-search-url-value="{{ path('app_calendar_videos') }}" style="--calendar-weeks:{{ weeks }}"><div class="studio-heading calendar-heading"><div><span class="eyebrow">TES PROCHAINS DÉPARTS</span><h1>Calendrier.</h1><p>Créneaux visés et suivi par destination · {{ zone }}</p></div><a class="button small" href="{{ path('app_drafts') }}">Mes préparations ↗</a></div>
<details class="calendar-filters"><summary>Filtres et fuseau horaire</summary><form class="publication-filters" method="get"><div><label for="calendar-month">Mois</label><input id="calendar-month" type="month" name="month" value="{{ month|date('Y-m',zone) }}"></div><div><label for="calendar-zone">Fuseau de consultation</label><select name="zone" id="calendar-zone">{% for value in [zone,'Europe/Paris','UTC','America/New_York','America/Toronto','Asia/Tokyo']|filter(v=>v!= '') %}{% if loop.first or value != zone %}<option value="{{ value }}"{% if value == zone %} selected{% endif %}>{{ value }}</option>{% endif %}{% endfor %}</select></div><div><label for="calendar-network">Réseau</label><select name="network" id="calendar-network"><option value="">Tous</option>{% for value,label in networks %}<option value="{{ value }}"{% if value==network %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><div><label for="calendar-state">État</label><select name="state" id="calendar-state"><option value="">Tous</option>{% for value,label in labels %}<option value="{{ value }}"{% if value==state %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><button class="button small" type="submit">Afficher</button></form></details>
<nav class="calendar-nav" aria-label="Mois du calendrier"><a href="{{ path('app_calendar',{month:previous,zone:zone,network:network,state:state}) }}">← Mois précédent</a><h2>{{ month|date('m/Y',zone) }}</h2><a href="{{ path('app_calendar',{month:next,zone:zone,network:network,state:state}) }}">Mois suivant →</a></nav>
{% set entries = days|reduce((total,day)=>total+day.entries|length,0) %}{% if not entries %}<p class="visually-hidden">Aucun départ dans cette période. Choisis un jour pour préparer une publication.</p>{% endif %}
<div class="calendar-weekdays" aria-hidden="true">{% for day in ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'] %}<span>{{ day }}</span>{% endfor %}</div><div class="calendar-grid">{% for key,day in days %}<section class="calendar-day{{ day.outside?' outside':'' }}{{ not day.entries?' empty':'' }}" aria-label="{{ day.date|date('d/m/Y',zone) }}"><h3><a class="calendar-create-day" data-action="click->calendar#open" data-date="{{ key }}" href="{{ path('app_composer_start',{date:key,zone:zone}) }}" aria-label="Préparer une publication le {{ day.date|date('d/m/Y',zone) }}"><time datetime="{{ key }}"><span class="calendar-day-desktop">{{ day.date|date('d',zone) }}</span><span class="calendar-day-mobile">{{ day.date|date('d/m/Y',zone) }}</span></time><span aria-hidden="true">+</span></a></h3>{% for draft in day.entries %}<a class="calendar-entry" aria-label="{{ draft.title }}, {{ labels[states[draft.id]] }}" title="{{ draft.title }}" href="{{ path('app_draft',{id:draft.id}) }}"><time>{{ (draft.scheduledAt ?: draft.dispatchedAt)|date('H:i',zone) }}</time><strong>{{ draft.title }}</strong><span class="state-{{ states[draft.id] }}">{{ labels[states[draft.id]] }}</span><small>{{ draft.networks|map(n=>networks[n])|join(' · ') }}</small></a>{% endfor %}</section>{% endfor %}</div>
<section class="calendar-mobile-agenda" aria-label="Publications de la période"><h2>Au programme</h2>{% set hasEntries = false %}{% for day in days %}{% for draft in day.entries %}{% set hasEntries = true %}<a href="{{ path('app_draft',{id:draft.id}) }}"><time>{{ day.date|date('d/m',zone) }}<span>{{ (draft.scheduledAt ?: draft.dispatchedAt)|date('H:i',zone) }}</span></time><span><strong>{{ draft.title }}</strong><small>{{ labels[states[draft.id]] }} · {{ draft.networks|map(n=>networks[n])|join(' · ') }}</small></span><span aria-hidden="true">↗</span></a>{% endfor %}{% endfor %}{% if not hasEntries %}<p>Aucun départ prévu. Choisis une date pour préparer une vidéo.</p>{% endif %}</section>
<dialog class="calendar-dialog" data-calendar-target="dialog" data-action="close->calendar#closed" aria-labelledby="calendar-dialog-title"><div class="calendar-dialog-heading"><h2 id="calendar-dialog-title">Préparer une publication</h2><button type="button" class="account-secondary" data-action="calendar#close" aria-label="Fermer">×</button></div><p data-calendar-target="label"></p>{% if libraryVideos %}<form action="{{ path('app_composer_start') }}" method="get" class="account-form"><input type="hidden" name="date" data-calendar-target="date"><input type="hidden" name="zone" value="{{ zone }}"><fieldset class="calendar-picker"><legend>Quelle vidéo veux-tu programmer ?</legend><label class="visually-hidden" for="calendar-video-search">Rechercher une vidéo par son nom</label><input type="search" id="calendar-video-search" placeholder="Rechercher une vidéo…" maxlength="120" autocomplete="off" data-calendar-target="search" data-action="input->calendar#search keydown.enter->calendar#preventSubmit"><p class="calendar-search-status" role="status" aria-live="polite" data-calendar-target="status">{{ libraryTotal|default(libraryVideos|length) }} vidéo{{ libraryTotal|default(libraryVideos|length) > 1 ? 's' : '' }} · Les plus récentes d’abord</p><div class="calendar-video-list" data-calendar-target="list">{% include 'draft/_video_choices.html.twig' %}</div><button type="button" class="account-secondary calendar-more" data-calendar-target="more" data-page="2" data-action="calendar#more"{% if libraryTotal|default(libraryVideos|length) <= libraryVideos|length %} hidden{% endif %}>Afficher plus</button></fieldset><button class="button" type="submit" data-calendar-target="submit">Préparer la programmation →</button></form>{% else %}<p>Importe ta première vidéo pour préparer sa publication.</p>{% endif %}<a class="account-secondary" href="{{ path('app_video_upload',{next:'compose',zone:zone}) }}" data-calendar-target="upload">Importer une vidéo +</a><p class="library-note">Les réseaux, l’heure et les textes seront vérifiés avant confirmation.</p></dialog></div>
{% endblock %}
