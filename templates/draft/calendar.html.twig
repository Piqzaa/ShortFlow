{% extends 'studio/base.html.twig' %}
{% block title %}Calendrier — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading calendar-heading"><div><span class="eyebrow">TES PROCHAINS DÉPARTS</span><h1>Calendrier.</h1><p>Créneaux visés et suivi par destination · {{ zone }}</p></div><a class="button small" href="{{ path('app_drafts') }}">Mes préparations ↗</a></div>
<form class="publication-filters" method="get"><div><label for="calendar-month">Mois</label><input id="calendar-month" type="month" name="month" value="{{ month|date('Y-m',zone) }}"></div><div><label for="calendar-zone">Fuseau de consultation</label><select name="zone" id="calendar-zone">{% for value in [zone,'Europe/Paris','UTC','America/New_York','America/Montreal','Asia/Tokyo']|filter(v=>v!= '') %}{% if loop.first or value != zone %}<option value="{{ value }}"{% if value == zone %} selected{% endif %}>{{ value }}</option>{% endif %}{% endfor %}</select></div><div><label for="calendar-network">Réseau</label><select name="network" id="calendar-network"><option value="">Tous</option>{% for value,label in networks %}<option value="{{ value }}"{% if value==network %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><div><label for="calendar-state">État</label><select name="state" id="calendar-state"><option value="">Tous</option>{% for value,label in labels %}<option value="{{ value }}"{% if value==state %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></div><button class="button small" type="submit">Afficher</button></form>
<nav class="calendar-nav" aria-label="Mois du calendrier"><a href="{{ path('app_calendar',{month:previous,zone:zone,network:network,state:state}) }}">← Mois précédent</a><h2>{{ month|date('m/Y',zone) }}</h2><a href="{{ path('app_calendar',{month:next,zone:zone,network:network,state:state}) }}">Mois suivant →</a></nav>
<p class="library-note"><a href="{{ path('app_drafts') }}">{{ undated }} brouillon{{ undated>1?'s':'' }} sans date ↗</a> · Les anciennes publications restent accessibles dans <a href="{{ path('app_publications') }}">Publications</a>.</p>
{% set entries = days|reduce((total,day)=>total+day.entries|length,0) %}{% if entries %}<div class="calendar-weekdays" aria-hidden="true">{% for day in ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'] %}<span>{{ day }}</span>{% endfor %}</div><div class="calendar-grid">{% for key,day in days %}<section class="calendar-day{{ day.outside?' outside':'' }}{{ not day.entries?' empty':'' }}" aria-label="{{ day.date|date('d/m/Y',zone) }}"><h3><time datetime="{{ key }}"><span class="calendar-day-desktop">{{ day.date|date('d',zone) }}</span><span class="calendar-day-mobile">{{ day.date|date('d/m/Y',zone) }}</span></time></h3>{% for draft in day.entries %}<a class="calendar-entry" href="{{ path('app_draft',{id:draft.id}) }}"><time>{{ (draft.scheduledAt ?: draft.dispatchedAt)|date('H:i',zone) }}</time><strong>{{ draft.title }}</strong><span class="state-{{ states[draft.id] }}">{{ labels[states[draft.id]] }}</span><small>{{ draft.networks|map(n=>networks[n])|join(' · ') }}</small></a>{% endfor %}</section>{% endfor %}</div>
{% else %}<div class="studio-empty draft-empty"><h2>Aucun départ dans cette période.</h2><p>Enregistre une préparation, puis choisis un créneau et confirme-le.</p></div>{% endif %}
{% endblock %}
