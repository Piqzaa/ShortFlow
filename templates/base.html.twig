<!DOCTYPE html>
<html lang="fr" data-ai-exchange="{{ ai_exchange()|json_encode|e('html_attr') }}"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#09090d"><meta name="description" content="{% block meta_description %}VydFlow, ton studio vidéo en bêta : bibliothèque privée, montage guidé, Studio IA et séries. Prépare tes publications selon les accès de tes comptes connectés.{% endblock %}"><title>{% block title %}VydFlow — Tes vidéos. Trois réseaux. Un seul studio.{% endblock %}</title>{% set canonical = public_seo.canonical(app.request.attributes.get('_route')|default('')) %}
<meta name="robots" content="{{ public_seo.indexable(app.request) ? 'index, follow' : 'noindex, nofollow' }}">
{% if canonical %}
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="website"><meta property="og:site_name" content="VydFlow"><meta property="og:locale" content="fr_FR">
<meta property="og:title" content="{{ block('title')|striptags|trim }}"><meta property="og:description" content="{{ block('meta_description')|striptags|trim }}"><meta property="og:url" content="{{ canonical }}">
<meta name="twitter:card" content="summary"><meta name="twitter:title" content="{{ block('title')|striptags|trim }}"><meta name="twitter:description" content="{{ block('meta_description')|striptags|trim }}">
{% endif %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="{{ build_asset('app.css') }}"><script type="module" src="{{ build_asset('app.js') }}"></script></head><body data-controller="cursor accessibility"><a class="skip" href="#contenu">Aller au contenu</a>{% block body %}{% endblock %}</body></html>
