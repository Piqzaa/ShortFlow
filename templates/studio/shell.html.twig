{% extends 'base.html.twig' %}
{% block title %}Mon studio — VydFlow{% endblock %}
{% block body %}
{% set route = app.request.attributes.get('_route') %}
{% set calendarActive = route == 'app_calendar' %}
{% set publicationsActive = route == 'app_publications' or route == 'app_publication_statistics' %}
{% set accountActive = route == 'app_profile' %}
{% set connectionsActive = route == 'app_connections' %}
{% set sectionName = calendarActive ? 'Calendrier' : (publicationsActive ? 'Publications' : (connectionsActive ? 'Connexions' : (accountActive ? 'Mon compte' : 'Studio'))) %}
<div class="studio-shell studio-v2" data-controller="studio-navigation" data-action="click->studio-navigation#navigate submit->studio-navigation#submit">
<aside class="studio-sidebar"><a class="wordmark" href="{{ path('app_dashboard') }}" aria-label="VydFlow, mon studio">vydflow<span class="brand-dot">/</span></a><nav aria-label="Navigation du studio"><a href="{{ path('app_dashboard') }}"{% if not calendarActive and not publicationsActive and not accountActive and not connectionsActive %} aria-current="page"{% endif %}><span aria-hidden="true">▦</span> Studio</a><a href="{{ path('app_calendar') }}"{% if calendarActive %} aria-current="page"{% endif %}><span aria-hidden="true">▤</span> Calendrier</a><a href="{{ path('app_publications') }}"{% if publicationsActive %} aria-current="page"{% endif %}><span aria-hidden="true">↗</span> Publications</a><a href="{{ path('app_connections') }}"{% if connectionsActive %} aria-current="page"{% endif %}><span aria-hidden="true">↔</span> Connexions</a></nav><div class="studio-sidebar-bottom"><a class="studio-profile" href="{{ path('app_profile') }}"><span class="studio-avatar" aria-hidden="true">{% if app.user.avatarName %}<img src="{{ path('app_avatar',{name:app.user.avatarName}) }}" alt="" width="38" height="38">{% else %}{{ (app.user.displayName ?: app.user.email)|first|upper }}{% endif %}</span><div><strong>{{ app.user.displayName ?: 'Mon compte' }}</strong><small>{{ app.user.email }}</small></div></a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="studio-logout" type="submit" aria-label="Se déconnecter" title="Se déconnecter"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17v3H4V4h6v3M10 12h10m-4-4 4 4-4 4"/></svg><span>Se déconnecter</span></button></form></div></aside>
<main id="contenu" class="studio-main"><header class="studio-topbar"><a class="studio-mobile-brand wordmark" href="{{ path('app_dashboard') }}" aria-label="VydFlow, mon studio">vydflow<span class="brand-dot">/</span></a><span>MON ESPACE <span aria-hidden="true">/</span> {{ sectionName }}</span><a class="studio-top-account" href="{{ path('app_profile') }}">Mon compte ↗</a><div class="studio-mobile-session"><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="studio-logout" type="submit" aria-label="Se déconnecter" title="Se déconnecter"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17v3H4V4h6v3M10 12h10m-4-4 4 4-4 4"/></svg><span class="visually-hidden">Se déconnecter</span></button></form></div></header>
{% for label,messages in app.flashes %}{% for message in messages %}<div class="account-notice {{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</div>{% endfor %}{% endfor %}
{% block studio_content %}{% endblock %}<div class="studio-loading" role="status" aria-live="polite" data-studio-navigation-target="status" hidden></div></main><nav class="studio-bottom-nav" aria-label="Navigation mobile du studio">{% for item in [['app_dashboard','Studio','▦',not calendarActive and not publicationsActive and not connectionsActive and not accountActive],['app_calendar','Calendrier','▤',calendarActive],['app_publications','Publications','↗',publicationsActive],['app_connections','Connexions','↔',connectionsActive]] %}<a href="{{ path(item[0]) }}"{% if item[3] %} aria-current="page"{% endif %}><span aria-hidden="true">{{ item[2] }}</span>{{ item[1] }}</a>{% endfor %}</nav></div>
{% endblock %}
