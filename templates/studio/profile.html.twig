{% extends 'studio/base.html.twig' %}
{% block title %}Mon compte — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading"><div><span class="eyebrow">TON ESPACE PERSONNEL</span><h1>Mon compte.</h1><p>Retrouve tes informations et protège ton accès au studio.</p></div></div>
<div class="profile-grid"><section class="profile-panel" aria-labelledby="profile-details"><h2 id="profile-details">Tes informations</h2><dl><dt>Adresse email</dt><dd>{{ app.user.email }}</dd><dt>Confirmation</dt><dd>Adresse confirmée</dd><dt>Membre depuis</dt><dd>{{ app.user.createdAt|date('d/m/Y') }}</dd><dt>Bibliothèque privée</dt><dd>{{ usage.count }} vidéo{{ usage.count > 1 ? 's' : '' }} · {{ (usage.bytes / 1048576)|number_format(1, ',', ' ') }} Mo sur 1 Go</dd></dl><a class="account-secondary" href="{{ path('app_connections') }}">Gérer mes réseaux connectés ↗</a><p class="library-note">Ton adresse email n’est pas modifiable depuis cette page.</p><a class="account-secondary" href="{{ path('app_data_deletion') }}">Données personnelles et demande de suppression ↗</a></section>
<section class="profile-panel" aria-labelledby="password-title"><h2 id="password-title">Sécurité</h2><p>Après modification, reconnecte-toi avec ton nouveau mot de passe. Les anciens liens de récupération seront invalidés.</p>{{ form_start(form, {attr:{class:'account-form'}}) }}{{ form_errors(form) }}{{ form_row(form.currentPassword) }}{{ form_row(form.newPassword) }}<button class="button" type="submit">Modifier mon mot de passe ↗</button>{{ form_end(form) }}</section></div>
{% endblock %}
