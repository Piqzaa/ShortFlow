{% extends 'studio/base.html.twig' %}
{% block studio_content %}
<div class="studio-heading dashboard-intro"><div><span class="eyebrow">LE POINT DE DÉPART DE TES CRÉATIONS</span><h1>Ton studio.<br><span>Garde l’élan.</span></h1><p>Importe tes vidéos, retrouve tes idées et prépare la suite.</p><a class="button small" href="{{ path('app_video_upload') }}">Importer une vidéo <span aria-hidden="true">+</span></a></div></div>
<nav class="dashboard-summary" aria-label="État de ton studio">
<a href="{{ path('app_library') }}"><span>Dans ta bibliothèque</span><strong>{{ usage.count }}</strong><small>vidéo{{ usage.count > 1 ? 's' : '' }} · {{ (usage.bytes / 1048576)|number_format(1, ',', ' ') }} Mo utilisés ↗</small></a>
<a href="{{ path('app_publications', {state:'active'}) }}"><span>En cours</span><strong>{{ counts.active }}</strong><small>envoi{{ counts.active > 1 ? 's' : '' }} à suivre ↗</small></a>
<a href="{{ path('app_publications', {state:'attention'}) }}" class="{{ counts.attention ? 'needs-attention' : '' }}"><span>À traiter</span><strong>{{ counts.attention }}</strong><small>échecs, suspensions ou vérifications ↗</small></a>
<a href="{{ path('app_publications', {state:'published'}) }}"><span>Publiées</span><strong>{{ counts.published }}</strong><small>publications réussies, tous réseaux ↗</small></a>
</nav>
{% if attention %}<section class="dashboard-attention" aria-labelledby="attention-title"><div class="studio-section-heading"><h2 id="attention-title">À reprendre.</h2><a class="account-secondary" href="{{ path('app_publications', {state:'attention'}) }}">Tout voir ↗</a></div>{% for job in attention %}<a href="{{ path('app_publications', {state:'attention',network:job.network}) }}"><div><span class="eyebrow">{{ job.network == 'youtube' ? 'YOUTUBE' : 'INSTAGRAM' }}</span><strong>{{ job.title }}</strong></div><span>{{ {failed:'En échec',paused:'Envoi suspendu',review:'À vérifier sur le réseau'}[job.status] }} ↗</span></a>{% endfor %}</section>{% endif %}
<section class="dashboard-networks"><div><h2>Tes réseaux.</h2><p>{% for label,status in networks %}<span class="dashboard-network-state">{{ label }} · <strong>{{ status }}</strong></span>{% endfor %}</p></div><a class="account-secondary" href="{{ path('app_connections') }}">Gérer mes réseaux ↗</a></section>
<section class="studio-library" aria-labelledby="library-title"><div class="studio-section-heading"><h2 id="library-title">Tes dernières vidéos</h2><a class="dashboard-library-link" href="{{ path('app_library') }}">Toute la bibliothèque · {{ usage.count }} ↗</a></div>
{% if videos %}{% include 'library/_cards.html.twig' %}{% else %}<div class="studio-empty"><div class="studio-empty-art" aria-hidden="true"><span>+</span></div><h3>Une place pour tes prochaines vidéos.</h3><p>Importe ta première création dans ta bibliothèque privée.</p><a class="button small" href="{{ path('app_video_upload') }}">Importer ma première vidéo <span aria-hidden="true">↗</span></a></div>{% endif %}</section>
{% endblock %}
