{% extends 'studio/base.html.twig' %}
{% block title %}Ton studio — VydFlow{% endblock %}
{% block studio_content %}
<div class="workspace-heading"><div><span class="eyebrow">TON ESPACE CRÉATIF</span><h1>Ton studio.</h1><p>{{ choosing ? 'Choisis tes vidéos, ou importe une nouvelle création.' : 'Tes vidéos. La suite à préparer.' }}</p></div><a class="button" href="{{ path('app_composer_start') }}">Nouvelle publication +</a></div>
<div class="workspace-layout"><section class="workspace-library" aria-label="Vidéos et brouillons">
<nav class="workspace-tabs" aria-label="Vues du studio"><a href="{{ path('app_dashboard') }}"{% if tab == 'videos' %} aria-current="page"{% endif %}>Vidéos <span>{{ usage.count }}</span></a><a href="{{ path('app_dashboard',{tab:'drafts'}) }}"{% if tab == 'drafts' %} aria-current="page"{% endif %}>Brouillons <span>{{ draftCount }}</span></a><a href="{{ path('app_activity') }}">Activité ↗</a></nav>
{% if tab == 'videos' %}
{% if choosing %}<div class="workspace-import"><a class="account-secondary" href="{{ path('app_video_upload',{next:'compose',date:date,zone:zone}) }}">Importer une vidéo depuis mon appareil +</a>{% if date %}<span>Créneau à préparer : {{ date }}</span>{% endif %}</div>{% endif %}
{% if videos %}<form id="workspace-selection" action="{{ path('app_composer_start') }}" method="get" data-controller="selection"><input type="hidden" name="date" value="{{ date }}"><input type="hidden" name="zone" value="{{ zone }}"><div class="workspace-selection"><label><input type="checkbox" data-selection-target="all" data-action="selection#toggleAll"> Tout sélectionner</label><span data-selection-target="count">Choisis tes vidéos</span><button class="button small" type="submit" data-selection-target="submit">Préparer la sélection →</button><button class="account-secondary selection-delete" type="submit" formaction="{{ path('app_videos_delete') }}" data-selection-target="submit">Supprimer la sélection</button></div><div class="workspace-grid">
{% for video in videos %}<article class="workspace-card"><div class="workspace-cover"><a href="{{ path('app_composer_start',{videos:[video.id],date:date,zone:zone}) }}" aria-label="Préparer {{ video.title }}"><video src="{{ path('app_video_stream',{id:video.id}) }}#t=0.1" preload="metadata" muted playsinline aria-hidden="true"></video><span class="workspace-play" aria-hidden="true">↗</span></a><label class="workspace-check"><input type="checkbox" name="videos[]" value="{{ video.id }}" data-selection-target="item" data-action="selection#update"><span class="visually-hidden">Sélectionner {{ video.title }}</span></label><span class="workspace-duration">{{ (video.duration/60)|round(0,'floor') }}:{{ '%02d'|format(video.duration|round(0,'floor') % 60) }}</span></div><div class="workspace-card-meta"><div><h2><a href="{{ path('app_composer_start',{videos:[video.id],date:date,zone:zone}) }}">{{ video.title }}</a></h2><p>{{ video.mimeType == 'video/mp4' ? 'MP4' : 'WebM' }} · {{ video.height > video.width ? 'Vertical' : (video.height == video.width ? 'Carré' : 'Horizontal') }}</p></div><details class="workspace-options"><summary aria-label="Options de {{ video.title }}">•••</summary><div><a href="{{ path('app_video_show',{id:video.id}) }}">Voir / renommer</a><a href="{{ path('app_video_delete',{id:video.id}) }}">Supprimer</a></div></details></div>{% include 'library/_published.html.twig' %}</article>{% endfor %}
<a class="workspace-upload-card" href="{{ path('app_video_upload',{next:'compose',date:date,zone:zone}) }}"><span aria-hidden="true">+</span><strong>Importer une vidéo</strong><small>MP4 ou WebM · 100 Mo max.</small></a></div></form>
{% else %}<div class="workspace-empty"><span class="eyebrow">UNE PLACE POUR TES IDÉES</span><h2>Ta première vidéo commence ici.</h2><p>Importe une création, choisis tes réseaux et prépare son départ.</p><a class="button" href="{{ path('app_video_upload',{next:'compose',date:date,zone:zone}) }}">Importer ma première vidéo +</a><small>Bibliothèque privée · MP4 ou WebM · jusqu’à 3 minutes</small></div>{% endif %}
{% else %}<div class="workspace-drafts">{% for draft in drafts %}<article class="workspace-draft"><a class="workspace-draft-main" href="{{ path('app_composer_start',{draft:draft.id}) }}"><span class="workspace-draft-art" aria-hidden="true">{% if draft.items|length and (draft.items|first).source %}<video src="{{ path('app_video_stream',{id:(draft.items|first).source.id}) }}#t=0.1" preload="metadata" muted playsinline></video>{% else %}↗{% endif %}</span><div><h2>{{ draft.title }}</h2><p>{{ draft.items|length }} vidéo{{ draft.items|length > 1 ? 's' : '' }} · {{ draft.networks|length ? draft.networks|map(n=>{youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'}[n])|join(' · ') : 'Réseaux à choisir' }}</p><small>Modifié le {{ draft.updatedAt|date('d/m à H:i',app.user.timezone) }}</small></div><span>Reprendre →</span></a><a class="draft-delete" href="{{ path('app_draft_action',{id:draft.id,action:'delete'}) }}" aria-label="Supprimer le brouillon {{ draft.title }}">Supprimer</a></article>{% else %}<div class="workspace-empty"><h2>Aucun brouillon pour le moment.</h2><p>Tu peux préparer tes vidéos et continuer plus tard, même sans réseau connecté.</p><a class="button" href="{{ path('app_composer_start') }}">Préparer une publication</a></div>{% endfor %}</div>{% endif %}
{% if pages > 1 %}<nav class="library-pagination" aria-label="Pages du studio">{% if page > 1 %}<a href="{{ path('app_dashboard',{tab:tab,page:page-1,date:date,zone:zone,choose:choosing}) }}">← Précédente</a>{% endif %}<span>{{ page }} / {{ pages }}</span>{% if page < pages %}<a href="{{ path('app_dashboard',{tab:tab,page:page+1,date:date,zone:zone,choose:choosing}) }}">Suivante →</a>{% endif %}</nav>{% endif %}
<p class="workspace-storage">{{ (usage.bytes/1048576)|number_format(1,',',' ') }} Mo utilisés sur 1 Go · vidéos privées</p>
</section><aside class="workspace-agenda" aria-label="Prochains départs"><div class="workspace-agenda-title"><h2>La suite.</h2><a href="{{ path('app_calendar') }}" aria-label="Ouvrir le calendrier">↗</a></div>{% if preparations.counts.attention %}<a class="workspace-alert" href="{{ path('app_preparations') }}">{{ preparations.counts.attention }} préparation{{ preparations.counts.attention > 1 ? 's' : '' }} à vérifier →</a>{% endif %}{% for draft in preparations.upcoming %}<a class="workspace-event" href="{{ path('app_draft',{id:draft.id}) }}"><time>{{ draft.scheduledAt|date('d/m · H:i',draft.timezone) }}</time><strong>{{ draft.title }}</strong><small>{{ draft.networks|map(n=>{youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'}[n])|join(' · ') }}</small><span>{{ draft.timezone }}</span></a>{% else %}<div class="workspace-agenda-empty"><p>Ton prochain créneau t’attend.</p><small>Prépare une vidéo et choisis sa date de publication.</small></div>{% endfor %}<a class="account-secondary" href="{{ path('app_calendar') }}">Voir le calendrier →</a><div class="workspace-agenda-bottom"><span class="eyebrow">À TON RYTHME</span><p>Prépare maintenant.<br>Publie au bon moment.</p></div></aside></div>
{% endblock %}
