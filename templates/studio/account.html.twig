{% extends 'studio/base.html.twig' %}
{% block title %}Mon compte — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading"><div><span class="eyebrow">TON ESPACE PERSONNEL</span><h1>Mon compte.</h1><p>Un profil à toi, des réglages utiles et un accès protégé.</p></div></div>
<div class="account-workspace">
<details class="account-mobile-sections">
<summary>{{ {profile:'Profil',preferences:'Préférences',security:'Sécurité',subscription:'Abonnement'}[section] }} <span aria-hidden="true">⌄</span></summary>
<nav aria-label="Rubriques du compte">
{% for key,label in {profile:'Profil',preferences:'Préférences',security:'Sécurité'} %}<a href="{{ path('app_profile',{section:key}) }}"{% if section == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
<a href="{{ path('app_connections') }}">Réseaux connectés ↗</a><a href="{{ path('app_profile',{section:'subscription'}) }}"{% if section == 'subscription' %} aria-current="page"{% endif %}>Abonnement <small>À venir</small></a>
</nav></details>
<nav class="account-sections" aria-label="Réglages du compte">
{% for key,label in {profile:'Profil',preferences:'Préférences',security:'Sécurité'} %}<a href="{{ path('app_profile',{section:key}) }}"{% if section == key %} aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
<a href="{{ path('app_connections') }}">Réseaux connectés ↗</a><a href="{{ path('app_profile',{section:'subscription'}) }}"{% if section == 'subscription' %} aria-current="page"{% endif %}>Abonnement <small>À venir</small></a>
</nav>
<div class="account-content">
<section class="profile-panel"{% if section != 'profile' %} hidden{% endif %} aria-labelledby="profile-details">
<div class="profile-identity"><span class="studio-avatar profile-avatar" aria-hidden="true">{% if app.user.avatarName %}<img src="{{ path('app_avatar',{name:app.user.avatarName}) }}" alt="" width="80" height="80">{% else %}{{ (app.user.displayName ?: app.user.email)|first|upper }}{% endif %}</span><div><h2 id="profile-details">Ton profil</h2><p>{{ app.user.displayName ?: 'Personnalise ton espace.' }}</p></div></div>
{{ form_start(profileForm,{attr:{class:'account-form','data-controller':'unsaved','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}{{ form_errors(profileForm) }}{{ form_row(profileForm.displayName) }}{{ form_row(profileForm.avatar) }}{{ form_row(profileForm.removeAvatar) }}<button class="button" type="submit">Enregistrer mon profil</button>{{ form_end(profileForm) }}
<dl class="profile-facts"><div><dt>Adresse email</dt><dd>{{ app.user.email }} <span class="profile-verified">Confirmée</span></dd></div><div><dt>Membre depuis</dt><dd>{{ app.user.createdAt|date('d/m/Y') }}</dd></div><div><dt>Bibliothèque privée</dt><dd>{{ usage.count }} vidéo{{ usage.count > 1 ? 's' : '' }} · {{ (usage.bytes / 1048576)|number_format(1, ',', ' ') }} Mo sur 1 Go</dd></div></dl><p class="library-note">L’adresse de connexion reste inchangée. Ton profil et ta photo ne sont pas publiés sur tes réseaux.</p>
</section>
<section class="profile-panel"{% if section != 'preferences' %} hidden{% endif %} aria-labelledby="preferences-title"><h2 id="preferences-title">Tes préférences</h2>{{ form_start(preferencesForm,{attr:{class:'account-form'}}) }}{{ form_errors(preferencesForm) }}{{ form_row(preferencesForm.timezone) }}<button class="button" type="submit">Enregistrer mes préférences</button>{{ form_end(preferencesForm) }}<p class="library-note">Langue de l’interface : français.</p></section>
<section class="profile-panel"{% if section != 'security' %} hidden{% endif %} aria-labelledby="password-title"><h2 id="password-title">Sécurité</h2><p>Choisis un mot de passe unique. Après modification, tu devras te reconnecter.</p>{{ form_start(form,{attr:{class:'account-form'}}) }}{{ form_errors(form) }}{{ form_row(form.currentPassword) }}{{ form_row(form.newPassword) }}<button class="button" type="submit">Modifier mon mot de passe ↗</button>{{ form_end(form) }}<p class="library-note">La confirmation de ton adresse reste obligatoire. Les anciens liens de récupération sont invalidés après un changement de mot de passe.</p></section>
<section class="profile-panel"{% if section != 'subscription' %} hidden{% endif %} aria-labelledby="subscription-title"><span class="eyebrow">À VENIR</span><h2 id="subscription-title">Abonnement et facturation</h2><p>Les offres, factures et moyens de paiement seront regroupés ici lorsque l’abonnement VydFlow sera disponible.</p><p class="library-note">Aucun moyen de paiement n’est demandé ni enregistré actuellement.</p></section>
<section class="profile-legal" aria-labelledby="profile-legal-title"><h2 id="profile-legal-title">Tes données</h2><nav aria-label="Documents du compte"><a class="account-secondary" href="{{ path('app_privacy') }}">Confidentialité ↗</a><a class="account-secondary" href="{{ path('app_legal') }}">Informations légales ↗</a><a class="account-secondary" href="{{ path('app_data_deletion') }}">Mes droits et la suppression de mes données ↗</a></nav></section>
</div></div>
{% endblock %}
