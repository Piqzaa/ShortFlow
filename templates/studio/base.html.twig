{% extends 'base.html.twig' %}
{% block title %}Mon studio — VydFlow{% endblock %}
{% block body %}
{% set in_publications = app.request.attributes.get('_route') starts with 'app_publication' or app.request.attributes.get('_route') in ['app_instagram_prepare', 'app_instagram_job_action', 'app_tiktok_prepare', 'app_tiktok_job_action'] %}
{% set in_library = app.request.attributes.get('_route') starts with 'app_video' or app.request.attributes.get('_route') == 'app_library' %}
{% set studio_section = app.request.attributes.get('_route') == 'app_calendar' ? 'Calendrier' : (app.request.attributes.get('_route') starts with 'app_draft' ? 'Brouillons' : (in_library ? 'Bibliothèque' : (in_publications ? 'Publications' : (app.request.attributes.get('_route') == 'app_profile' ? 'Mon compte' : (app.request.attributes.get('_route') == 'app_connections' ? 'Réseaux' : 'Vue d’ensemble'))))) %}
<div class="studio-shell" data-controller="studio-navigation" data-action="click->studio-navigation#navigate submit->studio-navigation#submit">
  <aside class="studio-sidebar">
    <a class="wordmark" href="{{ path('app_dashboard') }}" aria-label="VydFlow, vue d’ensemble">vydflow<span class="brand-dot">/</span></a>
    <span class="studio-nav-label">ESPACE CRÉATIF</span>
    <nav aria-label="Navigation du studio"><a href="{{ path('app_dashboard') }}"{% if app.request.attributes.get('_route') == 'app_dashboard' %} aria-current="page"{% endif %}>Vue d’ensemble</a><a href="{{ path('app_library') }}"{% if in_library %} aria-current="page"{% endif %}>Bibliothèque</a><a href="{{ path('app_publications') }}"{% if in_publications %} aria-current="page"{% endif %}>Publications</a><a href="{{ path('app_drafts') }}"{% if app.request.attributes.get('_route') starts with 'app_draft' %} aria-current="page"{% endif %}>Brouillons</a><a href="{{ path('app_calendar') }}"{% if app.request.attributes.get('_route') == 'app_calendar' %} aria-current="page"{% endif %}>Calendrier</a><a href="{{ path('app_connections') }}"{% if app.request.attributes.get('_route') starts with 'app_youtube' or app.request.attributes.get('_route') == 'app_connections' %} aria-current="page"{% endif %}>Réseaux</a></nav>
    <a class="studio-profile" href="{{ path('app_profile') }}"{% if app.request.attributes.get('_route') == 'app_profile' %} aria-current="page"{% endif %}><span class="studio-avatar" aria-hidden="true">{{ app.user.email|first|upper }}</span><div><strong>Mon compte ↗</strong><small>{{ app.user.email }}</small></div></a>
    <form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="studio-logout" type="submit">Se déconnecter ↗</button></form>

  </aside>
  <main id="contenu" class="studio-main">
    <header class="studio-topbar"><span>MON STUDIO <span aria-hidden="true">/</span> {{ studio_section }}</span></header>
    <details class="studio-mobile-menu"><summary>Navigation · {{ studio_section }}</summary><nav class="studio-mobile-nav" aria-label="Navigation mobile du studio"><a href="{{ path('app_dashboard') }}"{% if app.request.attributes.get('_route') == 'app_dashboard' %} aria-current="page"{% endif %}>Vue d’ensemble</a><a href="{{ path('app_library') }}"{% if in_library %} aria-current="page"{% endif %}>Bibliothèque</a><a href="{{ path('app_video_upload') }}">+ Importer</a><a href="{{ path('app_publications') }}"{% if in_publications %} aria-current="page"{% endif %}>Publications</a><a href="{{ path('app_drafts') }}"{% if app.request.attributes.get('_route') starts with 'app_draft' %} aria-current="page"{% endif %}>Brouillons</a><a href="{{ path('app_calendar') }}"{% if app.request.attributes.get('_route') == 'app_calendar' %} aria-current="page"{% endif %}>Calendrier</a><a href="{{ path('app_connections') }}"{% if app.request.attributes.get('_route') starts with 'app_youtube' or app.request.attributes.get('_route') == 'app_connections' %} aria-current="page"{% endif %}>Réseaux</a><a href="{{ path('app_profile') }}"{% if app.request.attributes.get('_route') == 'app_profile' %} aria-current="page"{% endif %}>Mon compte</a></nav></details>
    {% for label, messages in app.flashes %}{% for message in messages %}<div class="account-notice {{ label }}" role="{{ label == 'error' ? 'alert' : 'status' }}">{{ message }}</div>{% endfor %}{% endfor %}
    {% block studio_content %}{% endblock %}
    <div class="studio-loading" role="status" aria-live="polite" data-studio-navigation-target="status" hidden></div>
  </main>
</div>
{% endblock %}
