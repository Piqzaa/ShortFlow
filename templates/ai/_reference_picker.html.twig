{% set imageName = field.vars.value|default('') %}
<div class="plan-reference" data-controller="reference-picker" data-reference-picker-upload-value="{{ path('app_ai_reference_upload',{slot:'plan'}) }}" data-reference-picker-token-value="{{ csrf_token('ai_reference') }}" data-reference-picker-kind-value="{{ kind }}" data-reference-picker-end-value="{{ ending|default(false) ? 'true' : 'false' }}" data-reference-picker-ratio-value="{{ recipe.ratio|default('9:16') }}" data-reference-picker-image-value="{{ imageName ? path('app_ai_reference_image',{name:imageName}) : '' }}">
{{ form_widget(field,{attr:{'data-reference-picker-target':'value'}}) }}{{ form_errors(field) }}
<label for="{{ field.vars.id }}_file">{{ label }}</label><input type="file" id="{{ field.vars.id }}_file" accept="image/jpeg,image/png,image/webp" data-reference-picker-target="file" data-action="change->reference-picker#select">
<div class="series-reference-frame" data-reference-picker-target="frame"{% if not imageName %} hidden{% endif %}><img alt="{{ label }}" data-reference-picker-target="preview" data-action="load->reference-picker#render"{% if imageName %} src="{{ path('app_ai_reference_image',{name:imageName}) }}"{% endif %}></div>
{% if kind == 'frame' %}<label for="{{ field.vars.id }}_fit">Cadrage de ce plan</label><select id="{{ field.vars.id }}_fit" data-reference-picker-target="fit" data-action="change->reference-picker#fit"><option value="crop">Recadrage centré</option><option value="contain">Image entière avec bandes</option></select>{% endif %}
<p class="library-note" data-reference-picker-target="status" role="status">JPG, PNG ou WebP, 10 Mo maximum. Aucun coût de génération pour cet import.</p><button type="button" class="account-secondary" data-reference-picker-target="remove" data-action="reference-picker#remove"{% if not imageName %} hidden{% endif %}>Retirer cette image</button>
</div>
