{% if quote.redo %}{% for shot in shots %}{% if shot.id == quote.redo %}
<form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('episode_flow_' ~ episode.id) }}"><input type="hidden" name="intent" value="repair_prompt"><input type="hidden" name="redo" value="{{ shot.id }}"><input type="hidden" name="revision" value="{{ episode.revision }}"><label for="repair-prompt-{{ shot.id }}">Corriger le prompt de ce plan</label><textarea id="repair-prompt-{{ shot.id }}" name="repair_prompt" rows="4" maxlength="1500" required>{{ shot.inputs.repairPrompt|default(shot.prompt) }}</textarea><p class="library-note">La vidéo actuelle reste conservée. Enregistrer prépare un nouveau devis ; la génération exige ensuite une autre confirmation. Aucun clip suivant n’est relancé automatiquement.</p><button class="account-secondary" type="submit">Enregistrer la correction et revoir le devis</button></form>
{% endif %}{% endfor %}{% endif %}
