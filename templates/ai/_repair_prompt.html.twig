{% set repairShot = quote.redo|default(rejectedCorrection|default(null) and rejectedCorrection.intent == 'repair_prompt' ? rejectedCorrection.shot : 0) %}
{% if repairShot %}{% for shot in shots %}{% if shot.id == repairShot %}{% set rejected = rejectedCorrection|default(null) and rejectedCorrection.intent == 'repair_prompt' and rejectedCorrection.shot == shot.id %}
<form method="post" class="account-form" data-controller="unsaved" data-unsaved-initial="{{ rejected ? 'true' : 'false' }}" data-action="input->unsaved#change change->unsaved#change submit->unsaved#submit"><input type="hidden" name="_token" value="{{ csrf_token('episode_flow_' ~ episode.id) }}"><input type="hidden" name="intent" value="repair_prompt"><input type="hidden" name="redo" value="{{ shot.id }}"><input type="hidden" name="revision" value="{{ episode.revision }}"><label for="repair-prompt-{{ shot.id }}">Corriger le prompt de ce plan</label><textarea id="repair-prompt-{{ shot.id }}" name="repair_prompt" rows="4" maxlength="1500" required{% if rejected %} aria-invalid="true" aria-describedby="episode-error"{% endif %}>{{ rejected ? rejectedCorrection.prompt : shot.inputs.repairPrompt|default(shot.prompt) }}</textarea><p class="library-note">La vidéo actuelle reste conservée. Enregistrer prépare un nouveau devis ; la génération exige ensuite une autre confirmation. Aucun clip suivant n’est relancé automatiquement.</p><button class="account-secondary" type="submit">Enregistrer la correction et revoir le devis</button></form>
{% endif %}{% endfor %}{% endif %}
