{% extends 'studio/base.html.twig' %}
{% block title %}{{ job.title }} — Studio{% endblock %}
{% block studio_content %}
<a class="account-secondary" href="{{ path('app_studio') }}">← Studio</a><div class="studio-heading"><div><span class="eyebrow">TA CRÉATION</span><h1>{{ job.title }}</h1><p>{{ model.name }} · Fal · {{ job.seconds }} secondes · {{ job.ratio }}</p></div></div>
<div class="ai-review"><section><h2>Ton idée</h2><p class="ai-prompt">{{ job.prompt }}</p><dl class="profile-facts"><div><dt>Coût estimé fournisseur</dt><dd>{{ (job.estimatedCents / 100)|number_format(2,',',' ') }} $ US</dd></div><div><dt>Tarif vérifié</dt><dd>{{ job.priceChecked|date('d/m/Y') }}</dd></div><div><dt>Audio</dt><dd>{{ model.audio ? 'Audio généré · 720p' : 'Sans audio' }}</dd></div></dl><p class="library-note">Estimation indicative hors taxes et conversion éventuelles, facturée directement par Fal. Aucun crédit VydFlow utilisé.</p><a class="account-secondary" href="https://fal.ai/models/{{ model.endpoint }}" target="_blank" rel="noopener noreferrer">Vérifier le tarif Fal ↗</a></section>
<section class="ai-status" aria-labelledby="ai-state-title"><h2 id="ai-state-title">{{ {prepared:'Prête à être confirmée',queued:'En attente de génération',submitting:'Demande en cours',processing:'La vidéo prend forme',waiting_key:'Ajoute ta clé pour continuer',review:'Une vérification est nécessaire',available:'Ta vidéo est prête'}[job.status] }}</h2>
{% if job.issue %}<p role="alert">{{ job.issue }}</p>{% endif %}
{% if job.status == 'prepared' %}
{% if not hasKey %}<p>Ajoute ta clé Fal pour utiliser ton propre compte fournisseur. Cette idée reste enregistrée.</p><a class="button" href="{{ path('app_ai_keys',{next:job.id}) }}">Ajouter ma clé Fal ↗</a>{% endif %}
{% if not enabled %}<p class="account-notice">Le studio est en préparation. Les essais payants ne sont pas encore activés ; ton idée est enregistrée.</p>{% endif %}
<form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('ai_generation_' ~ job.id) }}"><label class="ai-confirm"><input type="checkbox" name="confirm" value="1" required{% if not enabled or not hasKey %} disabled{% endif %}> Je demande la génération et j’accepte le coût estimé de {{ (job.estimatedCents / 100)|number_format(2,',',' ') }} $ US chez Fal.</label><button class="button" type="submit"{% if not enabled or not hasKey %} disabled{% endif %}>Confirmer et générer →</button></form>
{% elseif job.status == 'waiting_key' %}<p>Aucune demande n’a été transmise au fournisseur.</p><a class="account-secondary" href="{{ path('app_ai_keys',{next:job.id}) }}">Gérer ma clé Fal ↗</a><form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('ai_generation_' ~ job.id) }}"><input type="hidden" name="intent" value="retry"><label class="ai-confirm"><input type="checkbox" name="confirm" value="1" required> Je confirme la génération au coût estimé de {{ (job.estimatedCents / 100)|number_format(2,',',' ') }} $ US chez Fal.</label><button class="button" type="submit"{% if not enabled or not hasKey %} disabled{% endif %}>Reprendre la génération</button></form>
{% elseif job.status == 'available' %}{% if job.video %}<p>La vidéo a rejoint ta bibliothèque privée.</p><a class="button" href="{{ path('app_video_show',{id:job.video.id}) }}">Voir ma vidéo →</a><a class="account-secondary" href="{{ path('app_composer_start',{videos:[job.video.id]}) }}">Préparer sa publication ↗</a>{% else %}<p>La vidéo a été retirée de la bibliothèque. Cette génération reste dans l’historique.</p>{% endif %}
{% elseif job.status == 'review' and job.remote %}<form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('ai_generation_' ~ job.id) }}"><input type="hidden" name="intent" value="retry"><button class="button" type="submit"{% if not enabled %} disabled{% endif %}>Reprendre la récupération</button><p class="library-note">Consulte le même résultat, sans lancer une nouvelle génération.</p></form>
{% elseif job.status != 'review' %}<p>Tu peux quitter cette page : la génération continue en arrière-plan. Aucune publication sur tes réseaux ne sera lancée.</p><a class="account-secondary" href="{{ path('app_ai_generation',{id:job.id}) }}">Actualiser le suivi ↻</a>{% endif %}
</section></div>
{% endblock %}
