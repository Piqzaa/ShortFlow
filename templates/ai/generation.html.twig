{% extends 'studio/base.html.twig' %}
{% block title %}{{ job.title }} — Studio{% endblock %}
{% block studio_content %}
<a class="account-secondary" href="{{ path('app_studio') }}">← Studio</a><div class="studio-heading"><div><span class="eyebrow">TA CRÉATION</span><h1>{{ job.title }}</h1><p>{{ model.name }} · {{ providerName }} · {{ model.quality == '4k' ? '4K' : model.quality }} · {{ job.seconds }} secondes · {{ job.ratio == 'auto' ? 'Format de l’image' : job.ratio }}</p></div></div>
<div class="ai-review"><section><h2>Ton idée</h2>{% if job.referenceImage %}<img class="creation-reference-preview" src="{{ path('app_ai_reference_image',{name:job.referenceImage,ratio:job.ratio,fit:job.imageFit}) }}" alt="Image de départ de cette génération"><p class="library-note">Cet aperçu montre le cadrage envoyé à {{ providerName }} lors de la génération confirmée.</p>{% if job.endReferenceImage %}<img class="creation-reference-preview" src="{{ path('app_ai_reference_image',{name:job.endReferenceImage,ratio:job.ratio,fit:job.imageFit,match:job.ratio == 'auto' ? job.referenceImage : null}) }}" alt="Image de fin de cette génération"><p class="library-note">Image de fin · {{ job.imageFit == 'contain' ? 'image entière avec bandes si nécessaire' : 'recadrage centré' }}.</p>{% endif %}{% endif %}<p class="ai-prompt">{{ job.prompt }}</p><dl class="profile-facts"><div><dt>Coût estimé fournisseur</dt><dd>{{ (job.estimatedCents / 100)|number_format(2,',',' ') }} $ US</dd></div><div><dt>Tarif vérifié</dt><dd>{{ job.priceChecked|date('d/m/Y') }}</dd></div><div><dt>Audio</dt><dd>{{ model.audio ? 'Audio généré' : 'Sans audio' }}</dd></div><div><dt>Résolution de génération</dt><dd>{{ model.quality == '4k' ? '4K · 2160p' : model.quality }}</dd></div></dl><p class="library-note">Estimation indicative hors taxes et conversion éventuelles, facturée directement par {{ providerName }}. Aucun crédit VydFlow utilisé.</p><a class="account-secondary" href="{{ model.provider == 'ltx' ? 'https://docs.ltx.io/pricing/' : (model.provider == 'fal' ? 'https://fal.ai/models/' ~ model.endpoint : 'https://replicate.com/' ~ model.endpoint) }}" target="_blank" rel="noopener noreferrer">Vérifier le tarif {{ providerName }} ↗</a></section>
<section class="ai-status" aria-labelledby="ai-state-title"{% if job.status in ['queued','submitting','processing'] %} data-controller="generation-watch" data-generation-watch-url-value="{{ path('app_ai_status',{id:job.id}) }}" data-generation-watch-status-value="{{ job.status }}" data-generation-watch-revision-value="{{ job.updatedAt.format('U.u') }}"{% endif %}><h2 id="ai-state-title" data-generation-watch-target="title">{{ job.status == 'processing' ? ({queued:'Dans la file du fournisseur',running:'La vidéo prend forme',importing:'Ta vidéo arrive'}[job.providerStage|default('')] ?? 'Demande acceptée') : {prepared:'Prête à être confirmée',queued:'Préparation de ta génération',submitting:'Envoi au fournisseur',waiting_key:'Vérifie ta connexion pour continuer',review:'Une vérification est nécessaire',available:'Ta vidéo est prête'}[job.status] }}</h2>
{% if job.status in ['queued','submitting','processing'] %}{% include 'ai/_progress.html.twig' %}{% endif %}
{% if job.issue %}<p role="alert">{{ job.issue }}</p>{% endif %}
<p class="library-note">Accès choisi : {{ job.accessMode == 'mcp' ? 'connexion navigateur Fal · compte MCP actif chez Fal' : 'clé API du fournisseur' }}.</p>
{% if job.accessMode == 'mcp' and mcpAccount|default(null) %}<p class="library-note ai-account-id">Compte Fal autorisé : {{ mcpAccount }}. Le compte actif est revérifié avant l’envoi.</p>{% endif %}
{% if job.status == 'prepared' %}
{% if not hasKey %}<p>{{ job.accessMode == 'mcp' ? 'Connecte ton compte Fal par navigateur pour continuer.' : 'Ajoute ta clé ' ~ providerName ~ ' pour utiliser ton propre compte fournisseur.' }} Cette idée reste enregistrée.</p><a class="button" href="{{ job.accessMode == 'mcp' ? path('app_ai_fal_connect',{next:job.id}) : path('app_ai_keys',{next:job.id,provider:model.provider}) }}">{{ job.accessMode == 'mcp' ? 'Connecter mon compte Fal' : 'Ajouter ma clé ' ~ providerName }} ↗</a>{% endif %}
{% if not enabled %}<p class="account-notice">Le studio est en préparation. Les essais payants ne sont pas encore activés ; ton idée est enregistrée.</p>{% endif %}
<form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('ai_generation_' ~ job.id) }}"><label class="ai-confirm"><input type="checkbox" name="confirm" value="1" required{% if not enabled or not hasKey %} disabled{% endif %}> Je demande la génération{{ job.referenceImage ? ' à partir de cette image' : '' }} et j’accepte le coût estimé de {{ (job.estimatedCents / 100)|number_format(2,',',' ') }} $ US chez {{ providerName }}.</label><button class="button" type="submit"{% if not enabled or not hasKey %} disabled{% endif %}>Confirmer et générer →</button></form>
{% elseif job.status == 'waiting_key' %}<p>Aucune demande n’a été transmise au fournisseur.</p><a class="account-secondary" href="{{ job.accessMode == 'mcp' ? path('app_ai_fal_connect',{next:job.id}) : path('app_ai_keys',{next:job.id,provider:model.provider}) }}">Gérer ma connexion {{ providerName }} ↗</a><form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('ai_generation_' ~ job.id) }}"><input type="hidden" name="intent" value="retry"><label class="ai-confirm"><input type="checkbox" name="confirm" value="1" required> Je confirme la génération au coût estimé de {{ (job.estimatedCents / 100)|number_format(2,',',' ') }} $ US chez {{ providerName }}.</label><button class="button" type="submit"{% if not enabled or not hasKey %} disabled{% endif %}>Reprendre la génération</button></form>
{% elseif job.status == 'available' %}{% if job.video %}<video class="ai-result-player" controls playsinline preload="metadata" src="{{ path('app_video_stream',{id:job.video.id}) }}" aria-label="Aperçu de {{ job.title }}"></video><p>La vidéo a rejoint ta bibliothèque privée.</p><a class="account-secondary" href="{{ path('app_video_download',{id:job.video.id}) }}" download>Télécharger ↓</a><a class="button" href="{{ path('app_video_show',{id:job.video.id}) }}">Voir ma vidéo →</a>{% include 'edit/_start.html.twig' with {video:job.video} %}<a class="account-secondary" href="{{ path('app_composer_start',{videos:[job.video.id]}) }}">Préparer sa publication ↗</a>{% else %}<p>La vidéo a été retirée de la bibliothèque. Cette génération reste dans l’historique.</p>{% endif %}
{% elseif job.status == 'review' and job.remote %}<form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('ai_generation_' ~ job.id) }}"><input type="hidden" name="intent" value="retry"><button class="button" type="submit"{% if not enabled %} disabled{% endif %}>Reprendre la récupération</button><p class="library-note">Consulte le même résultat, sans lancer une nouvelle génération.</p></form>
{% elseif job.status != 'review' %}<p role="status" aria-live="polite" data-generation-watch-target="message">Tu peux quitter cette page : la génération continue en arrière-plan. Aucune publication sur tes réseaux ne sera lancée.</p><a class="account-secondary" href="{{ path('app_ai_generation',{id:job.id}) }}">Actualiser le suivi ↻</a>{% endif %}
<p class="library-note">Une place et 100 Mo libres sont nécessaires par génération active. Le résultat reste limité à 100 Mo ; sa taille finale dépend du fournisseur.</p>{% include 'ai/_reuse.html.twig' %}<a class="creation-key-link" href="{{ path('app_ai_history') }}">Toutes mes créations ↗</a></section></div>
{% endblock %}
