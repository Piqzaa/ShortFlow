<div class="preparation-timing studio-start-settings">
  <div>{{ form_row(ideaForm.ratio,{attr:{form:'ai-idea-form','data-creation-target':'ratio','data-action':'change->creation#frameChanged'}}) }}</div>
  <div>{{ form_row(ideaForm.target,{label:'Durée totale',attr:{'data-preparation-target':'total','data-action':'change->preparation#duration'}}) }}</div>
</div>
<div data-creation-target="imageSettings">{{ form_row(ideaForm.imageFit,{attr:{form:'ai-idea-form','data-creation-target':'imageFit','data-action':'change->creation#frameChanged'}}) }}</div>
<div class="preparation-timing studio-plan-settings">
  <div data-preparation-target="continuityPanel">{{ form_row(ideaForm.continuity,{label:'Enchaînement des plans',attr:{'data-preparation-target':'continuity'}}) }}</div>
  {% include 'ai/_plan_count.html.twig' %}
</div>
<div class="continuity-explanation" data-continuity-options data-preparation-target="continuityOptions"{% if ideaForm.continuity.vars.value != 'linked' %} hidden{% endif %}>
  <p data-preparation-target="continuityHelp" hidden></p>
  <button type="button" class="account-secondary" data-preparation-target="fixContinuity imageModeButton" data-action="preparation#imageMode" hidden>Choisir un modèle image et sa référence</button>
</div>
{% include 'ai/_plan_count_status.html.twig' %}
<p class="library-note preparation-feedback" data-preparation-target="notice" role="status">Choisis un modèle pour préparer tes plans.</p>
<p data-preparation-target="single" hidden></p>
{% include 'ai/_single_plan.html.twig' %}
