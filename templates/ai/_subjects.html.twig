<section class="story-context subject-references" data-controller="subject-list" data-subject-list-namespace-value="{{ subjectForm.vars.name }}" data-subject-list-primary-reference-value="{{ subjectPrimaryReference|default('') }}"><h2>{{ subjectForm.referenceOrigin is defined ? 'Personnages et références de cette vidéo' : 'Anciennes références importées' }}</h2><p class="library-note" data-subject-list-target="notice" role="status"></p>
<div data-subject-list-target="primary"></div>
<div data-subject-list-target="list">{% for field in subjectForm.subjects %}<section class="subject-reference-card" data-subject-row><div data-subject-main>{% include 'ai/_reference_picker.html.twig' with {field:field,kind:'subject',label:'Photo du personnage ou de l’objet supplémentaire',removable:false} %}</div><button type="button" class="account-secondary" data-action="subject-list#remove">Retirer cette référence</button></section>{% endfor %}</div>
<template data-subject-list-target="prototype"><section class="subject-reference-card" data-subject-row><div data-subject-main>{% include 'ai/_reference_picker.html.twig' with {field:subjectForm.subjects.vars.prototype,kind:'subject',label:'Photo du personnage ou de l’objet supplémentaire',removable:false} %}</div><button type="button" class="account-secondary" data-action="subject-list#remove">Retirer cette référence</button></section></template>
<div data-subject-list-target="detailsList">{% for detailForm in subjectForm.subjectDetails %}{% include 'ai/_subject_details.html.twig' %}{% endfor %}</div>
<template data-subject-list-target="detailsPrototype">{% include 'ai/_subject_details.html.twig' with {detailForm:subjectForm.subjectDetails.vars.prototype} %}</template>
<button type="button" class="account-secondary" data-subject-list-target="add" hidden data-action="subject-list#add">Ajouter un autre personnage ou objet</button>
{% if subjectForm.subjectImages is defined %}<div data-subject-list-target="legacy">{{ form_row(subjectForm.subjectImages) }}<p class="library-note">Les noms et les vues pourront être précisés après l’enregistrement. Avec JavaScript, utilise les cartes ci-dessus pour les préparer dès maintenant.</p></div>{% endif %}
{% if subjectForm.removeSubjects is defined %}<div class="subject-legacy-removal" data-subject-list-target="legacy">{{ form_row(subjectForm.removeSubjects) }}</div>{% endif %}
<noscript><p class="library-note">Les cartes et imports détaillés nécessitent JavaScript. Les références déjà enregistrées restent conservées ; tu peux les nommer avant de vérifier ton devis.</p></noscript>
</section>
{{ form_errors(subjectForm.subjects) }}{{ form_errors(subjectForm.subjectDetails) }}
{% do subjectForm.subjects.setRendered() %}{% do subjectForm.subjectDetails.setRendered() %}
