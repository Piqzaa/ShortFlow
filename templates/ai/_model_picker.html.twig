{% set pickerPrefix = pickerPrefix|default('creation') %}
<div class="creation-picker" data-guided-model-picker data-{{ pickerPrefix }}-target="picker" hidden>
  <label for="{{ pickerPrefix }}-model-search">Trouver un modèle</label><input id="{{ pickerPrefix }}-model-search" type="search" placeholder="Nom du modèle ou fournisseur…" disabled data-{{ pickerPrefix }}-target="pickerSearch" data-action="input->{{ pickerPrefix }}#searchPicker change->{{ pickerPrefix }}#searchPicker keydown.enter->{{ pickerPrefix }}#preventPickerSubmit">
  <p class="library-note" role="status" data-{{ pickerPrefix }}-target="pickerCount">Tes favoris sont marqués d’une étoile ★.</p>
  <div class="creation-search-results" data-{{ pickerPrefix }}-target="pickerResults" aria-label="Résultats des modèles" hidden>
  {% for groupId,group in groups %}{% set first = models[group.variants|first] %}{% set provider = first.provider %}{% set ready = provider == 'fal' ? connected[accessForm.vars.value == 'mcp' ? 'fal-mcp' : 'fal-api']|default(false) : (accessForm.vars.value != 'mcp' and connected[provider]|default(false)) %}
    <button type="button" class="creation-search-result" data-{{ pickerPrefix }}-target="pickerResult" data-group-id="{{ groupId }}" data-source="{{ first.subjectReference|default(false) ? 'subject' : (first.image|default(false) ? 'image' : 'text') }}" data-action="{{ pickerPrefix }}#pickResult"><span data-result-label>{{ groupId in app.user.aiFavorites ? '★ ' : '' }}{{ group.name }} · {{ providers[provider] }}</span><small><span data-result-access>{{ ready ? 'Connexion enregistrée' : 'À connecter' }}</span> · {{ group.variants|map(id => models[id].quality == '4k' ? '4K' : models[id].quality)|join(' / ') }}{{ first.endImageField|default(null) ? ' · Début + fin' : '' }}</small></button>
  {% endfor %}</div>
  <div class="ai-settings"><div><label for="{{ pickerPrefix }}-model-group">Modèle</label><select id="{{ pickerPrefix }}-model-group" disabled required data-{{ pickerPrefix }}-target="group" data-action="change->{{ pickerPrefix }}#selectGroup"><option value="">Choisir un modèle</option>
  {% for groupId,group in groups %}{% set first = models[group.variants|first] %}{% set provider = first.provider %}{% set ready = provider == 'fal' ? connected[accessForm.vars.value == 'mcp' ? 'fal-mcp' : 'fal-api']|default(false) : (accessForm.vars.value != 'mcp' and connected[provider]|default(false)) %}
    <option value="{{ groupId }}" data-group-id="{{ groupId }}" data-variants="{{ group.variants|json_encode|e('html_attr') }}"{% if pickerPrefix == 'series-settings' %} data-series-settings-target="card"{% endif %} data-source="{{ first.subjectReference|default(false) ? 'subject' : (first.image|default(false) ? 'image' : 'text') }}"{% if not ready %} class="catalog-option-disconnected"{% endif %}{% if modelForm.vars.value in group.variants %} selected{% endif %}>{{ groupId in app.user.aiFavorites ? '★ ' : '' }}{{ group.name }} · {{ providers[provider] }}{{ not ready ? ' · à connecter' : '' }}</option>
  {% endfor %}</select></div>
  <div><label for="{{ pickerPrefix }}-resolution">Résolution</label><select id="{{ pickerPrefix }}-resolution" disabled required data-{{ pickerPrefix }}-target="resolution" data-action="change->{{ pickerPrefix }}#selectResolution"><option value="">Choisir une résolution</option>{% for id,model in models %}{% if model.operation is not defined %}<option value="{{ id }}">{{ model.quality == '4k' ? '4K · 2160p' : model.quality }}</option>{% endif %}{% endfor %}</select></div></div>
</div>
<div class="creation-native" data-{{ pickerPrefix }}-target="native">{{ form_label(modelForm) }}{{ form_widget(modelForm,{attr:{('data-' ~ pickerPrefix ~ '-target'):'model','data-action':modelChange}}) }}</div>{{ form_errors(modelForm) }}
