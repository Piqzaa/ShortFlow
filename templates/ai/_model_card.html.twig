{% set selectedId = ideaForm.model.vars.value in group.variants ? ideaForm.model.vars.value : group.variants|first %}
{% set model = models[selectedId] %}
{% set favorite = groupId in app.user.aiFavorites %}
<article class="catalog-card{{ not connected[model.provider] ? ' is-disconnected' : '' }}" data-creation-target="card" data-model-id="{{ selectedId }}" data-group-id="{{ groupId }}" data-variants="{{ group.variants|json_encode|e('html_attr') }}" data-favorite="{{ favorite ? 'true' : 'false' }}">
  <div class="catalog-badges">{% if model.image|default(false) %}<span>Image → vidéo</span>{% if model.endImageField|default(null) %}<span>{{ model.requiresEnd|default(false) ? 'Début + fin requis' : 'Fin facultative' }}</span>{% endif %}{% endif %}<span class="catalog-resolution" data-card-quality>{{ model.quality == '4k' ? '4K' : model.quality }}</span>{% if groupId == 'kling-25' %}<span title="Parcours Fal testé en réel sur un plan de 5 secondes sans audio.">Recommandé pour débuter</span>{% endif %}<span data-economy-badge title="Prix minimal parmi les résultats affichés compatibles avec la durée comparée. Audio et résolution peuvent différer." hidden></span></div>
  <span>{{ model.maker }} · {{ providers[model.provider] }}</span><h3>{{ group.name }}</h3>
  <p data-card-description>{{ model.description }}</p>
  <label class="catalog-variant-label" for="variant-{{ groupId }}">Résolution</label><select id="variant-{{ groupId }}" class="catalog-variant" disabled data-action="change->creation#variant" aria-label="Résolution de {{ group.name }} chez {{ providers[model.provider] }}">{% for id in group.variants %}<option value="{{ id }}"{{ id == selectedId ? ' selected' : '' }}>{{ models[id].quality == '4k' ? '4K · 2160p' : models[id].quality }}</option>{% endfor %}</select>
  <small data-card-capabilities>{{ model.seconds|length > 4 ? model.seconds|first ~ '–' ~ model.seconds|last ~ ' s' : model.seconds|join(' / ') ~ ' s' }} · {{ model.audio ? 'Audio généré' : 'Sans audio' }}<br>{{ model.ratios|join(' · ')|replace({'auto':'Image d’origine'}) }}</small>
  <p class="catalog-key">{{ connected[model.provider] ? 'Accès enregistré · droits et crédits à vérifier' : 'Connecter ' ~ providers[model.provider] ~ ' pour utiliser ce modèle' }}</p>
  <p class="ai-model-price" data-card-price>{% if model.pricesCents is defined %}{% for seconds,cents in model.pricesCents %}{{ seconds }} s : {{ (cents / 100)|number_format(2,',',' ') }} $ US{{ not loop.last ? ' · ' : '' }}{% endfor %}{% else %}{{ (model.rateMicros / 1000000)|number_format(3,',',' ') }} $ US / s{% if model.fixedMicros|default(0) %} + {{ (model.fixedMicros / 1000000)|number_format(3,',',' ') }} $ US d’image{% endif %}{% endif %}</p><p class="library-note" data-comparison-price></p>
  <form method="post" action="{{ path('app_ai_favorite',{id:groupId}) }}" class="catalog-favorite" data-action="submit->creation#favorite"><input type="hidden" name="_token" value="{{ csrf_token('ai_favorite_' ~ groupId) }}"><input type="hidden" name="favorite" value="{{ favorite ? '0' : '1' }}"><button type="submit" class="account-secondary" aria-pressed="{{ favorite ? 'true' : 'false' }}" aria-label="Favori : {{ group.name }} chez {{ providers[model.provider] }}">{{ favorite ? '★ En favori' : '☆ Favori' }}</button><span class="library-note" role="status"></span></form>
  <div class="catalog-card-actions"><button type="button" class="account-secondary" data-action="creation#choose" data-model-id="{{ selectedId }}" data-creation-target="choose" aria-label="{{ connected[model.provider] ? 'Choisir ' ~ group.name ~ ' chez ' ~ providers[model.provider] : 'Connecter ' ~ providers[model.provider] ~ ' pour ' ~ group.name }}" hidden>{{ connected[model.provider] ? 'Choisir' : 'Connecter ' ~ providers[model.provider] }}</button><a href="{{ model.provider == 'ltx' ? 'https://docs.ltx.io/pricing/' : (model.provider == 'fal' ? 'https://fal.ai/models/' ~ model.endpoint : 'https://replicate.com/' ~ model.endpoint) }}" target="_blank" rel="noopener noreferrer">Tarif fournisseur ↗</a></div>
</article>
