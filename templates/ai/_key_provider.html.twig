{% set console = provider == 'fal' ? 'https://fal.ai/dashboard/keys' : (provider == 'replicate' ? 'https://replicate.com/account/api-tokens' : 'https://console.ltx.io/') %}
{% if connection %}
<div class="ai-key-saved"><p class="ai-key-status">Clé API enregistrée <code class="ai-key-mask">{{ maskedKeys[provider]|default('•••• ••••') }}</code></p><p class="library-note">Modifiée le {{ connection.updatedAt|date('d/m/Y',app.user.timezone) }} · Seuls les quatre derniers caractères peuvent être affichés.</p></div>
{% else %}<p class="library-note">Aucune clé API enregistrée{{ provider == 'fal' and falMcpConnected|default(false) ? ' · Ton accès navigateur Fal reste disponible.' : '.' }}</p>{% endif %}
{% if ready %}
{% if connection %}<details class="creation-details ai-key-replace"><summary>Remplacer ma clé API</summary>{% endif %}
<form method="post" class="account-form" autocomplete="off"><input type="hidden" name="_token" value="{{ csrf_token('ai_keys') }}"><input type="hidden" name="provider" value="{{ provider }}"><div><label for="ai-api-key-{{ provider }}">{{ connection ? 'Nouvelle clé API' : 'Clé API' }} {{ name }}</label><input id="ai-api-key-{{ provider }}" name="apiKey" type="password" autocomplete="new-password" minlength="20" maxlength="512" required spellcheck="false" autocapitalize="none"><p class="library-note">Clé chiffrée, privée à ton compte. Enregistrer ne vérifie ni les crédits ni tous les droits.</p></div><button class="button" type="submit">{{ connection ? 'Remplacer ma clé' : 'Enregistrer ma clé' }}{{ provider != 'fal' ? ' ' ~ name : '' }}</button></form>
{% if connection %}</details>{% endif %}
{% else %}<p class="account-notice">Le stockage sécurisé des clés attend sa configuration locale.</p>{% endif %}
{% if connection %}<form method="post" class="ai-key-removal"><input type="hidden" name="_token" value="{{ csrf_token('ai_keys') }}"><input type="hidden" name="provider" value="{{ provider }}"><input type="hidden" name="intent" value="remove"><label for="ai-remove-{{ provider }}"><input id="ai-remove-{{ provider }}" type="checkbox" name="confirm" value="1" required> Je confirme le retrait de ma clé {{ name }}.</label><button class="account-secondary" type="submit">Retirer ma clé{{ provider != 'fal' ? ' ' ~ name : '' }}</button><p class="library-note">{{ provider == 'fal' ? 'La connexion navigateur Fal reste indépendante. ' : '' }}Cela n’annule pas une génération déjà transmise et ne révoque pas la clé chez {{ name }}.</p></form>{% endif %}
<details class="creation-details ai-key-guide"><summary>Où trouver ma clé {{ name }} ?</summary><ol><li>Ouvre <a href="{{ console }}" target="_blank" rel="noopener noreferrer">ton espace {{ name }} ↗</a> et connecte-toi.</li><li>Crée une clé dédiée « VydFlow »{% if provider == 'fal' %} avec les droits API{% endif %}, puis copie-la.</li><li>Enregistre-la ici et vérifie les crédits disponibles chez {{ name }}.</li></ol><p>Une seule méthode suffit. Une clé {{ name }} permet d’utiliser les modèles de ce fournisseur intégrés dans VydFlow.</p></details>
<a class="account-secondary" href="{{ console }}" target="_blank" rel="noopener noreferrer">Créer ou gérer ma clé chez {{ name }} ↗</a>
