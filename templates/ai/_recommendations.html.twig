<fieldset class="creation-recommendations" data-creation-target="recommendations" hidden><legend>Un choix pour commencer</legend><p class="library-note">Trois options chez Fal. Le coût est estimé avec tes réglages avant confirmation.</p><div>
{% for pick in [
{label:'Clip court',text:'vidu-q1',image:'vidu-q1-image',frames:'vidu-q1-frames',subject:'vidu-q1-subject',description:'Sans audio · vérifier le coût total'},
{label:'Équilibré',text:'kling-25',image:'kling-25-image',frames:'kling-25-image',description:'1080p · sans audio'},
{label:'Avec audio',text:'kling-3',image:'kling-3-image',frames:'kling-3-image',description:'1080p · audio généré'}
] %}<button type="button" aria-pressed="false" class="creation-recommendation" data-creation-target="recommendation" data-action="creation#choose" data-subject-model="{{ pick.subject|default('') }}" data-text-model="{{ pick.text }}" data-image-model="{{ pick.image }}" data-frames-model="{{ pick.frames }}"><strong>{{ pick.label }}</strong><span data-recommendation-name>{{ models[pick.text].name }}</span><small>{{ pick.description }}</small><small data-recommendation-access>{{ connected.fal ? 'Compte Fal enregistré' : 'Connexion Fal nécessaire' }}</small></button>{% endfor %}
</div><p class="library-note" data-creation-target="selectedModel" aria-live="polite"></p></fieldset>
