<fieldset class="creation-recommendations" data-{{ pickerPrefix|default('creation') }}-target="recommendations" hidden><legend>Trois choix pour ton point de départ</legend><p class="library-note">Choisis selon ton usage et ton budget. Les dialogues français restent à vérifier ; aucun modèle n’est sélectionné automatiquement.</p><div>
{% for pick in [
{label:'Audio et dialogues',text:'gemini-omni-12-text-720p',image:'gemini-omni-12-image-720p',frames:'gemini-omni-12-image-720p',subject:'gemini-omni-12-subject-720p',description:'Omni 1.2 · audio natif · français et argot à tester'},
{label:'Autre rendu avec audio',text:'grok-video',image:'grok-image-720',frames:'ltx-23-fast-720p-image',subject:'grok-15-subject-720p',description:'Une alternative compatible avec tes références · français non validé'},
{label:'Clip court sans voix',text:'vidu-q1',image:'vidu-q1-image',frames:'vidu-q1-frames',subject:'vidu-q1-subject',description:'Vidu Q1 · sans audio · pour une scène purement visuelle'}
] %}<button type="button" aria-pressed="false" class="creation-recommendation" data-{{ pickerPrefix|default('creation') }}-target="recommendation" data-action="{{ pickerPrefix|default('creation') }}#choose" data-subject-model="{{ pick.subject }}" data-text-model="{{ pick.text }}" data-image-model="{{ pick.image }}" data-frames-model="{{ pick.frames }}"><strong>{{ pick.label }}</strong><span data-recommendation-name>{{ models[pick.text].name }}</span><small>{{ pick.description }}</small><small data-recommendation-example></small><small data-recommendation-access>{{ connected.fal ? 'Compte Fal enregistré' : 'Connexion Fal nécessaire' }}</small></button>{% endfor %}
</div><p class="library-note" data-{{ pickerPrefix|default('creation') }}-target="selectedModel" aria-live="polite"></p><p class="account-notice model-speech-note" data-selected-model-speech role="status" aria-live="polite" hidden></p></fieldset>
