<fieldset class="creation-recommendations" data-{{ pickerPrefix|default('creation') }}-target="recommendations" hidden><legend>Choisis selon ton budget et ton besoin de son</legend><p class="library-note">Compare le prix, le son et la résolution. Les prix ci-dessous sont des exemples par plan ; le récapitulatif calcule ton total.</p><div>
{% for pick in [
{label:'Sans voix · 1080p',text:'vidu-q1',image:'vidu-q1-image',frames:'vidu-q1-frames',subject:'vidu-q1-subject',description:'Pour une scène muette ou une voix ajoutée au montage.'},
{label:'Audio · prix réduit',text:'grok-video',image:'grok-image-720',frames:'ltx-23-fast-720p-image',subject:'gemini-omni-12-subject-720p',description:'Pour générer le son en 720p à un prix inférieur au choix audio 1080p.'},
{label:'Audio · 1080p',text:'gemini-omni-12-text-1080p',image:'gemini-omni-12-image-1080p',frames:'gemini-omni-12-image-1080p',subject:'gemini-omni-12-subject-1080p',description:'Pour une image Full HD avec son généré. Plus de pixels que le 720p, coût plus élevé.'}
] %}<button type="button" aria-pressed="false" class="creation-recommendation" data-{{ pickerPrefix|default('creation') }}-target="recommendation" data-action="{{ pickerPrefix|default('creation') }}#choose" data-subject-model="{{ pick.subject }}" data-text-model="{{ pick.text }}" data-image-model="{{ pick.image }}" data-frames-model="{{ pick.frames }}"><strong>{{ pick.label }}</strong><span data-recommendation-name>{{ models[pick.text].name }}</span><small>{{ pick.description }}</small><small data-recommendation-example></small><small data-recommendation-access>{{ connected.fal ? 'Compte Fal enregistré' : 'Connexion Fal nécessaire' }}</small></button>{% endfor %}
</div><section class="creation-quick-resolution" data-recommendation-resolution hidden><label for="{{ pickerPrefix|default('creation') }}-quick-resolution">Résolution de ta vidéo</label><select id="{{ pickerPrefix|default('creation') }}-quick-resolution" data-action="change->{{ pickerPrefix|default('creation') }}#changeRecommendationResolution"></select><p class="library-note">Le prix est actualisé lorsque tu changes de résolution.</p></section><p class="library-note" data-{{ pickerPrefix|default('creation') }}-target="selectedModel" aria-live="polite"></p><p class="account-notice model-speech-note" data-selected-model-speech role="status" aria-live="polite" hidden></p></fieldset>
