<section class="preparation-plans" aria-labelledby="preparation-plans-title">
  <div class="series-episodes-heading"><h2 id="preparation-plans-title">Description vidéo</h2></div>
  <p class="library-note" data-shot-editor-target="summary" role="status" aria-live="polite">Le coût total sera calculé à partir de tes plans.</p>
  <div data-shot-editor-target="list">{% for shotForm in ideaForm.shots %}{% include 'ai/_shot_card.html.twig' with {shotNumber:loop.index,shotIndex:loop.index0} %}{% endfor %}</div><template data-shot-editor-target="prototype">{% set shotForm = ideaForm.shots.vars.prototype %}{% include 'ai/_shot_card.html.twig' %}</template>
  <button type="submit" name="plan_action" class="account-secondary preparation-add" data-shot-editor-target="add" data-action="shot-editor#act" value="add">Ajouter un plan +</button>
  {% if manualPromptReview|default(false) %}<div class="prompt-review-notice"><p class="library-note">Ton idée a changé ou cette ancienne préparation est incomplète. Relis tes plans, puis confirme les prompts corrigés.</p><button type="submit" name="plan_action" value="manual_prompts:0" class="account-secondary">Utiliser mes prompts relus</button></div>{% endif %}
  <noscript><p class="library-note">« Répartir la durée » prépare les champs sur cette page. Les plans peuvent ensuite être modifiés et enregistrés sans JavaScript.</p></noscript>
</section>
<details class="creation-audio creation-details"{% if ideaForm.mute.vars.checked or not ideaForm.mute.vars.valid %} open{% endif %}><summary>Audio du montage</summary>{{ form_row(ideaForm.mute) }}</details>
