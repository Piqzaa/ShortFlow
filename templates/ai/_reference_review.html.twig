{% if quote.references|default([]) %}<section class="story-context reference-review"><h2>Ce qui sera envoyé au fournisseur</h2><p class="library-note">Chaque ligne correspond à un appel confirmé, avec ses propres références. Les personnages sont communs ; les cadres concernent le plan indiqué.</p><p class="library-note">{{ model.audio ? 'Audio généré séparément pour chaque clip.' : 'Ce modèle produit des clips sans audio.' }} {{ episode.mutePlans ? 'Le montage final coupera le son des plans ; le prix fournisseur reste inchangé.' : 'Le montage conservera le son disponible des clips.' }} Un raccord par image ne transmet aucun son.</p>
{% if recipe.montage|default(null) %}<p class="library-note">Montage : son des clips à {{ episode.mutePlans ? 0 : recipe.montage.sourceVolume }} % · {{ recipe.montage.intro ? 'titre affiché pendant les 2,5 premières secondes' : 'sans titre ajouté' }} · {{ recipe.montage.fit == 'cover' ? 'remplissage avec recadrage si nécessaire' : 'image entière' }}. Ces réglages sont figés pour cette préparation et ne réduisent pas le prix fournisseur.</p>{% endif %}
{% for item in quote.references %}<article class="story-shot"><h3>Appel {{ item.position }} · {{ item.seconds }} s · {{ model.name }}</h3>
<p>{{ item.role == 'personnage' ? 'Personnage principal' : 'Début de ce plan' }} : {{ item.fromPrevious ? 'sera extrait du clip précédent, après sa génération' : (item.start ? 'image ci-dessous' : 'aucun cadre imposé') }}.</p>
{% if item.start %}<img loading="lazy" src="{{ path('app_ai_reference_image',{name:item.start,ratio:item.role == 'personnage' ? 'auto' : recipe.ratio,fit:item.fit}) }}" alt="{{ item.role == 'personnage' ? 'Personnage principal' : 'Début du plan ' ~ item.position }}">{% endif %}
<p>Fin de ce plan : {{ item.endFromExisting|default(false) ? 'dernière image de la version actuelle de ce plan, extraite après confirmation pour préserver le raccord suivant' : (item.end ? 'image ci-dessous' : 'aucune image imposée') }}.</p>{% if item.end and not item.endFromExisting|default(false) %}<img loading="lazy" src="{{ path('app_ai_reference_image',{name:item.end,ratio:recipe.ratio,fit:item.fit}) }}" alt="Fin du plan {{ item.position }}">{% endif %}
{% if item.subjectDetails|default([]) %}<p>Références d’identité : {{ item.subjectDetails|length }}. Elles ne remplacent pas le cadre initial.</p>{% for detail in item.subjectDetails %}<p><strong>{{ detail.name }}</strong> · {{ detail.role == 'object' ? 'objet' : 'personnage' }} · {{ detail.presence == 'enters' ? 'entre pendant l’action' : (detail.presence == 'visible' ? 'déjà présent dans le premier cadre' : 'présence précisée par la scène') }}</p>{% if detail.reference != item.start or item.role != 'personnage' %}<img loading="lazy" src="{{ path('app_ai_reference_image',{name:detail.reference}) }}" alt="Identité de {{ detail.name }}">{% endif %}{% for name in detail.views %}<img loading="lazy" src="{{ path('app_ai_reference_image',{name:name}) }}" alt="Vue complémentaire {{ loop.index }} de {{ detail.name }}">{% endfor %}{% endfor %}{% elseif item.subjects %}<p>Références d’identité : {{ item.subjects|length }}.</p>{% for name in item.subjects %}<img loading="lazy" src="{{ path('app_ai_reference_image',{name:name}) }}" alt="Référence {{ loop.index }} du plan {{ item.position }}">{% endfor %}{% endif %}
{% if item.prompt|default('') %}<details><summary>Prompt exact de cet appel</summary><p class="ai-prompt">{{ item.prompt }}</p></details>{% endif %}
</article>{% endfor %}</section>{% endif %}
