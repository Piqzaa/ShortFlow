{% extends 'studio/base.html.twig' %}
{% block title %}Studio — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading creation-heading"><div><span class="eyebrow">CRÉE. PRÉPARE. PUBLIE.</span><h1>Studio.</h1><p>Un espace pour donner forme à tes prochaines vidéos.</p></div><a class="account-secondary" href="{{ path('app_dashboard') }}">Mes vidéos ↗</a></div>
<nav class="creation-tools" aria-label="Outils du Studio"><a href="{{ path('app_studio') }}" aria-current="page"><span aria-hidden="true">✦</span> Créer avec l’IA</a><span class="creation-tool-soon" aria-disabled="true">Montage guidé <small>À venir</small></span></nav>
<div class="ai-workspace creation-workspace"><section aria-labelledby="ai-idea-title" data-controller="creation" data-creation-models-value="{{ models|json_encode|e('html_attr') }}" data-creation-providers-value="{{ providers|json_encode|e('html_attr') }}" data-creation-connected-value="{{ connected|json_encode|e('html_attr') }}"><h2 id="ai-idea-title">Quelle est ton idée ?</h2>
{{ form_start(ideaForm,{attr:{id:'ai-idea-form',class:'account-form creation-form','data-controller':'idea-save','data-idea-save-url-value':path('app_ai_save_idea'),'data-idea-save-revision-value':app.session.get('ai_idea_revision'),'data-action':'input->idea-save#change change->idea-save#change submit->idea-save#submit pagehide@window->idea-save#flush'}}) }}
{{ form_errors(ideaForm) }}{{ form_row(ideaForm.prompt) }}
<p class="library-note" role="status" data-idea-save-target="status" hidden>Ton idée est conservée pendant ta session après modification.</p>
<noscript><p class="library-note">Pour conserver ton idée sans JavaScript, ouvre le récapitulatif avant de quitter cette page.</p></noscript>
<button type="button" class="account-secondary" data-idea-save-target="retry" data-action="idea-save#flush" hidden>Réessayer l’enregistrement</button>
<div class="creation-picker" data-creation-target="picker" hidden>
<label for="creation-model-search">Trouver un modèle</label><input id="creation-model-search" type="search" placeholder="Nom du modèle ou fournisseur…" disabled data-creation-target="pickerSearch" data-action="input->creation#searchPicker change->creation#searchPicker keydown.enter->creation#preventPickerSubmit">
<p class="library-note" role="status" data-creation-target="pickerCount">Tes favoris sont marqués d’une étoile ★.</p>
<div class="creation-search-results" data-creation-target="pickerResults" aria-label="Résultats des modèles" hidden>{% for groupId,group in groups %}{% set provider = models[group.variants|first].provider %}<button type="button" class="creation-search-result" data-creation-target="pickerResult" data-group-id="{{ groupId }}" data-action="creation#pickResult"><span data-result-label>{{ groupId in app.user.aiFavorites ? '★ ' : '' }}{{ group.name }} · {{ providers[provider] }}</span><small>{{ not connected[provider] ? 'À connecter' : 'Connecté' }} · {{ group.variants|map(id => models[id].quality == '4k' ? '4K' : models[id].quality)|join(' / ') }}</small></button>{% endfor %}</div>
<div class="ai-settings"><div><label for="creation-model-group">Modèle</label><select id="creation-model-group" disabled required data-creation-target="group" data-action="change->creation#selectGroup"><option value="">Choisir un modèle</option>{% for groupId,group in groups %}{% set provider = models[group.variants|first].provider %}<option value="{{ groupId }}"{% if not connected[provider] %} class="catalog-option-disconnected"{% endif %}{% if ideaForm.model.vars.value in group.variants %} selected{% endif %}>{{ groupId in app.user.aiFavorites ? '★ ' : '' }}{{ group.name }} · {{ providers[provider] }}{{ not connected[provider] ? ' · à connecter' : '' }}</option>{% endfor %}</select></div>
<div><label for="creation-resolution">Résolution</label><select id="creation-resolution" disabled required data-creation-target="resolution" data-action="change->creation#selectResolution"><option value="">Choisir une résolution</option>{% for id,model in models %}<option value="{{ id }}">{{ model.quality == '4k' ? '4K · 2160p' : model.quality }}</option>{% endfor %}</select></div></div></div>
<div class="creation-native" data-creation-target="native">{{ form_label(ideaForm.model) }}{{ form_widget(ideaForm.model,{attr:{'data-creation-target':'model','data-action':'change->creation#changeModel'}}) }}</div>{{ form_errors(ideaForm.model) }}
<div class="catalog-connect-notice" data-creation-target="connection" role="status" tabindex="-1" hidden><p data-creation-target="connectionMessage"></p><button class="account-secondary" type="submit" name="intent" value="connect" formnovalidate data-creation-target="connectionButton">Connecter le fournisseur</button></div>
<details class="creation-details" data-creation-target="accessDetails"{% if not ideaForm.accessMode.vars.valid %} open{% endif %}><summary data-creation-target="billing">Connexion et facturation</summary>{{ form_row(ideaForm.accessMode,{attr:{'data-creation-target':'access','data-action':'change->creation#estimate'}}) }}<p class="library-note">La méthode choisie sera conservée jusqu’au résultat. Les générations utilisent ton compte fournisseur ; aucune bascule automatique vers une autre connexion.</p></details>
<div class="ai-settings">{{ form_row(ideaForm.seconds,{attr:{'data-creation-target':'duration','data-action':'change->creation#estimate'}}) }}{{ form_row(ideaForm.ratio,{attr:{'data-creation-target':'ratio'}}) }}</div>
<details class="creation-details"><summary>Personnaliser le nom de cette création</summary>{{ form_row(ideaForm.title) }}</details>
<div class="creation-estimate" role="status" aria-live="polite"><strong data-creation-target="cost">Coût calculé au récapitulatif</strong><span data-creation-target="description">Une estimation avant toute génération.</span></div>
<div class="ai-actions"><button class="button" type="submit" name="intent" value="prepare">Voir le récapitulatif →</button><button data-creation-target="connect" class="account-secondary" type="submit" name="intent" value="connect" formnovalidate>Ajouter ma clé en gardant l’idée</button></div><p class="library-note">Aucune dépense à cette étape. Tu confirmeras le coût avant le lancement.</p>{{ form_end(ideaForm) }}

<p class="catalog-fourk">La 4K est disponible avec LTX 2.3 Fast et LTX 2.5 Fast. Connexion LTX requise. <button type="button" class="account-secondary" data-action="creation#showFourK" data-creation-target="fourK" hidden>Voir les modèles 4K</button></p>
<details class="creation-details creation-models" data-creation-target="catalog"><summary>Explorer le catalogue · {{ groups|length }} modèles · {{ models|length }} configurations</summary>
<div class="catalog-filters" data-creation-target="filters" hidden>
<div><label for="catalog-search">Rechercher un modèle</label><input id="catalog-search" type="search" placeholder="Kling, Wan, Alibaba…" data-creation-target="search" data-action="input->creation#filter"></div>
<div><label for="catalog-provider">Fournisseur</label><select id="catalog-provider" data-creation-target="provider" data-action="change->creation#filter"><option value="">Tous</option>{% for id,name in providers %}<option value="{{ id }}">{{ name }}</option>{% endfor %}</select></div>
<div><label for="catalog-audio">Audio</label><select id="catalog-audio" data-creation-target="audio" data-action="change->creation#filter"><option value="">Avec ou sans</option><option value="yes">Avec audio</option><option value="no">Sans audio</option></select></div>
<div><label for="catalog-duration">Durée souhaitée</label><select id="catalog-duration" data-creation-target="minimum" data-action="change->creation#filter"><option value="">Toutes</option><option value="5">Au moins 5 s</option><option value="10">Au moins 10 s</option><option value="15">Au moins 15 s</option><option value="30">Au moins 30 s</option></select></div>
<div><label for="catalog-quality">Résolution</label><select id="catalog-quality" data-creation-target="quality" data-action="change->creation#filter"><option value="">Toutes</option><option value="720p">720p · HD</option><option value="768p">768p · HD</option><option value="1080p">1080p · Full HD</option><option value="4k">4K · 2160p</option></select></div>
<div><label for="catalog-sort">Trier</label><select id="catalog-sort" data-creation-target="sort" data-action="change->creation#filter"><option value="">Ordre du catalogue</option><option value="price-asc">Prix croissant</option><option value="price-desc">Prix décroissant</option></select></div>
<div><label for="catalog-comparison">Comparer les prix pour</label><select id="catalog-comparison" data-creation-target="comparison" data-action="change->creation#filter"><option value="5">5 secondes</option><option value="6">6 secondes</option><option value="8">8 secondes</option><option value="10">10 secondes</option><option value="15">15 secondes</option><option value="30">30 secondes</option></select></div><p class="library-note">Comparaison pour la même durée, aux réglages indiqués sur chaque fiche. Les choix incompatibles restent en fin de liste.</p><label class="catalog-connected"><input type="checkbox" data-creation-target="onlyConnected" data-action="change->creation#filter"> Mes fournisseurs connectés</label>
<label class="catalog-connected"><input type="checkbox" data-creation-target="onlyFavorites" data-action="change->creation#filter"> Mes favoris</label></div><p class="library-note" data-creation-target="count" role="status" aria-live="polite">{{ models|length }} choix pris en charge localement.</p>
<div class="creation-model-grid" data-creation-target="grid">{% for groupId,group in groups %}{% include 'ai/_model_card.html.twig' %}{% endfor %}</div><p class="account-notice" data-creation-target="empty" hidden>Aucun modèle ne correspond. Modifie les filtres ou affiche les fournisseurs sans clé.</p><p class="library-note">Tarifs indicatifs vérifiés le 19/10/2026, hors taxes et conversion éventuelles. La durée dépend du modèle : jusqu’à 30 s natives avec Seedance 2.5. L’assemblage de plusieurs plans viendra avec le montage guidé.</p></details>
</section>
{% set latest = jobs|first %}<aside class="creation-preview" aria-labelledby="creation-preview-title"><div class="creation-preview-heading"><h2 id="creation-preview-title">{{ latest ? 'Dernière création' : 'Aperçu' }}</h2><span>VIDÉO COURTE</span></div>{% if latest and latest.video %}<video controls playsinline preload="metadata" src="{{ path('app_video_stream',{id:latest.video.id}) }}" aria-label="Aperçu de {{ latest.title }}"></video><h3>{{ latest.title }}</h3><a class="account-secondary" href="{{ path('app_video_download',{id:latest.video.id}) }}" download>Télécharger ↓</a><a class="account-secondary" href="{{ path('app_composer_start',{videos:[latest.video.id]}) }}">Préparer sa publication →</a>{% else %}<div class="creation-preview-empty" aria-hidden="true"><div class="creation-preview-frame"><svg viewBox="0 0 40 40" fill="none"><path d="M20 5c0 10-5 15-15 15 10 0 15 5 15 15 0-10 5-15 15-15-10 0-15-5-15-15Z" stroke="currentColor" stroke-width="1.2"/></svg></div></div>{% if latest %}<h3>{{ latest.title }}</h3><p>{{ {prepared:'Ton idée est enregistrée. Vérifie le récapitulatif pour la suite.',queued:'La génération attend son départ.',submitting:'La demande est en cours.',processing:'La génération est en cours.',waiting_key:'Ajoute ta clé pour reprendre cette création.',review:'Cette création demande une vérification.',available:'La vidéo a été retirée de la bibliothèque.'}[latest.status] }}</p><a class="account-secondary" href="{{ path('app_ai_generation',{id:latest.id}) }}">Retrouver cette création →</a>{% else %}<h3>Tout commence par une idée.</h3><p>Ta vidéo rejoindra ta bibliothèque une fois générée.</p>{% endif %}{% endif %}<a class="creation-key-link" href="{{ path('app_ai_keys') }}">Gérer mes clés IA ↗</a></aside></div>
<section class="ai-history" aria-labelledby="ai-history-title"><div class="studio-section-heading"><h2 id="ai-history-title">Tes créations</h2><a class="account-secondary" href="{{ path('app_ai_history') }}">Tout l’historique ↗</a></div>{% for job in jobs %}<a class="ai-history-item" href="{{ path('app_ai_generation',{id:job.id}) }}"><span><strong>{{ job.title }}</strong><small>{{ models[job.model].name }} · {{ models[job.model].quality == '4k' ? '4K' : models[job.model].quality }} · {{ providers[models[job.model].provider] }} · {{ job.seconds }} s · {{ job.ratio }}</small></span><span>{{ {prepared:'À confirmer',queued:'En attente',submitting:'Demande en cours',processing:'Génération en cours',waiting_key:'Clé à ajouter',review:'À vérifier',available:'Dans la bibliothèque'}[job.status] }} ↗</span></a>{% else %}<p class="library-note">Tes idées enregistrées et tes générations apparaîtront ici.</p>{% endfor %}</section>
{% endblock %}
