{% extends 'studio/base.html.twig' %}
{% block title %}Studio — VydFlow{% endblock %}
{% block studio_content %}
{% if episode|default(null) %}<a class="account-secondary composer-back" href="{{ path(episode.standalone ? 'app_studio' : 'app_series_show',episode.standalone ? {} : {id:episode.series.id}) }}">← {{ episode.standalone ? 'Studio' : episode.series.name }}</a>{% endif %}
<div class="studio-heading creation-heading"><div><span class="eyebrow">CRÉE. PRÉPARE. PUBLIE.</span><h1>{{ episode|default(null) ? episode.title : 'Créer une vidéo.' }}</h1><p>Ton idée, tes références et tes plans au même endroit.</p></div><div class="workspace-heading-actions"><a class="account-secondary" href="{{ path('app_ai_history') }}">Historique ↗</a><a class="account-secondary" href="{{ path('app_dashboard') }}">Mes vidéos ↗</a></div></div>

{% if not episode|default(null) and projects|default([]) %}<section class="recent-creations" aria-labelledby="recent-creations-title" data-controller="video-thumbnails"><div class="series-episodes-heading"><h2 id="recent-creations-title">Reprendre une création</h2><a class="account-secondary" href="{{ path('app_ai_history') }}">Tout l’historique ↗</a></div><div class="recent-creations-grid">{% for project in projects|slice(0,4) %}<a class="recent-creation" href="{{ path('app_series_episode',{id:project.id}) }}">{% include 'ai/_cover.html.twig' with {videoId:projectCovers[project.id]|default(null)} %}<div><h3>{{ project.title }}</h3><p{% if project.flowState in ['running','assembling'] %} class="is-processing"{% endif %}>{{ project.statusLabel }}</p></div><span aria-hidden="true">↗</span></a>{% endfor %}</div></section>{% endif %}
<div class="ai-workspace creation-workspace preparation-workspace"><section aria-labelledby="ai-idea-title" data-controller="creation preparation story-writer" data-story-writer-latest-value="{{ path('app_ai_story_latest',{scope:episode|default(null) ? episode.id : 0}) }}" data-story-writer-url-value="{{ path('app_ai_story_proposal') }}" data-story-writer-token-value="{{ csrf_token('story_proposal') }}" data-story-writer-episode-value="{{ episode|default(null) ? episode.id : 0 }}" data-action="submit->preparation#guardPending image-reference:changed->creation#referenceChanged change->preparation#change input->preparation#input" data-preparation-models-value="{{ models|json_encode|e('html_attr') }}" data-creation-models-value="{{ models|json_encode|e('html_attr') }}" data-creation-providers-value="{{ providers|json_encode|e('html_attr') }}" data-creation-connected-value="{{ connected|json_encode|e('html_attr') }}"><h2 id="ai-idea-title">Quelle est ton idée ?</h2>
<div class="account-form creation-source">{{ form_row(ideaForm.source,{attr:{form:'ai-idea-form','data-creation-target':'source','data-action':'change->creation#changeSource'}}) }}</div>
<div class="account-form creation-framing ai-settings">{{ form_row(ideaForm.ratio,{attr:{form:'ai-idea-form','data-creation-target':'ratio','data-action':'change->creation#frameChanged'}}) }}<div data-creation-target="imageSettings">{{ form_row(ideaForm.imageFit,{attr:{form:'ai-idea-form','data-creation-target':'imageFit','data-action':'change->creation#frameChanged'}}) }}</div></div>
<div class="creation-reference" data-creation-target="referencePanel">
{% include 'ai/_reference_input.html.twig' with {slot:'start',referenceForm:referenceForm,referenceUrl:referenceUrl|default(null)} %}
<div class="account-form creation-end-option">{{ form_row(ideaForm.useEnd,{attr:{form:'ai-idea-form','data-creation-target':'useEnd','data-action':'change->creation#changeEnd'}}) }}</div>
<div data-creation-target="endPanel">{% include 'ai/_reference_input.html.twig' with {slot:'end',referenceForm:endReferenceForm,referenceUrl:endReferenceUrl|default(null)} %}</div>
<p class="library-note" role="status" data-creation-target="framingNotice">L’aperçu montre le cadrage qui sera envoyé au modèle.</p>
</div>
{{ form_start(ideaForm,{attr:{id:'ai-idea-form',class:'account-form creation-form','data-controller':episode|default(null) ? 'unsaved shot-editor' : 'idea-save shot-editor', 'data-shot-editor-model-value':models[ideaForm.model.vars.value]|default({})|json_encode,'data-idea-save-url-value':path('app_ai_save_idea'),'data-idea-save-revision-value':app.session.get('ai_idea_revision'),'data-action':episode|default(null) ? 'input->unsaved#change change->unsaved#change submit->unsaved#submit' : 'input->idea-save#change change->idea-save#change submit->idea-save#submit pagehide@window->idea-save#flush'}}) }}
{{ form_errors(ideaForm) }}{{ form_widget(ideaForm.reference,{attr:{'data-creation-target':'reference'}}) }}{{ form_errors(ideaForm.reference) }}{{ form_widget(ideaForm.endReference,{attr:{'data-creation-target':'endReference'}}) }}{{ form_errors(ideaForm.endReference) }}{{ form_row(ideaForm.prompt) }}{{ form_row(ideaForm.target,{attr:{'data-preparation-target':'total','data-action':'change->preparation#duration'}}) }}<p class="library-note" data-preparation-target="notice" role="status">Choisis un modèle pour obtenir un découpage compatible. Le coût total sera confirmé avant toute génération.</p>
<p class="library-note" data-preparation-target="single">Un seul clip : aucun enchaînement à régler.</p><div data-preparation-target="continuityPanel">{{ form_row(ideaForm.continuity,{attr:{'data-preparation-target':'continuity'}}) }}<p class="library-note" data-preparation-target="continuityHelp">Plusieurs scènes assemblées, ou une action prolongée avec un modèle image compatible.</p><button type="button" class="account-secondary" data-preparation-target="fixContinuity" data-action="preparation#imageMode">Choisir un modèle image et sa référence</button></div>
<p class="library-note" role="status" data-idea-save-target="status" hidden>Ton idée est conservée pendant ta session après modification.</p>
<noscript><p class="library-note">Pour conserver ton idée sans JavaScript, ouvre le récapitulatif avant de quitter cette page.</p></noscript>
<button type="button" class="account-secondary" data-idea-save-target="retry" data-action="idea-save#flush" hidden>Réessayer l’enregistrement</button>
{% include 'ai/_recommendations.html.twig' %}
<details class="creation-details creation-model-options" data-creation-target="modelDetails" open><summary>Choisir un autre modèle ou une autre résolution</summary>
<div class="creation-picker" data-creation-target="picker" hidden>
<label for="creation-model-search">Trouver un modèle</label><input id="creation-model-search" type="search" placeholder="Nom du modèle ou fournisseur…" disabled data-creation-target="pickerSearch" data-action="input->creation#searchPicker change->creation#searchPicker keydown.enter->creation#preventPickerSubmit">
<p class="library-note" role="status" data-creation-target="pickerCount">Tes favoris sont marqués d’une étoile ★.</p>
<div class="creation-search-results" data-creation-target="pickerResults" aria-label="Résultats des modèles" hidden>{% for groupId,group in groups %}{% set provider = models[group.variants|first].provider %}<button type="button" class="creation-search-result" data-creation-target="pickerResult" data-group-id="{{ groupId }}" data-source="{{ models[group.variants|first].subjectReference|default(false) ? 'subject' : (models[group.variants|first].image|default(false) ? 'image' : 'text') }}" data-action="creation#pickResult"><span data-result-label>{{ groupId in app.user.aiFavorites ? '★ ' : '' }}{{ group.name }} · {{ providers[provider] }}</span><small>{{ not connected[provider] ? 'À connecter' : 'Connecté' }} · {{ group.variants|map(id => models[id].quality == '4k' ? '4K' : models[id].quality)|join(' / ') }}{{ models[group.variants|first].endImageField|default(null) ? ' · Début + fin' : '' }}</small></button>{% endfor %}</div>
<div class="ai-settings"><div><label for="creation-model-group">Modèle</label><select id="creation-model-group" disabled required data-creation-target="group" data-action="change->creation#selectGroup"><option value="">Choisir un modèle</option>{% for groupId,group in groups %}{% set provider = models[group.variants|first].provider %}<option value="{{ groupId }}" data-source="{{ models[group.variants|first].subjectReference|default(false) ? 'subject' : (models[group.variants|first].image|default(false) ? 'image' : 'text') }}"{% if not connected[provider] %} class="catalog-option-disconnected"{% endif %}{% if ideaForm.model.vars.value in group.variants %} selected{% endif %}>{{ groupId in app.user.aiFavorites ? '★ ' : '' }}{{ group.name }} · {{ providers[provider] }}{{ not connected[provider] ? ' · à connecter' : '' }}</option>{% endfor %}</select></div>
<div><label for="creation-resolution">Résolution</label><select id="creation-resolution" disabled required data-creation-target="resolution" data-action="change->creation#selectResolution"><option value="">Choisir une résolution</option>{% for id,model in models %}<option value="{{ id }}">{{ model.quality == '4k' ? '4K · 2160p' : model.quality }}</option>{% endfor %}</select></div></div></div>
<div class="creation-native" data-creation-target="native">{{ form_label(ideaForm.model) }}{{ form_widget(ideaForm.model,{attr:{'data-creation-target':'model','data-action':'change->creation#changeModel'}}) }}</div></details>{{ form_errors(ideaForm.model) }}
<div class="catalog-connect-notice" data-creation-target="connection" role="status" tabindex="-1" hidden><p data-creation-target="connectionMessage"></p><button class="account-secondary" type="submit" name="intent" value="connect" formnovalidate data-creation-target="connectionButton">Connecter le fournisseur</button></div>
<details class="creation-details" data-creation-target="accessDetails"{% if not ideaForm.accessMode.vars.valid %} open{% endif %}><summary data-creation-target="billing">Connexion et facturation</summary>{{ form_row(ideaForm.accessMode,{attr:{'data-creation-target':'access','data-action':'change->creation#estimate'}}) }}<p class="library-note">La génération est payée chez ton fournisseur. Ton compte et le coût estimé seront indiqués avant confirmation. La méthode choisie reste conservée pour cette création.</p></details>
<div hidden>{{ form_row(ideaForm.seconds,{attr:{'data-creation-target':'duration','data-action':'change->creation#estimate'}}) }}</div>
{% include 'ai/_subjects.html.twig' with {subjectForm:ideaForm} %}
{% include 'ai/_story_proposal.html.twig' %}
<details class="creation-details"><summary>Personnaliser le nom de cette création</summary>{{ form_row(ideaForm.title) }}</details>
<div class="creation-estimate" hidden role="status" aria-live="polite"><strong data-creation-target="cost">Coût calculé au récapitulatif</strong><span data-creation-target="description">Une estimation avant toute génération.</span></div>
{% include 'ai/_preparation_plans.html.twig' %}
<div class="ai-actions"><button class="button" type="submit" name="intent" value="compose">Voir le récapitulatif →</button><button data-creation-target="connect" class="account-secondary" type="submit" name="intent" value="connect" formnovalidate>Connecter mon fournisseur</button></div><p class="library-note">Aucune dépense à cette étape. Tu confirmeras les scènes et le coût total avant le lancement.</p>{{ form_end(ideaForm) }}

<details class="creation-details creation-models" data-creation-target="catalog"><summary>Explorer le catalogue · {{ groups|length }} modèles · {{ models|filter(model => model.operation is not defined)|length }} configurations</summary>
<p class="catalog-fourk">La 4K est disponible avec LTX 2.3 Fast et LTX 2.5 Fast. Connexion LTX requise · texte ou images de début et de fin. <button type="button" class="account-secondary" data-action="creation#showFourK" data-creation-target="fourK" hidden>Voir les modèles 4K</button></p>
<div class="catalog-filters" data-creation-target="filters" hidden>
<div><label for="catalog-search">Rechercher un modèle</label><input id="catalog-search" type="search" placeholder="Kling, Wan, Alibaba…" data-creation-target="search" data-action="input->creation#filter"></div>
<div><label for="catalog-provider">Fournisseur</label><select id="catalog-provider" data-creation-target="provider" data-action="change->creation#filter"><option value="">Tous</option>{% for id,name in providers %}<option value="{{ id }}">{{ name }}</option>{% endfor %}</select></div>
<div><label for="catalog-audio">Audio</label><select id="catalog-audio" data-creation-target="audio" data-action="change->creation#filter"><option value="">Avec ou sans</option><option value="yes">Avec audio</option><option value="no">Sans audio</option></select></div>
<div><label for="catalog-duration">Durée souhaitée</label><select id="catalog-duration" data-creation-target="minimum" data-action="change->creation#filter"><option value="">Toutes</option><option value="5">Au moins 5 s</option><option value="10">Au moins 10 s</option><option value="15">Au moins 15 s</option><option value="30">Au moins 30 s</option></select></div>
<div><label for="catalog-quality">Résolution</label><select id="catalog-quality" data-creation-target="quality" data-action="change->creation#filter"><option value="">Toutes</option><option value="720p">720p · HD</option><option value="768p">768p · HD</option><option value="1080p">1080p · Full HD</option><option value="4k">4K · 2160p</option></select></div>
<div><label for="catalog-sort">Trier</label><select id="catalog-sort" data-creation-target="sort" data-action="change->creation#filter"><option value="">Ordre du catalogue</option><option value="price-asc">Prix croissant</option><option value="price-desc">Prix décroissant</option></select></div>
<div><label for="catalog-comparison">Comparer les prix pour</label><select id="catalog-comparison" data-creation-target="comparison" data-action="change->creation#filter"><option value="5">5 secondes</option><option value="6">6 secondes</option><option value="8">8 secondes</option><option value="10">10 secondes</option><option value="15">15 secondes</option><option value="30">30 secondes</option></select></div><p class="library-note">Comparaison pour la même durée, aux réglages indiqués sur chaque fiche. Les choix incompatibles restent en fin de liste.</p><label class="catalog-connected"><input type="checkbox" data-creation-target="onlyConnected" data-action="change->creation#filter"> Mes fournisseurs connectés</label>
<label class="catalog-connected"><input type="checkbox" data-creation-target="onlyFavorites" data-action="change->creation#filter"> Mes favoris</label></div><p class="library-note" data-creation-target="count" role="status" aria-live="polite">{{ models|filter(model => model.operation is not defined)|length }} configurations présentes dans ce catalogue.</p>
<div class="creation-model-grid" data-creation-target="grid">{% for groupId,group in groups %}{% include 'ai/_model_card.html.twig' %}{% endfor %}</div><p class="account-notice" data-creation-target="empty" hidden>Aucun modèle ne correspond. Modifie les filtres ou affiche les fournisseurs sans clé.</p><p class="library-note">Tarifs indicatifs vérifiés les 19–20/10/2026, hors taxes et conversion éventuelles. La durée dépend du modèle : jusqu’à 30 s natives avec Seedance 2.5. Les plans sont assemblés automatiquement après génération.</p></details>
</section>
{% set latest = jobs|first %}<aside hidden class="creation-preview" aria-labelledby="creation-preview-title"><div class="creation-preview-heading"><h2 id="creation-preview-title">{{ latest ? 'Dernière création' : 'Aperçu' }}</h2><span>VIDÉO COURTE</span></div>{% if latest and latest.video %}<video controls playsinline preload="metadata" src="{{ path('app_video_stream',{id:latest.video.id}) }}" aria-label="Aperçu de {{ latest.title }}"></video><h3>{{ latest.title }}</h3><a class="account-secondary" href="{{ path('app_video_download',{id:latest.video.id}) }}" download>Télécharger ↓</a>{% include 'edit/_start.html.twig' with {video:latest.video} %}<a class="account-secondary" href="{{ path('app_composer_start',{videos:[latest.video.id]}) }}">Préparer sa publication →</a>{% else %}<div class="creation-preview-empty" aria-hidden="true"><div class="creation-preview-frame"><svg viewBox="0 0 40 40" fill="none"><path d="M20 5c0 10-5 15-15 15 10 0 15 5 15 15 0-10 5-15 15-15-10 0-15-5-15-15Z" stroke="currentColor" stroke-width="1.2"/></svg></div></div>{% if latest %}<h3>{{ latest.title }}</h3><p>{{ {replaced:'Cette estimation a été remplacée par une vidéo à plans.',prepared:'Ton idée est enregistrée. Vérifie le récapitulatif pour la suite.',queued:'La génération attend son départ.',submitting:'La demande est en cours.',processing:'La génération est en cours.',waiting_key:'Ajoute ta clé pour reprendre cette création.',review:'Cette création demande une vérification.',available:'La vidéo a été retirée de la bibliothèque.'}[latest.status] }}</p><a class="account-secondary" href="{{ path('app_ai_generation',{id:latest.id}) }}">Retrouver cette création →</a>{% else %}<h3>Tout commence par une idée.</h3><p>Ta vidéo rejoindra ta bibliothèque une fois générée.</p>{% endif %}{% endif %}<a class="creation-key-link" href="{{ path('app_ai_keys') }}">Mes connexions IA ↗</a></aside></div>
{% if projects|default([]) %}<section class="story-panel"><h2>Mes vidéos à plans</h2><div class="ai-history-list" data-controller="video-thumbnails">{% for project in projects %}<article class="ai-history-row"><a class="project-cover-link" href="{{ path('app_series_episode',{id:project.id}) }}" aria-label="Ouvrir {{ project.title }}">{% include 'ai/_cover.html.twig' with {videoId:projectCovers[project.id]|default(null)} %}</a><div><h3>{{ project.title }}</h3><p>{{ project.statusLabel }}</p></div><a class="account-secondary" href="{{ path('app_series_episode',{id:project.id}) }}">Ouvrir les plans →</a></article>{% endfor %}</div></section>{% endif %}
{% endblock %}
