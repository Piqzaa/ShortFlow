{% extends 'studio/base.html.twig' %}
{% block title %}Studio — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading creation-heading"><div><span class="eyebrow">CRÉE. PRÉPARE. PUBLIE.</span><h1>Studio.</h1><p>Un espace pour donner forme à tes prochaines vidéos.</p></div><a class="account-secondary" href="{{ path('app_dashboard') }}">Mes vidéos ↗</a></div>
<nav class="creation-tools" aria-label="Outils du Studio"><a href="{{ path('app_studio') }}" aria-current="page"><span aria-hidden="true">✦</span> Créer avec l’IA</a><span class="creation-tool-soon" aria-disabled="true">Montage guidé <small>À venir</small></span></nav>
<div class="ai-workspace creation-workspace"><section aria-labelledby="ai-idea-title" data-controller="creation" data-creation-models-value="{{ models|json_encode|e('html_attr') }}" data-creation-connected-value="{{ connected|json_encode|e('html_attr') }}"><h2 id="ai-idea-title">Quelle est ton idée ?</h2>
<details class="creation-details creation-models"><summary>Explorer le catalogue · {{ models|length }} choix modèle / fournisseur</summary>
<div class="catalog-filters" data-creation-target="filters" hidden>
<div><label for="catalog-search">Rechercher un modèle</label><input id="catalog-search" type="search" placeholder="Kling, Wan, Alibaba…" data-creation-target="search" data-action="input->creation#filter"></div>
<div><label for="catalog-provider">Fournisseur</label><select id="catalog-provider" data-creation-target="provider" data-action="change->creation#filter"><option value="">Tous</option>{% for id,name in providers %}<option value="{{ id }}">{{ name }}</option>{% endfor %}</select></div>
<div><label for="catalog-audio">Audio</label><select id="catalog-audio" data-creation-target="audio" data-action="change->creation#filter"><option value="">Avec ou sans</option><option value="yes">Avec audio</option><option value="no">Sans audio</option></select></div>
<div><label for="catalog-duration">Durée souhaitée</label><select id="catalog-duration" data-creation-target="minimum" data-action="change->creation#filter"><option value="">Toutes</option><option value="5">Au moins 5 s</option><option value="10">Au moins 10 s</option><option value="15">Au moins 15 s</option></select></div>
<label class="catalog-connected"><input type="checkbox" data-creation-target="onlyConnected" data-action="change->creation#filter"> Mes fournisseurs connectés</label>
</div><p class="library-note" data-creation-target="count" role="status" aria-live="polite">{{ models|length }} choix pris en charge localement.</p>
<div class="creation-model-grid">{% for id,model in models %}<article data-creation-target="card" data-model-id="{{ id }}"><span>{{ model.maker }} · {{ providers[model.provider] }}</span><h3>{{ model.name }}</h3><p>{{ model.description }}</p><small>{{ model.seconds|length > 3 ? model.seconds|first ~ '–' ~ model.seconds|last ~ ' s, par pas de 1 s' : model.seconds|join(' / ') ~ ' s' }} · {{ model.audio ? 'Audio généré' : 'Sans audio' }} · {{ model.quality }}<br>{{ model.ratios|join(' · ') }}</small><p class="catalog-key">{{ connected[model.provider] ? 'Clé enregistrée · accès à vérifier' : 'Clé ' ~ providers[model.provider] ~ ' à ajouter' }}</p><p class="ai-model-price">{{ (model.rateMicros / 1000000)|number_format(3,',',' ') }} $ US / s</p><div class="catalog-card-actions"><button type="button" class="account-secondary" data-action="creation#choose" data-model-id="{{ id }}" data-creation-target="choose" aria-label="Choisir {{ model.name }} chez {{ providers[model.provider] }}" hidden>Choisir</button><a href="{{ model.provider == 'fal' ? 'https://fal.ai/models/' ~ model.endpoint : 'https://replicate.com/' ~ model.endpoint }}" target="_blank" rel="noopener noreferrer">Tarif fournisseur ↗</a></div></article>{% endfor %}</div><p class="account-notice" data-creation-target="empty" hidden>Aucun modèle ne correspond. Modifie les filtres ou affiche les fournisseurs sans clé.</p><p class="library-note">Tarifs indicatifs vérifiés le 19/10/2026, hors taxes et conversion éventuelles. Chaque durée concerne un plan : l’assemblage de vidéos de 30–60 s viendra avec le montage guidé.</p></details>
{{ form_start(ideaForm,{attr:{class:'account-form creation-form','data-controller':'unsaved','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}
{{ form_errors(ideaForm) }}{{ form_row(ideaForm.prompt) }}
{{ form_row(ideaForm.model,{attr:{'data-creation-target':'model','data-action':'change->creation#changeModel'}}) }}
<div class="ai-settings">{{ form_row(ideaForm.seconds,{attr:{'data-creation-target':'duration','data-action':'change->creation#estimate'}}) }}{{ form_row(ideaForm.ratio,{attr:{'data-creation-target':'ratio'}}) }}</div>
<details class="creation-details"><summary>Personnaliser le nom de cette création</summary>{{ form_row(ideaForm.title) }}</details>
<div class="creation-estimate" role="status" aria-live="polite"><strong data-creation-target="cost">Coût calculé au récapitulatif</strong><span data-creation-target="description">Une estimation avant toute génération.</span></div>
<div class="ai-actions"><button class="button" type="submit" name="intent" value="prepare">Voir le récapitulatif →</button><button data-creation-target="connect" class="account-secondary" type="submit" name="intent" value="connect">Ajouter ma clé en gardant l’idée</button></div><p class="library-note">Aucune dépense à cette étape. Tu confirmeras le coût avant le lancement.</p>{{ form_end(ideaForm) }}

</section>
{% set latest = jobs|first %}<aside class="creation-preview" aria-labelledby="creation-preview-title"><div class="creation-preview-heading"><h2 id="creation-preview-title">{{ latest ? 'Dernière création' : 'Aperçu' }}</h2><span>VIDÉO COURTE</span></div>{% if latest and latest.video %}<video controls playsinline preload="metadata" src="{{ path('app_video_stream',{id:latest.video.id}) }}" aria-label="Aperçu de {{ latest.title }}"></video><h3>{{ latest.title }}</h3><a class="account-secondary" href="{{ path('app_composer_start',{videos:[latest.video.id]}) }}">Préparer sa publication →</a>{% else %}<div class="creation-preview-empty" aria-hidden="true"><div class="creation-preview-frame"><svg viewBox="0 0 40 40" fill="none"><path d="M20 5c0 10-5 15-15 15 10 0 15 5 15 15 0-10 5-15 15-15-10 0-15-5-15-15Z" stroke="currentColor" stroke-width="1.2"/></svg></div></div>{% if latest %}<h3>{{ latest.title }}</h3><p>{{ {prepared:'Ton idée est enregistrée. Vérifie le récapitulatif pour la suite.',queued:'La génération attend son départ.',submitting:'La demande est en cours.',processing:'La génération est en cours.',waiting_key:'Ajoute ta clé pour reprendre cette création.',review:'Cette création demande une vérification.',available:'La vidéo a été retirée de la bibliothèque.'}[latest.status] }}</p><a class="account-secondary" href="{{ path('app_ai_generation',{id:latest.id}) }}">Retrouver cette création →</a>{% else %}<h3>Tout commence par une idée.</h3><p>Ta vidéo rejoindra ta bibliothèque une fois générée.</p>{% endif %}{% endif %}<div class="creation-next"><span class="eyebrow">LA SUITE DU STUDIO</span><p>Le montage guidé permettra de préparer tes vidéos importées ou générées avec une recette réutilisable.</p><small>En préparation · aucune transformation disponible actuellement.</small></div><a class="creation-key-link" href="{{ path('app_ai_keys') }}">Gérer mes clés IA ↗</a></aside></div>
<section class="ai-history" aria-labelledby="ai-history-title"><div class="studio-section-heading"><h2 id="ai-history-title">Tes créations</h2><span>Les 12 plus récentes</span></div>{% for job in jobs %}<a class="ai-history-item" href="{{ path('app_ai_generation',{id:job.id}) }}"><span><strong>{{ job.title }}</strong><small>{{ models[job.model].name }} · {{ providers[models[job.model].provider] }} · {{ job.seconds }} s · {{ job.ratio }}</small></span><span>{{ {prepared:'À confirmer',queued:'En attente',submitting:'Demande en cours',processing:'Génération en cours',waiting_key:'Clé à ajouter',review:'À vérifier',available:'Dans la bibliothèque'}[job.status] }} ↗</span></a>{% else %}<p class="library-note">Tes idées enregistrées et tes générations apparaîtront ici.</p>{% endfor %}</section>
{% endblock %}
