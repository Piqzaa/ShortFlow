{% extends 'studio/base.html.twig' %}
{% block title %}Studio — VydFlow{% endblock %}
{% block studio_content %}
{% if episode|default(null) %}<a class="account-secondary composer-back" href="{{ path(episode.standalone ? 'app_studio' : 'app_series_show',episode.standalone ? {} : {id:episode.series.id}) }}">← {{ episode.standalone ? 'Studio' : episode.series.name }}</a>{% endif %}
<div class="studio-heading creation-heading"><div><span class="eyebrow">CRÉE. PRÉPARE. PUBLIE.</span><h1>{{ episode|default(null) ? episode.title : 'Créer une vidéo.' }}</h1><p>Ton idée, tes références et tes plans au même endroit.</p></div><div class="workspace-heading-actions"><a class="account-secondary" href="{{ path('app_ai_history') }}">Historique ↗</a><a class="account-secondary" href="{{ path('app_dashboard') }}">Mes vidéos ↗</a></div></div>

{% if not episode|default(null) and projects|default([]) %}<section class="recent-creations" aria-labelledby="recent-creations-title" data-controller="video-thumbnails"><div class="series-episodes-heading"><h2 id="recent-creations-title">Reprendre une création</h2><a class="account-secondary" href="{{ path('app_ai_history') }}">Tout l’historique ↗</a></div><div class="recent-creations-grid">{% for project in projects|slice(0,4) %}<a class="recent-creation" href="{{ path('app_series_episode',{id:project.id}) }}">{% include 'ai/_cover.html.twig' with {videoId:projectCovers[project.id]|default(null)} %}<div><h3>{{ project.title }}</h3><p{% if project.flowState in ['running','assembling'] %} class="is-processing"{% endif %}>{{ project.statusLabel }}</p></div><span aria-hidden="true">↗</span></a>{% endfor %}</div></section>{% endif %}
<div class="ai-workspace creation-workspace preparation-workspace"><section aria-labelledby="ai-idea-title" data-controller="creation preparation story-writer" data-story-writer-latest-value="{{ path('app_ai_story_latest',{scope:episode|default(null) ? episode.id : 0}) }}" data-story-writer-url-value="{{ path('app_ai_story_proposal') }}" data-story-writer-token-value="{{ csrf_token('story_proposal') }}" data-story-writer-enabled-value="{{ writerAvailable ? 'true' : 'false' }}" data-story-writer-episode-value="{{ episode|default(null) ? episode.id : 0 }}" data-action="shot-editor:count-changed->preparation#countFromCards submit->preparation#guardPending:capture image-reference:changed->creation#referenceChanged change->preparation#change input->preparation#input" data-preparation-models-value="{{ models|json_encode|e('html_attr') }}" data-creation-models-value="{{ models|json_encode|e('html_attr') }}" data-creation-providers-value="{{ providers|json_encode|e('html_attr') }}" data-creation-connected-value="{{ connected|json_encode|e('html_attr') }}"><h2 id="ai-idea-title">Quelle est ton idée ?</h2>
<div class="account-form creation-source">{{ form_row(ideaForm.source,{help:'Texte seul, image à animer ou référence d’apparence.',attr:{form:'ai-idea-form','data-creation-target':'source','data-action':'change->creation#changeSource'}}) }}</div>
<div class="account-form creation-framing ai-settings">{{ form_row(ideaForm.ratio,{attr:{form:'ai-idea-form','data-creation-target':'ratio','data-action':'change->creation#frameChanged'}}) }}<div data-creation-target="imageSettings">{{ form_row(ideaForm.imageFit,{attr:{form:'ai-idea-form','data-creation-target':'imageFit','data-action':'change->creation#frameChanged'}}) }}</div></div>
<div class="creation-reference" data-creation-target="referencePanel">
{% include 'ai/_reference_input.html.twig' with {slot:'start',referenceForm:referenceForm,referenceUrl:referenceUrl|default(null)} %}
<div class="account-form creation-end-option" data-creation-target="endOption"{% if ideaForm.source.vars.value != 'image' and not ideaForm.useEnd.vars.checked %} hidden{% endif %}>{{ form_row(ideaForm.useEnd,{attr:{form:'ai-idea-form','data-creation-target':'useEnd','data-action':'change->creation#changeEnd'}}) }}</div>
<div data-creation-target="endPanel"{% if ideaForm.source.vars.value != 'image' or not ideaForm.useEnd.vars.checked %} hidden{% endif %}>{% include 'ai/_reference_input.html.twig' with {slot:'end',referenceForm:endReferenceForm,referenceUrl:endReferenceUrl|default(null)} %}</div>
<p class="library-note" role="status" data-creation-target="framingNotice">L’aperçu montre le cadrage qui sera envoyé au modèle.</p>
</div>
{{ form_start(ideaForm,{attr:{id:'ai-idea-form',class:'account-form creation-form','data-controller':episode|default(null) ? 'unsaved shot-editor' : 'idea-save shot-editor', 'data-unsaved-initial':(singlePrepared|default(false) or layoutPrepared|default(false) or ideaForm.vars.submitted) ? 'true' : 'false','data-shot-editor-model-value':models[ideaForm.model.vars.value]|default({})|json_encode,'data-idea-save-url-value':path('app_ai_save_idea'),'data-idea-save-revision-value':app.session.get('ai_idea_revision'),'data-action':episode|default(null) ? 'input->unsaved#change change->unsaved#change submit->unsaved#submit' : 'input->idea-save#change change->idea-save#change submit->idea-save#submit pagehide@window->idea-save#flush'}}) }}
{{ form_errors(ideaForm) }}{{ form_widget(ideaForm.reference,{attr:{'data-creation-target':'reference'}}) }}{{ form_errors(ideaForm.reference) }}{{ form_widget(ideaForm.endReference,{attr:{'data-creation-target':'endReference'}}) }}{{ form_errors(ideaForm.endReference) }}{{ form_row(ideaForm.prompt) }}
{% include 'ai/_timing.html.twig' %}
<p class="library-note" role="status" data-idea-save-target="status" hidden></p>
<noscript><p class="library-note">Pour conserver ton idée sans JavaScript, ouvre le récapitulatif avant de quitter cette page.</p></noscript>
<button type="button" class="account-secondary" data-idea-save-target="retry" data-action="idea-save#flush" hidden>Réessayer l’enregistrement</button>
{% include 'ai/_recommendations.html.twig' %}
<div class="creation-options-grid">
<details class="creation-details creation-model-options" data-creation-target="modelDetails" data-picker-invalid="{{ not ideaForm.model.vars.valid ? 'true' : 'false' }}" open><summary>Choisir un autre modèle ou une autre résolution</summary>
{% include 'ai/_model_picker.html.twig' with {pickerPrefix:'creation',modelForm:ideaForm.model,accessForm:ideaForm.accessMode,modelChange:'change->creation#changeModel'} %}</details>
{% include 'ai/_video_connection.html.twig' with {pickerPrefix:'creation',modelForm:ideaForm.model,accessForm:ideaForm.accessMode,accessChange:'change->creation#estimate'} %}
</div>
<div class="catalog-connect-notice" data-creation-target="connection" role="status" tabindex="-1" hidden><p data-creation-target="connectionMessage"></p><button class="account-secondary" type="submit" name="intent" value="connect" formnovalidate data-creation-target="connectionButton">Connecter le fournisseur</button></div>
<div hidden>{{ form_row(ideaForm.seconds,{attr:{'data-creation-target':'duration','data-action':'change->creation#estimate'}}) }}</div>
{% include 'ai/_subjects.html.twig' with {subjectForm:ideaForm} %}
{% include 'ai/_story_proposal.html.twig' %}
{% if not ideaForm.title.vars.valid %}{{ form_row(ideaForm.title) }}{% else %}{{ form_widget(ideaForm.title,{type:'hidden'}) }}{% endif %}
<div class="creation-estimate" hidden role="status" aria-live="polite"><strong data-creation-target="cost">Coût calculé au récapitulatif</strong><span data-creation-target="description">Une estimation avant toute génération.</span></div>
{% include 'ai/_preparation_plans.html.twig' %}
<div class="ai-actions"><button class="button" type="submit" name="intent" value="compose" data-preparation-target="recap">Voir le récapitulatif →</button><button data-creation-target="connect" class="account-secondary" type="submit" name="intent" value="connect" formnovalidate>Connecter mon fournisseur</button></div><p class="library-note">Aucune dépense à cette étape. Tu confirmeras les scènes et le coût total avant le lancement.</p>{{ form_end(ideaForm) }}

<details class="creation-details creation-models" data-creation-target="catalog"><summary>Explorer le catalogue · {{ groups|length }} modèles · {{ models|filter(model => model.operation is not defined)|length }} configurations</summary>
<p class="catalog-fourk">La 4K est disponible avec LTX 2.3 Fast et LTX 2.5 Fast. Connexion LTX requise · texte ou images de début et de fin. <button type="button" class="account-secondary" data-action="creation#showFourK" data-creation-target="fourK" hidden>Voir les modèles 4K</button></p>
<div class="catalog-filters" data-creation-target="filters" hidden>
<div><label for="catalog-search">Rechercher un modèle</label><input id="catalog-search" type="search" placeholder="Kling, Wan, Alibaba…" data-creation-target="search" data-action="input->creation#filter"></div>
<div><label for="catalog-provider">Fournisseur</label><select id="catalog-provider" data-creation-target="provider" data-action="change->creation#filter"><option value="">Tous</option>{% for id,name in providers %}<option value="{{ id }}">{{ name }}</option>{% endfor %}</select></div>
<div><label for="catalog-audio">Audio</label><select id="catalog-audio" data-creation-target="audio" data-action="change->creation#filter"><option value="">Avec ou sans</option><option value="yes">Avec audio</option><option value="no">Sans audio</option></select></div>
<div><label for="catalog-duration">Durée souhaitée</label><select id="catalog-duration" data-creation-target="minimum" data-action="change->creation#filter"><option value="">Toutes</option><option value="5">Au moins 5 s</option><option value="10">Au moins 10 s</option><option value="15">Au moins 15 s</option><option value="30">Au moins 30 s</option></select></div>
<div><label for="catalog-quality">Résolution</label><select id="catalog-quality" data-creation-target="quality" data-action="change->creation#filter"><option value="">Toutes</option><option value="720p">720p · HD</option><option value="768p">768p · HD</option><option value="1080p">1080p · Full HD</option><option value="4k">4K · 2160p</option></select></div>
<div><label for="catalog-sort">Trier</label><select id="catalog-sort" data-creation-target="sort" data-action="change->creation#filter"><option value="">Ordre du catalogue</option><option value="price-asc">Prix croissant</option><option value="price-desc">Prix décroissant</option></select></div>
<div><label for="catalog-comparison">Comparer les prix pour</label><select id="catalog-comparison" data-creation-target="comparison" data-action="change->creation#filter"><option value="5">5 secondes</option><option value="6">6 secondes</option><option value="8">8 secondes</option><option value="10">10 secondes</option><option value="15">15 secondes</option><option value="30">30 secondes</option></select></div><p class="library-note">Comparaison pour la même durée, aux réglages indiqués sur chaque fiche. Les choix incompatibles restent en fin de liste.</p><label class="catalog-connected"><input type="checkbox" data-creation-target="onlyConnected" data-action="change->creation#filter"> Mes fournisseurs connectés</label>
<label class="catalog-connected"><input type="checkbox" data-creation-target="onlyFavorites" data-action="change->creation#filter"> Mes favoris</label></div><p class="library-note" data-creation-target="count" role="status" aria-live="polite">{{ models|filter(model => model.operation is not defined)|length }} configurations présentes dans ce catalogue.</p>
<div class="creation-model-grid" data-creation-target="grid">{% for groupId,group in groups %}{% include 'ai/_model_card.html.twig' %}{% endfor %}</div><p class="account-notice" data-creation-target="empty" hidden>Aucun modèle ne correspond. Modifie les filtres ou affiche les fournisseurs sans clé.</p><p class="library-note">Tarifs indicatifs vérifiés les 19–20/10/2026, hors taxes et conversion éventuelles. La durée dépend du modèle : jusqu’à 30 s natives avec Seedance 2.5. Les plans sont assemblés automatiquement après génération.</p></details>
</section>
{% set latest = jobs|first %}<aside hidden class="creation-preview" aria-labelledby="creation-preview-title"><div class="creation-preview-heading"><h2 id="creation-preview-title">{{ latest ? 'Dernière création' : 'Aperçu' }}</h2><span>VIDÉO COURTE</span></div>{% if latest and latest.video %}<video controls playsinline preload="none" src="{{ path('app_video_stream',{id:latest.video.id}) }}" aria-label="Aperçu de {{ latest.title }}"></video><h3>{{ latest.title }}</h3><a class="account-secondary" href="{{ path('app_video_download',{id:latest.video.id}) }}" download>Télécharger ↓</a>{% include 'edit/_start.html.twig' with {video:latest.video} %}<a class="account-secondary" href="{{ path('app_composer_start',{videos:[latest.video.id]}) }}">Préparer sa publication →</a>{% else %}<div class="creation-preview-empty" aria-hidden="true"><div class="creation-preview-frame"><svg viewBox="0 0 40 40" fill="none"><path d="M20 5c0 10-5 15-15 15 10 0 15 5 15 15 0-10 5-15 15-15-10 0-15-5-15-15Z" stroke="currentColor" stroke-width="1.2"/></svg></div></div>{% if latest %}<h3>{{ latest.title }}</h3><p>{{ {replaced:'Cette estimation a été remplacée par une vidéo à plans.',prepared:'Ton idée est enregistrée. Vérifie le récapitulatif pour la suite.',queued:'La génération attend son départ.',submitting:'La demande est en cours.',processing:'La génération est en cours.',waiting_key:'Ajoute ta clé pour reprendre cette création.',review:'Cette création demande une vérification.',available:'La vidéo a été retirée de la bibliothèque.'}[latest.status] }}</p><a class="account-secondary" href="{{ path('app_ai_generation',{id:latest.id}) }}">Retrouver cette création →</a>{% else %}<h3>Tout commence par une idée.</h3><p>Ta vidéo rejoindra ta bibliothèque une fois générée.</p>{% endif %}{% endif %}<a class="creation-key-link" href="{{ path('app_ai_keys') }}">Mes connexions IA ↗</a></aside></div>
{% if projects|default([]) %}<section class="story-panel"><h2>Mes dernières vidéos à plans</h2><a class="account-secondary" href="{{ path('app_ai_history') }}">Tout l’historique ↗</a><div class="ai-history-list" data-controller="video-thumbnails">{% for project in projects %}<article class="ai-history-row"><a class="project-cover-link" href="{{ path('app_series_episode',{id:project.id}) }}" aria-label="Ouvrir {{ project.title }}">{% include 'ai/_cover.html.twig' with {videoId:projectCovers[project.id]|default(null)} %}</a><div><h3>{{ project.title }}</h3><p>{{ project.statusLabel }}</p></div><a class="account-secondary" href="{{ path('app_series_episode',{id:project.id}) }}">Ouvrir les plans →</a></article>{% endfor %}</div></section>{% endif %}
{% endblock %}
