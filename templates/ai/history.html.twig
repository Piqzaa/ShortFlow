{% extends 'studio/base.html.twig' %}
{% block title %}Mes créations IA — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading"><div><span class="eyebrow">DE L’IDÉE À LA VIDÉO</span><h1>Mes créations.</h1><p>Retrouve tes idées, tes générations et leurs résultats.</p></div><a class="button" href="{{ path('app_studio') }}">Créer une vidéo +</a></div>
<form method="get" class="ai-history-filters account-form" role="search"><div><label for="history-search">Rechercher par nom</label><input id="history-search" type="search" name="q" value="{{ query }}" maxlength="120" placeholder="Le nom d’une création…"></div><div><label for="history-status">État</label><select id="history-status" name="status"><option value="">Tous les états</option>{% for value,label in labels %}<option value="{{ value }}"{{ status == value ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><button class="account-secondary" type="submit">Rechercher</button></form>
<p class="library-note" role="status">{{ history.total }} création{{ history.total > 1 ? 's' : '' }}</p>
<div class="ai-history-list" data-controller="video-thumbnails">{% for job in history.items %}<article class="ai-history-row"><a class="ai-history-cover" href="{{ path('app_ai_generation',{id:job.id}) }}" aria-label="Ouvrir {{ job.title }}">{% if job.video %}<video data-preview-src="{{ path('app_video_stream',{id:job.video.id}) }}#t=0.1" data-video-thumbnails-target="video" preload="none" muted playsinline aria-hidden="true"></video>{% else %}<span aria-hidden="true">✦</span>{% endif %}</a><div class="ai-history-description"><h2><a href="{{ path('app_ai_generation',{id:job.id}) }}">{{ job.title }}</a></h2><p>{{ models[job.model].name }} · {{ providers[models[job.model].provider] }} · {{ models[job.model].quality == '4k' ? '4K' : models[job.model].quality }} · {{ job.seconds }} s</p><small>{{ job.createdAt|date('d/m/Y à H:i',app.user.timezone) }} · {{ labels[job.status] }}{{ job.status == 'available' and not job.video ? ' · vidéo retirée' : '' }}</small></div><div class="ai-history-actions"><a class="account-secondary" href="{{ path('app_ai_generation',{id:job.id}) }}">Voir le détail →</a>{% include 'ai/_reuse.html.twig' %}</div></article>{% else %}<div class="workspace-empty"><h2>{{ query or status ? 'Aucune création trouvée.' : 'Ta première idée commence ici.' }}</h2><p>{{ query or status ? 'Modifie ta recherche ou affiche toutes tes créations.' : 'Tes idées et leurs vidéos apparaîtront ici.' }}</p>{% if query or status %}<a class="account-secondary" href="{{ path('app_ai_history') }}">Tout afficher</a>{% endif %}</div>{% endfor %}</div>
{% if history.pages > 1 %}<nav class="library-pagination" aria-label="Pages des créations">{% if history.page > 1 %}<a href="{{ path('app_ai_history',{q:query,status:status,page:history.page-1}) }}">← Précédente</a>{% endif %}<span>{{ history.page }} / {{ history.pages }}</span>{% if history.page < history.pages %}<a href="{{ path('app_ai_history',{q:query,status:status,page:history.page+1}) }}">Suivante →</a>{% endif %}</nav>{% endif %}
{% endblock %}
