{% extends 'studio/base.html.twig' %}
{% block title %}{{ series ? 'Configurer la série' : 'Nouvelle série' }} — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ series ? path('app_series_show',{id:series.id}) : path('app_series') }}">← {{ series ? 'Les épisodes' : 'Mes séries' }}</a>
<div class="workspace-heading"><div><span class="eyebrow">LE CADRE COMMUN</span><h1>{{ series ? 'Configurer la série' : 'Ta nouvelle série' }}</h1><p>{{ series ? 'Les réglages vidéo s’appliqueront aux épisodes sans estimation. Les prompts existants seront conservés.' : 'Définis ton univers. Trois épisodes seront prêts à compléter.' }}</p></div></div>
{% set settings = {} %}{% for id,model in models %}{% set settings = settings|merge({(id):{seconds:model.seconds,ratios:model.ratios,image:model.image|default(false),end:model.endImageField is defined,requiresEnd:model.requiresEnd|default(false)}}) %}{% endfor %}
{{ form_start(seriesForm,{attr:{class:'account-form series-config','data-controller':'series-settings unsaved','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit','data-series-settings-models-value':settings|json_encode}}) }}
{{ form_errors(seriesForm) }}
<section class="series-config-section"><h2><span>01</span> L’univers de la série</h2>{{ form_row(seriesForm.name) }}{{ form_row(seriesForm.theme) }}<div class="series-two-columns">{{ form_row(seriesForm.style) }}{{ form_row(seriesForm.characters) }}</div><p class="library-note">Ces indications seront copiées dans les premiers prompts, que tu pourras adapter épisode par épisode. La cohérence des personnages dépend des capacités du modèle IA.</p></section>
<section class="series-config-section"><h2><span>02</span> Les réglages vidéo</h2>{{ form_row(seriesForm.model) }}<p class="library-note" data-series-settings-target="hint" aria-live="polite">Choisis une durée et un format compatibles avec le modèle.</p><div class="series-two-columns">{{ form_row(seriesForm.seconds) }}{{ form_row(seriesForm.ratio) }}</div>{{ form_row(seriesForm.accessMode) }}<details class="series-access"><summary>Mes connexions disponibles</summary><ul>{% for provider,connected in access %}<li>{{ provider }} · {{ connected ? 'connecté' : 'à connecter' }}</li>{% endfor %}</ul><a class="account-secondary" href="{{ path('app_ai_keys') }}">Gérer mes connexions ↗</a><p class="library-note">Tu peux enregistrer ta série avant de connecter ton fournisseur.</p></details></section>
<section class="series-config-section" data-series-settings-target="images"><h2><span>03</span> Les images de référence</h2><p class="library-note">Pour un modèle image vers vidéo : image de départ obligatoire, image de fin selon ses capacités. JPG, PNG ou WebP, 10 Mo maximum ; 300 à 4 096 pixels par côté.</p><div class="series-two-columns"><div>{% if series and series.recipe.reference %}<img class="series-reference" src="{{ path('app_ai_reference_image',{name:series.recipe.reference}) }}" alt="Image de départ enregistrée"><p class="library-note">Image conservée si tu n’en importes pas une nouvelle.</p>{% endif %}{{ form_row(seriesForm.image) }}</div><div>{% if series and series.recipe.endReference %}<img class="series-reference" src="{{ path('app_ai_reference_image',{name:series.recipe.endReference}) }}" alt="Image de fin enregistrée">{% endif %}{{ form_row(seriesForm.endImage) }}</div></div>{{ form_row(seriesForm.imageFit) }}</section>
<p class="library-note">Enregistrer prépare tes épisodes sans lancer de génération. Le coût de chaque vidéo sera affiché avant confirmation, puis facturé directement par ton fournisseur.</p><button class="button" type="submit">{{ series ? 'Enregistrer la configuration' : 'Créer la série et ses 3 épisodes →' }}</button>
{{ form_end(seriesForm) }}
{% endblock %}
