{% extends 'studio/base.html.twig' %}
{% block title %}{{ series ? 'Configurer la série' : 'Nouvelle série' }} — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ series ? path('app_series_show',{id:series.id}) : path('app_series') }}">← {{ series ? 'Les épisodes' : 'Mes séries' }}</a>
{% if series %}<div class="series-actions"><a class="account-secondary" href="{{ path('app_series_editorial',{id:series.id}) }}">Style des textes ↗</a><a class="account-secondary" href="{{ path('app_series_montage',{id:series.id}) }}">Montage des épisodes ↗</a></div>{% endif %}
<div class="workspace-heading"><div><span class="eyebrow">LE CADRE COMMUN</span><h1>{{ series ? 'Configurer la série' : 'Ta nouvelle série' }}</h1><p>{{ series ? 'Les réglages vidéo s’appliqueront aux épisodes sans estimation. Les prompts existants seront conservés.' : 'Définis ton univers et choisis combien d’épisodes préparer.' }}</p></div></div>
{% set settings = {} %}{% for id,model in models %}{% set settings = settings|merge({(id):model|merge({subject:model.subjectReference|default(false),end:model.endImageField is defined})}) %}{% endfor %}
{{ form_start(seriesForm,{attr:{class:'account-form series-config','data-controller':'series-settings unsaved character-picker','data-action':'input->unsaved#change change->unsaved#change submit->series-settings#guardPending submit->unsaved#submit','data-character-picker-models-value':models|json_encode,'data-character-picker-url-value':path('app_character_choices'),'data-series-settings-models-value':settings|json_encode,'data-series-settings-connected-value':connected|json_encode,'data-series-settings-providers-value':providers|json_encode}}) }}
{{ form_errors(seriesForm) }}
<section class="series-config-section" data-series-section="concept">
<h2><span>01</span> Ton idée de série</h2>
{{ form_row(seriesForm.name) }}{{ form_row(seriesForm.theme,{label:'De quoi parle ta série ?'}) }}
<p class="library-note">Ce fil conducteur est commun à la série. Chaque épisode pourra raconter sa propre histoire.</p>
<details class="creation-details" data-series-context{% if not seriesForm.style.vars.valid or not seriesForm.characters.vars.valid %} open{% endif %}>
<summary>Préciser le style et les personnages</summary>
<div class="series-two-columns">{{ form_row(seriesForm.style) }}{{ form_row(seriesForm.characters) }}</div>
</details>
</section>
{% include 'series/_publication_settings.html.twig' with {publicationForm:seriesForm.publication} %}
<section class="series-config-section" data-series-section="source">
<h2><span>02</span> Ton point de départ</h2>
<div class="source-help-heading">{{ form_label(seriesForm.source) }}{% include 'ai/_source_help.html.twig' %}</div>{{ form_widget(seriesForm.source) }}{{ form_errors(seriesForm.source) }}
{% include 'ai/_character_pool.html.twig' with {poolForm:seriesForm} %}
<div data-series-settings-target="images" data-reference-invalid="{{ not seriesForm.image.vars.valid or not seriesForm.endImage.vars.valid or not seriesForm.subjects.vars.valid or not seriesForm.subjectDetails.vars.valid or not seriesForm.subjectImages.vars.valid ? 'true' : 'false' }}">
<p class="library-note">JPG, PNG ou WebP · 10 Mo maximum · 300 à 4 096 pixels par côté.</p>
<div class="series-two-columns">{% include 'series/_reference.html.twig' with {slot:'start'} %}<div data-series-settings-target="endPanel">{% include 'series/_reference.html.twig' with {slot:'end'} %}</div></div>
{% include 'ai/_subjects.html.twig' with {subjectForm:seriesForm,subjectPrimaryReference:series ? series.recipe.reference : ''} %}
<details class="creation-details" data-series-settings-target="fitPanel"{% if not seriesForm.imageFit.vars.valid %} open{% endif %}><summary>Cadrage des images</summary>{{ form_row(seriesForm.imageFit) }}</details>
</div>
</section>
<section class="series-config-section" data-series-section="video">
<h2><span>03</span> Le format de tes vidéos</h2>
<div class="series-two-columns">{{ form_row(seriesForm.ratio) }}{{ form_row(seriesForm.totalSeconds,{label:'Durée par épisode (secondes)'}) }}</div>
{% include 'ai/_recommendations.html.twig' with {pickerPrefix:'series-settings'} %}
<div class="creation-options-grid"><details class="creation-details" data-series-settings-target="modelDetails" data-picker-existing="{{ series ? 'true' : 'false' }}" data-picker-invalid="{{ not seriesForm.model.vars.valid ? 'true' : 'false' }}" open><summary>Choisir un autre modèle ou une autre résolution</summary>{% include 'ai/_model_picker.html.twig' with {pickerPrefix:'series-settings',modelForm:seriesForm.model,accessForm:seriesForm.accessMode,modelChange:'change->series-settings#change'} %}</details>
{% include 'ai/_video_connection.html.twig' with {pickerPrefix:'series-settings',modelForm:seriesForm.model,accessForm:seriesForm.accessMode,accessChange:'change->series-settings#accessChanged',seriesContext:true} %}</div>
<p class="library-note" data-series-settings-target="hint" aria-live="polite">Choisis une durée et un format compatibles avec le modèle.</p><div hidden>{{ form_row(seriesForm.seconds) }}</div></section>
{% if seriesForm.episodeCount is defined %}<section class="series-config-section" data-series-section="episodes"><h2><span>04</span> Tes premiers épisodes</h2>{{ form_row(seriesForm.episodeCount) }}<p class="library-note">Ce sont des brouillons : tu choisiras les plans et lanceras chaque vidéo ensuite.</p></section>{% endif %}
<p class="library-note">Enregistrer prépare tes épisodes sans lancer de génération. Le coût de chaque vidéo sera affiché avant confirmation, puis facturé directement par ton fournisseur.</p><button class="button" type="submit">{{ series ? 'Enregistrer la configuration' : 'Créer ma série →' }}</button>
{{ form_end(seriesForm) }}
{% if series %}<section class="series-delete-zone"><h2>Gestion de la série</h2><p class="library-note">La suppression retire la série et ses épisodes, en conservant les vidéos et les préparations de publication.</p><a class="account-secondary" href="{{ path('app_series_delete',{id:series.id}) }}">Supprimer cette série…</a></section>{% endif %}
{% endblock %}
