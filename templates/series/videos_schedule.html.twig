{% extends 'studio/base.html.twig' %}
{% block title %}Programmer la série — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_video_series_show',{id:series.id}) }}">← Retour à la série</a>
<div class="workspace-heading"><div><span class="eyebrow">PROGRAMMER LA SÉRIE</span><h1>Un créneau par épisode.</h1><p>Garde chaque brouillon de publication de la série ; aucun envoi ne démarre avant ta confirmation datée.</p></div></div>
{% include 'series/_destinations_summary.html.twig' with {seriesConfigurationRoute:'app_video_series_edit'} %}
{% set statusLabels = {plan:'À planifier',scheduled:'Programmé',sent:'Envoi demandé',attention:'À surveiller',history:'Historique conservé',to_prepare:'Sans brouillon'} %}
{{ form_start(form,{attr:{class:'account-form series-schedule-form'}}) }}{{ form_errors(form) }}{{ form_widget(form.revision) }}
<div class="publication-selection-list">
{% for row in rows %}{% set episode = row.episode %}
<section class="composer-section publication-selection-row" id="schedule-episode-{{ episode.id }}">
<span data-controller="video-thumbnails">{% include 'ai/_cover.html.twig' with {videoId:episode.video.id} %}</span>
<div>
<span class="eyebrow">ÉPISODE {{ row.minute }}</span><h2>{{ episode.video.title }}</h2><p class="library-note">{{ episode.video.duration|number_format(1,',') }} s · {{ statusLabels[row.kind] }}</p>
{% if row.kind == 'plan' %}{% set rowForm = attribute(form.selection,episode.id) %}
<div><label class="publication-checkbox">{{ form_widget(rowForm.picked) }}<span>Programmer cet épisode</span></label>{{ form_widget(rowForm.draft) }}{{ form_widget(rowForm.revision) }}</div>
{{ form_label(rowForm.local) }}{{ form_errors(rowForm.local) }}{{ form_widget(rowForm.local,{type:'datetime-local'}) }}
{{ form_row(rowForm.zone) }}<p class="library-note">Entre deux minutes et 90 jours dans le futur. Le fuseau de cet épisode est conservé avec son créneau.</p>
<a class="account-secondary" href="{{ path('app_composer_start',{draft:row.draft.id}) }}">Compléter les textes et les réglages ↗</a>
{% elseif row.kind == 'scheduled' %}
<p class="library-note">Départ prévu le {{ row.draft.scheduledAt|date('d/m/Y à H:i',row.draft.timezone) }} · {{ row.draft.timezone }}.</p><a class="account-secondary" href="{{ path('app_draft',{id:row.draft.id}) }}">Ouvrir la programmation et le suivi ↗</a>
{% elseif row.kind == 'sent' %}
<a class="account-secondary" href="{{ path('app_draft',{id:row.draft.id}) }}">Voir le suivi de publication ↗</a>
{% elseif row.kind == 'attention' %}
<a class="account-secondary" href="{{ path('app_draft',{id:row.draft.id}) }}">Relire les créneaux manqués ↗</a>
{% elseif row.kind == 'history' %}
<p class="library-note">Les versions anciennes restent lisibles depuis l’épisode dans la série.</p><a class="account-secondary" href="{{ path('app_video_series_show',{id:series.id}) }}#video-episode-{{ episode.id }}">Revenir à l’épisode ↗</a>
{% else %}<a class="account-secondary" href="{{ path('app_video_series_show',{id:series.id}) }}#video-episode-{{ episode.id }}">Ouvrir l’épisode pour préparer sa publication ↗</a>
{% endif %}
</div></section>
{% endfor %}
</div>
<p class="library-note">Le récapitulatif d’abord, la confirmation ensuite : rien ne part avant. La confirmation gère les épisodes choisis seulement ; les autres gardent leur brouillon.</p>
<button class="button" type="submit" name="intent" value="preview">Vérifier l’aperçu ↗</button>
{% if preview %}
<section class="composer-section" id="series-schedule-preview" aria-labelledby="series-schedule-preview-title"><h2 id="series-schedule-preview-title">Récapitulatif de la programmation</h2>
{% if preview.ready %}
<p>{{ preview.ready|length }} épisode{{ preview.ready|length > 1 ? 's' : '' }} prêt{{ preview.ready|length > 1 ? 's' : '' }}</p>
{% for slot in preview.ready %}
<article class="batch-review">
<h3>Épisode {{ slot.minute }} · départ le {{ slot.at|date('d/m/Y à H:i',slot.zone) }} · {{ slot.zone }}</h3>
{% include 'publication/_batch_review.html.twig' with {videos:slot.videos,networks:slot.draft.networks,content:slot.draft.content(),destinations:slot.review.destinations} %}
</article>
{% endfor %}
{% else %}
<p class="library-note">Aucun épisode n’est prêt pour la programmation. Corrige les points suivants puis vérifie de nouveau l’aperçu.</p>
{% endif %}
{% if preview.issues %}
<aside class="account-notice batch-issues" role="status"><strong>Ces épisodes ne passent pas à la confirmation.</strong>
<ul>{% for slot in preview.issues %}<li><strong>Épisode {{ slot.minute }}</strong> · {% if slot.issue is defined and slot.issue %}{{ slot.issue }}{% endif %}{% for network,messages in slot.review.issues %}{% for message in messages %} {{ message }}{% endfor %}{% endfor %}</li>{% endfor %}</ul>
<p>Ta préparation est conservée. Corrige les points indiqués, puis vérifie de nouveau le récapitulatif.</p><a class="account-secondary" href="{{ path('app_connections') }}">Gérer mes réseaux ↗</a></aside>
{% endif %}
</section>
{% endif %}
<div class="series-schedule-confirm"{% if not snapshot %} hidden{% endif %}>
<p>Une confirmation programme les épisodes affichés dans le récapitulatif, avec leur compte, leurs textes et leurs réglages. Les envois démarreront ensuite automatiquement aux créneaux choisis ; le PC, le worker et les connexions doivent fonctionner. Un épisode déjà programmé ne change pas.</p>
{{ form_row(form.confirm) }}
{{ form_widget(form.snapshot,{value:snapshot|default('')}) }}
<button class="button" type="submit" name="intent" value="confirm"{% if not snapshot %} disabled{% endif %}>Confirmer la programmation de {{ preview ? preview.ready|length : 0 }} épisode{{ preview and preview.ready|length > 1 ? 's' : '' }} ↗</button>
</div>
{{ form_end(form) }}
{% endblock %}
