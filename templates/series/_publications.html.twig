{% if summaries %}<section class="episode-publications" aria-label="Publications de cet épisode"><h3>Publication</h3>{% for summary in summaries %}<div class="story-shot"><p><strong>{{ summary.label }}</strong>{% if not summary.current %} · Version antérieure{% endif %}</p>{% if summary.draft.scheduledAt %}<p class="library-note">{{ summary.draft.scheduledAt|date('d/m/Y à H:i',summary.draft.timezone) }} · {{ summary.draft.timezone }}</p>{% endif %}<ul>{% for destination in summary.destinations %}<li>{{ destination.name }} · {{ destination.status }}</li>{% else %}<li>Réseaux à choisir</li>{% endfor %}</ul><a class="account-secondary" href="{{ path(summary.draft.status == 'draft' ? 'app_composer_start' : 'app_draft', summary.draft.status == 'draft' ? {draft:summary.draft.id} : {id:summary.draft.id}) }}">{{ summary.draft.status == 'draft' ? 'Reprendre la préparation' : 'Ouvrir la programmation et le suivi' }} ↗</a></div>{% endfor %}</section>{% endif %}
