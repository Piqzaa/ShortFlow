{% extends 'studio/base.html.twig' %}
{% block title %}{{ series.name }} — Mes séries{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_series') }}">← Mes séries</a>
<div class="series-actions"><a class="account-secondary" href="{{ path('app_series_editorial',{id:series.id}) }}">Voix et hashtags de la série ↗</a><a class="account-secondary" href="{{ path('app_series_montage',{id:series.id}) }}">Profil de montage ↗</a></div>
<div class="workspace-heading"><div><span class="eyebrow">STUDIO DE SÉRIES</span><h1>{{ series.name }}</h1><p>{{ series.theme }}</p></div><div class="workspace-heading-actions"><a class="account-secondary" href="{{ path('app_series_edit',{id:series.id}) }}">Configurer la série ↗</a><a class="account-secondary" href="{{ path('app_series_delete',{id:series.id}) }}">Supprimer la série…</a></div></div>
<div class="series-overview"><span><small>MODÈLE COMMUN</small><strong>{{ model.name }} · {{ provider }}</strong></span><span><small>ÉPISODES</small><strong>{{ pagination.total }} épisode{{ pagination.total > 1 ? 's' : '' }}</strong></span><span><small>GÉNÉRATION</small><strong>{{ series.recipe.totalSeconds|default(30) }} s par épisode · {{ series.recipe.ratio }}</strong></span></div>
<p class="library-note series-intro">Prépare tes épisodes à la main ou programme leurs scénarios chaque semaine ci-dessous. Relis les plans et confirme le coût de chaque vidéo avant de la générer. Tu valides ensuite la vidéo et sa publication. Les générations sont facturées directement sur ton compte chez {{ provider }}.</p>
{% if recurrence is defined %}{% include 'series/_recurrence.html.twig' %}{% endif %}{% include 'series/_occurrence_history.html.twig' %}
<section data-controller="video-thumbnails" class="series-episodes" data-series-page="{{ pagination.page }}" data-series-navigation-blocked="{{ navigationBlocked ? 'true' : 'false' }}" aria-labelledby="episodes-title"><div class="series-episodes-heading"><h2 id="episodes-title" tabindex="-1">Les épisodes</h2><a class="account-secondary" href="{{ path('app_series_show',{id:series.id,page:pagination.page,occurrencePage:historyOpen ? occurrenceHistory.page : null}) }}">Actualiser les états ↻</a></div>{% include 'series/_episode_pagination.html.twig' with {pagerLabel:'Pages des épisodes (haut)'} %}{% for episode in episodes %}
{% set occurrence = occurrenceByEpisode[episode.id]|default(null) %}
{% set currentPublication = (publicationSummaries[episode.id]|default([])|filter(item => item.current))|first|default(null) %}
<article class="series-episode" id="episode-{{ episode.id }}"><header>{% if episodeCovers[episode.id]|default(null) %}{% include 'ai/_cover.html.twig' with {videoId:episodeCovers[episode.id]} %}{% endif %}<span class="series-number">{{ '%02d'|format(episode.number) }}</span><h3>{{ episode.title }}</h3><span class="series-status{{ episode.generation and episode.generation.status == 'available' ? ' is-ready' : '' }}">{{ occurrence and occurrence.status == 'writing' ? 'Rédaction en cours' : episode.statusLabel }}</span></header>
{% if episode.flowState == 'ready' %}<p class="library-note" role="status">{% if not episode.approvedVideo %}Action suivante : vérifier la vidéo puis valider cette version.{% elseif not currentPublication %}Action suivante : préparer les textes et la programmation de cette version.{% elseif currentPublication.draft.status == 'draft' %}Action suivante : relire les textes par réseau puis confirmer la publication. Le brouillon n’est pas encore programmé.{% else %}Publication confirmée : consulte le suivi de chaque réseau ci-dessous.{% endif %}</p>{% endif %}
{% if occurrence %}<p class="library-note">Publication visée, à confirmer : {{ occurrence.scheduledAt|date('d/m/Y à H:i',occurrence.timezone) }} · validation avant publication</p>{% if occurrence.networks %}<p class="library-note">Destinations prévues : {% for network in occurrence.networks %}{% set identity = occurrence.accounts[network]|default(null) %}{{ {youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'}[network] }} · {{ identity ? accountNames[network][identity]|default('Compte enregistré indisponible · ' ~ identity) : 'Compte à choisir' }}{{ not loop.last ? ' / ' : '' }}{% endfor %}. À confirmer avant publication.</p>{% endif %}{% if occurrence.status == 'writing' %}<p class="library-note" role="status">{{ occurrence.createdAt|date('U') < date('-10 minutes')|date('U') ? 'Rédaction interrompue : ouvre l’épisode pour reprendre manuellement.' : 'L’IA écrit l’histoire de cet épisode…' }}</p>{% endif %}{% if occurrence.issue %}<p class="account-notice" role="status">{{ occurrence.issue }}</p>{% endif %}{% endif %}
{% if occurrence and occurrence.status == 'writing' %}
<a class="account-secondary" href="{{ path('app_series_episode',{id:episode.id}) }}">Ouvrir l’épisode →</a>
{% elseif episode.flowState %}
<p class="library-note">Vidéo préparée · {{ episode.statusLabel }}</p><a class="button" href="{{ path('app_series_episode',{id:episode.id}) }}">Ouvrir les plans →</a>
{% elseif episode.generation and episode.generation.status != 'prepared' %}
<p class="series-prompt">{{ episode.prompt }}</p><div class="series-actions"><a class="button" href="{{ path('app_ai_generation',{id:episode.generation.id}) }}">Ouvrir le suivi →</a><span class="library-note">{{ (episode.generation.estimatedCents / 100)|number_format(2,',',' ') }} $ US estimés</span></div>
{% else %}
{% if episode.generation %}<p class="library-note">Estimation conservée : {{ models[episode.generation.model].name }} · {{ episode.generation.seconds }} s · {{ episode.generation.ratio }}. Tu peux modifier le modèle et les plans avant de confirmer.</p>{% endif %}
{% if episode.prompt and episode.prompt != series.initialPrompt %}<p class="series-prompt">{{ episode.prompt }}</p>{% else %}<p class="library-note">Histoire à préparer · propose un scénario avec l’IA ou écris ton idée.</p>{% endif %}<a class="button" href="{{ path('app_series_episode',{id:episode.id}) }}">Préparer la vidéo →</a>
{% endif %}
{% if episodeForms[episode.id]|default(null) %}<div class="legacy-episode-correction" role="region" aria-label="Saisie de l’ancien onglet"><p class="library-note">Cette ancienne saisie n’a pas été enregistrée. Corrige les champs signalés, ou copie tes textes avant d’ouvrir la préparation actuelle.</p>{{ form_start(episodeForms[episode.id],{attr:{class:'account-form','data-controller':'unsaved','data-unsaved-initial':'true','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}{{ form_errors(episodeForms[episode.id]) }}{{ form_row(episodeForms[episode.id].title) }}{{ form_row(episodeForms[episode.id].prompt) }}<button type="submit" class="account-secondary" name="intent" value="save">Enregistrer cette saisie</button>{{ form_end(episodeForms[episode.id]) }}</div>{% endif %}
{% include 'series/_publications.html.twig' with {summaries:publicationSummaries[episode.id]|default([])} %}
</article>{% else %}<p class="library-note">Ton univers est enregistré. Ajoute un épisode pour préparer ta première histoire.</p>{% endfor %}{% include 'series/_episode_pagination.html.twig' with {pagerLabel:'Pages des épisodes (bas)'} %}</section>
{% if addEpisodesForm|default(null) %}{{ form_start(addEpisodesForm,{attr:{id:'add-episodes',tabindex:'-1',class:'account-form series-add-episodes'}}) }}{{ form_errors(addEpisodesForm) }}{{ form_row(addEpisodesForm.count) }}<button class="account-secondary" type="submit">Ajouter les épisodes →</button>{{ form_end(addEpisodesForm) }}{% endif %}
<p class="library-note">Le suivi affiche l’état réel de chaque génération. Valide une vidéo pour choisir ses réseaux et son créneau. La récurrence prépare les prochains épisodes ; les publications restent à confirmer.</p>

{% endblock %}
