{% extends 'studio/base.html.twig' %}
{% block title %}{{ series.name }} — Mes séries{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_series') }}">← Mes séries</a>
<div class="workspace-heading"><div><span class="eyebrow">TA SÉRIE, ÉPISODE PAR ÉPISODE</span><h1>{{ series.name }}</h1><p>{{ series.theme }}</p></div></div>
<div class="series-overview series-overview-compact"><strong>{{ pagination.total }} épisode{{ pagination.total > 1 ? 's' : '' }}</strong><span>{{ series.recipe.totalSeconds|default(30) }} s par épisode · {{ series.recipe.ratio }}</span></div>
{% include 'series/_destinations_summary.html.twig' with {seriesConfigurationRoute:'app_series_edit'} %}
{% if addEpisodesForm|default(null) %}<details class="series-add-panel"{% if addEpisodesForm.vars.submitted or not addEpisodesForm.vars.valid %} open{% endif %}><summary class="button">Ajouter un épisode +</summary>{{ form_start(addEpisodesForm,{attr:{id:'add-episodes',tabindex:'-1',class:'account-form series-add-episodes'}}) }}{{ form_errors(addEpisodesForm) }}{{ form_row(addEpisodesForm.count) }}<p class="library-note">Ajoute des brouillons à préparer. Aucune vidéo n’est générée à cette étape.</p><button class="account-secondary" type="submit">Ajouter les épisodes →</button>{{ form_end(addEpisodesForm) }}</details>{% endif %}
<section data-controller="video-thumbnails" class="series-episodes" data-series-page="{{ pagination.page }}" data-series-navigation-blocked="{{ navigationBlocked ? 'true' : 'false' }}" aria-labelledby="episodes-title"><div class="series-episodes-heading"><h2 id="episodes-title" tabindex="-1">Les épisodes</h2><a class="account-secondary" href="{{ path('app_series_show',{id:series.id,page:pagination.page,occurrencePage:historyOpen ? occurrenceHistory.page : null}) }}">Actualiser les états ↻</a></div>{% include 'series/_episode_pagination.html.twig' with {pagerLabel:'Pages des épisodes (haut)'} %}{% for episode in episodes %}
{% set occurrence = occurrenceByEpisode[episode.id]|default(null) %}
{% set currentPublication = (publicationSummaries[episode.id]|default([])|filter(item => item.current))|first|default(null) %}
<article class="series-episode" id="episode-{{ episode.id }}"><header>{% if episodeCovers[episode.id]|default(null) %}{% include 'ai/_cover.html.twig' with {videoId:episodeCovers[episode.id]} %}{% endif %}<span class="series-number">{{ '%02d'|format(episode.number) }}</span><h3>{{ episode.title }}</h3><span class="series-status{{ episode.generation and episode.generation.status == 'available' ? ' is-ready' : '' }}">{{ occurrence and occurrence.status == 'writing' ? 'Rédaction en cours' : episode.statusLabel }}</span></header>
{% if episode.flowState == 'ready' %}<p class="library-note" role="status">{% if not currentPublication %}Vidéo prête : prépare ses textes et choisis quand publier.{% elseif currentPublication.draft.status == 'draft' %}Action suivante : relire les textes par réseau puis confirmer la publication. Le brouillon n’est pas encore programmé.{% elseif currentPublication.draft.status in ['scheduled','dispatched'] %}Consulte la programmation et le suivi de chaque réseau ci-dessous.{% else %}Publication à reprendre : consulte son état ci-dessous.{% endif %}</p>{% endif %}
{% if occurrence %}<p class="library-note">Publication visée, à confirmer : {{ occurrence.scheduledAt|date('d/m/Y à H:i',occurrence.timezone) }} · validation avant publication</p>{% if occurrence.networks %}<p class="library-note">Destinations prévues : {% for network in occurrence.networks %}{% set identity = occurrence.accounts[network]|default(null) %}{{ {youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'}[network] }} · {{ identity ? accountNames[network][identity]|default('Compte enregistré indisponible · ' ~ identity) : 'Compte à choisir' }}{{ not loop.last ? ' / ' : '' }}{% endfor %}. À confirmer avant publication.</p>{% endif %}{% if occurrence.status == 'writing' %}<p class="library-note" role="status">{{ occurrence.createdAt|date('U') < date('-10 minutes')|date('U') ? 'Rédaction interrompue : ouvre l’épisode pour reprendre manuellement.' : 'L’IA écrit l’histoire de cet épisode…' }}</p>{% endif %}{% if occurrence.issue %}<p class="account-notice" role="status">{{ occurrence.issue }}</p>{% endif %}{% endif %}
{% if occurrence and occurrence.status == 'writing' %}
<a class="account-secondary" href="{{ path('app_series_episode',{id:episode.id}) }}">Ouvrir l’épisode →</a>
{% elseif episode.flowState %}
{% set publicationVideo = episode.approvedVideo ?: (episode.assembly ? episode.assembly.output : null) %}
{% if episode.flowState == 'ready' and publicationVideo %}
{% include 'series/_publication_action.html.twig' with {publicationRoute:'app_episode_publication',publicationEpisodeId:episode.id,publicationToken:'episode_publication_' ~ episode.id,publicationRevision:episode.revision} %}
<a class="account-secondary series-secondary-action" href="{{ path('app_series_episode',{id:episode.id}) }}">Voir ou modifier la vidéo ↗</a>
{% else %}
<a class="button" href="{{ path('app_series_episode',{id:episode.id}) }}">{{ episode.flowState == 'ready' ? 'Voir la vidéo' : (episode.flowState in ['running','assembling'] ? 'Voir la génération' : (episode.flowState == 'paused' ? 'Reprendre la préparation' : (episode.flowState == 'stopped' ? 'Voir les plans' : 'Préparer la vidéo'))) }} →</a>
{% endif %}
{% elseif episode.generation and episode.generation.status != 'prepared' %}
{% if episode.prompt %}<details class="series-episode-description"><summary>Voir le texte de l’épisode</summary><p class="series-prompt">{{ episode.prompt }}</p></details>{% endif %}<div class="series-actions"><a class="button" href="{{ path('app_ai_generation',{id:episode.generation.id}) }}">{{ episode.generation.status == 'available' ? 'Voir la vidéo' : (episode.generation.status in ['queued','submitting','processing'] ? 'Voir la génération' : 'Vérifier la génération') }} →</a><span class="library-note">{{ ai_money(episode.generation.estimatedCents) }} estimés</span></div>
{% else %}
{% if episode.generation %}<p class="library-note">Estimation conservée : {{ models[episode.generation.model].name }} · {{ episode.generation.seconds }} s · {{ episode.generation.ratio }}. Tu peux modifier le modèle et les plans avant de confirmer.</p>{% endif %}
{% if episode.prompt and episode.prompt != series.initialPrompt %}<details class="series-episode-description"><summary>Voir le texte de l’épisode</summary><p class="series-prompt">{{ episode.prompt }}</p></details>{% else %}<p class="library-note">Histoire à préparer · propose un scénario avec l’IA ou écris ton idée.</p>{% endif %}<a class="button" href="{{ path('app_series_episode',{id:episode.id}) }}">Préparer la vidéo →</a>
{% endif %}
{% if episodeForms[episode.id]|default(null) %}<div class="legacy-episode-correction" role="region" aria-label="Saisie de l’ancien onglet"><p class="library-note">Cette ancienne saisie n’a pas été enregistrée. Corrige les champs signalés, ou copie tes textes avant d’ouvrir la préparation actuelle.</p>{{ form_start(episodeForms[episode.id],{attr:{class:'account-form','data-controller':'unsaved','data-unsaved-initial':'true','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}{{ form_errors(episodeForms[episode.id]) }}{{ form_row(episodeForms[episode.id].title) }}{{ form_row(episodeForms[episode.id].prompt) }}<button type="submit" class="account-secondary" name="intent" value="save">Enregistrer cette saisie</button>{{ form_end(episodeForms[episode.id]) }}</div>{% endif %}
{% include 'series/_publications.html.twig' with {summaries:publicationSummaries[episode.id]|default([])} %}
</article>{% else %}<p class="library-note">Ton univers est enregistré. Ajoute un épisode pour préparer ta première histoire.</p>{% endfor %}{% include 'series/_episode_pagination.html.twig' with {pagerLabel:'Pages des épisodes (bas)'} %}</section>
<details class="series-settings-panel"><summary>Réglages de la série</summary><p class="library-note">{{ model.name }} · {{ provider }} · {{ series.recipe.totalSeconds|default(30) }} s · {{ series.recipe.ratio }}</p><div class="series-actions"><a class="account-secondary" href="{{ path('app_series_edit',{id:series.id}) }}">Configurer la série ↗</a><a class="account-secondary" href="{{ path('app_series_editorial',{id:series.id}) }}">Style des textes ↗</a><a class="account-secondary" href="{{ path('app_series_montage',{id:series.id}) }}">Montage automatique (avancé) ↗</a><a class="account-secondary" href="{{ path('app_series_delete',{id:series.id}) }}">Supprimer la série…</a></div></details>
{% if recurrence is defined %}<details class="series-automatic-panel"{% if (recurrenceForm and recurrenceForm.vars.submitted) or historyOpen or recurrenceMissed|default([]) %} open{% endif %}><summary><span>Préparation automatique des épisodes</span><span class="series-automatic-status">{{ recurrence ? {active:'Active',paused:'En pause',finished:'Terminée'}[recurrence.status]|default('À vérifier') : 'Désactivée' }}{% if recurrence and recurrence.notice %} · À vérifier{% endif %}{% if recurrenceMissed|default([]) %} · Créneaux à reprendre{% endif %}</span></summary>{% include 'series/_recurrence.html.twig' %}{% include 'series/_occurrence_history.html.twig' %}</details>{% endif %}

{% endblock %}
