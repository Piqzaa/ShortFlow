{% if occurrenceHistory.total %}<details class="series-occurrence-history" id="occurrence-history"{% if historyOpen %} open{% endif %}><summary>Historique des créneaux · {{ occurrenceHistory.total }}</summary>
<div id="occurrence-history-content" tabindex="-1"><ul>{% for occurrence in occurrenceHistory.items %}<li><time datetime="{{ occurrence.scheduledAt|date('c') }}">{{ occurrence.scheduledAt|date('d/m/Y à H:i',occurrence.timezone) }}</time> · {{ {writing:'Rédaction en cours',production:'Vidéo en préparation',manual:'À relire',attention:'À reprendre'}[occurrence.status]|default('À vérifier') }}{% if occurrence.issue %}<p>{{ occurrence.issue }}</p>{% endif %}{% if occurrence.episode %}<a class="account-secondary" href="{{ path('app_series_show',{id:series.id,episode:occurrence.episode.id,occurrencePage:occurrenceHistory.page,'_fragment':'episode-' ~ occurrence.episode.id}) }}">Retrouver l’épisode {{ occurrence.episode.number }} ↗</a>{% endif %}</li>{% endfor %}</ul></div>
{% if occurrenceHistory.pages > 1 %}<nav class="series-pagination" aria-label="Pages des créneaux">
{% if occurrenceHistory.page > 1 %}<a class="account-secondary" rel="prev" href="{{ path('app_series_show',{id:series.id,page:pagination.page,occurrencePage:occurrenceHistory.page - 1,'_fragment':'occurrence-history-content'}) }}">← Plus récents</a>{% endif %}<span>Page {{ occurrenceHistory.page }} / {{ occurrenceHistory.pages }}</span>
{% if occurrenceHistory.page < occurrenceHistory.pages %}<a class="account-secondary" rel="next" href="{{ path('app_series_show',{id:series.id,page:pagination.page,occurrencePage:occurrenceHistory.page + 1,'_fragment':'occurrence-history-content'}) }}">Plus anciens →</a>{% endif %}
</nav>{% endif %}</details>{% endif %}
