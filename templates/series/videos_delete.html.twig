{% extends 'studio/base.html.twig' %}
{% block title %}Supprimer {{ series.name }} — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_video_series_show',{id:series.id}) }}">← Garder la série</a>
<section class="story-panel">
<span class="eyebrow">GÉRER MA SÉRIE</span>
<h1>Supprimer cette série ?</h1>
<h2>{{ series.name }}</h2>
<p>La série et son ordre d’épisodes seront supprimés définitivement. Tes vidéos restent dans la bibliothèque. Tu retrouves les <a class="account-secondary" href="{{ path('app_dashboard',{tab:'drafts'}) }}">brouillons dans Vidéos</a> et l’<a class="account-secondary" href="{{ path('app_publications') }}">historique dans Publications</a>.</p>
{% if error %}<p class="account-notice error" role="alert">{{ error }}</p>{% endif %}
{% if blockers %}
<p class="account-notice">Annule les programmations ou termine les envois en cours avant de supprimer cette série.</p>
<ul>
{% for draft in blockers %}
<li><a class="account-secondary" href="{{ path('app_draft',{id:draft.id}) }}">{{ draft.title }} · {{ draft.status == 'scheduled' ? 'Gérer la programmation' : 'Ouvrir le suivi' }} ↗</a></li>
{% endfor %}
</ul>
{% else %}
<form method="post" class="account-form">
<input type="hidden" name="_token" value="{{ csrf_token('video_series_delete_' ~ series.id) }}">
<input type="hidden" name="revision" value="{{ series.revision }}">
<label class="publication-checkbox"><input type="checkbox" name="confirm" value="1" required> Je confirme la suppression de la série.</label>
<div class="series-actions"><button class="button" type="submit">Supprimer la série</button><a class="account-secondary" href="{{ path('app_video_series_show',{id:series.id}) }}">Garder la série</a></div>
</form>
{% endif %}
</section>
{% endblock %}
