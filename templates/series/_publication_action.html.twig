{% if currentPublication|default(null) %}{% set publicationDraft = currentPublication.draft %}<a class="button" href="{{ path(publicationDraft.status == 'draft' ? 'app_composer_start' : 'app_draft',publicationDraft.status == 'draft' ? {draft:publicationDraft.id} : {id:publicationDraft.id}) }}">{{ publicationDraft.status == 'draft' ? 'Compléter les textes et la publication' : (publicationDraft.status == 'dispatched' ? 'Voir le suivi de publication' : 'Voir la programmation') }} →</a>
{% else %}<form method="post" action="{{ path(publicationRoute,{id:publicationEpisodeId}) }}" class="series-publication-action"><input type="hidden" name="_token" value="{{ csrf_token(publicationToken) }}"><input type="hidden" name="revision" value="{{ publicationRevision }}">{% if publicationVideo|default(null) %}<input type="hidden" name="video" value="{{ publicationVideo.id }}">{% endif %}<button class="button" type="submit">Préparer la publication →</button></form>{% endif %}
