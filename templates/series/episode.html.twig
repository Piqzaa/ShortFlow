{% extends 'studio/base.html.twig' %}
{% block title %}{{ episode.title }} · Les plans — VydFlow
{% endblock %}
{% block studio_content %}
{% if episode.standalone %}<a class="account-secondary composer-back" href="{{ path('app_studio') }}">← Studio</a>{% else %}<a class="account-secondary composer-back" href="{{ path('app_series_show',{id:episode.series.id,'_fragment':'episode-' ~ episode.id}) }}">← {{ episode.series.name }}</a>{% endif %}
<div class="workspace-heading"><div><span class="eyebrow">TA VIDÉO, TES PLANS</span><h1>{{ episode.title }}</h1><p>{{ model.name }} · {{ recipe.ratio == 'auto' ? 'Format de l’image' : recipe.ratio }} · BYOK</p></div><span class="series-status">{{ episode.statusLabel }}</span></div>
{% if episode.flowState in ['running','assembling','paused'] %}{% include 'series/_progress.html.twig' %}{% endif %}
{% if error %}<p class="account-notice error" role="alert">{{ error }}</p>{% endif %}
{% if episode.flowIssue %}<p class="account-notice" role="status">{{ episode.flowIssue }}</p>{% endif %}
<details class="story-context"><summary>Contexte de préparation</summary><p class="series-prompt">{{ episode.prompt }}</p>{% if recipe.reference %}<img class="series-reference" src="{{ path('app_ai_reference_image',{name:recipe.reference}) }}" alt="Référence commune des plans">{% endif %}<p class="library-note">Les scènes décrivent des actions différentes. Le devis indique le prompt exact, avec le contexte visuel adapté à la place disponible. Les références aident à garder le personnage, sans garantir une continuité parfaite.</p></details>
{% if not episode.flowState %}
<section class="story-panel"><h2>Choisir la durée de ta vidéo, jusqu’à 60 secondes</h2><p>VydFlow propose un découpage compatible avec ton modèle. Complète ensuite la scène de chaque plan avant toute génération.</p>
{{ form_start(storyForm,{attr:{class:'account-form','data-controller':'unsaved','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}{{ form_errors(storyForm) }}{{ form_row(storyForm.duration) }}
{% if layouts|default([]) %}<p class="library-note">Choisis un découpage. Le total exact et les durées de chaque plan sont indiqués ; tu pourras ensuite les personnaliser.</p>{{ form_row(storyForm.layout) }}{% else %}{{ form_widget(storyForm.layout,{attr:{hidden:true}}) }}{% endif %}
{% if episode.generation %}<p class="library-note">Cette action remplacera l’ancienne estimation non confirmée. Le prompt et les références sont conservés ; aucun appel fournisseur ne partira.</p>{% endif %}{{ form_row(storyForm.continuity) }}{{ form_row(storyForm.mute) }}<button class="button" type="submit">{{ layouts|default([]) ? 'Utiliser ce découpage →' : 'Proposer des découpages →' }}</button>{{ form_end(storyForm) }}<p class="library-note">Aucun coût fournisseur à cette étape. Le contexte est conservé ; les scènes restent à écrire manuellement.</p></section>
{% elseif episode.flowState == 'draft' %}
<p class="library-note">{{ episode.continuity == 'linked' ? 'Raccord depuis la fin du plan précédent ; génération dans l’ordre.' : 'Scènes distinctes avec les références communes ; génération dans l’ordre.' }} Les réglages vidéo sont ceux enregistrés pour cette vidéo.</p>
{% if quote %}{% include 'ai/_reference_review.html.twig' %}<div class="story-shot-list">{% for shot in shots %}<section class="story-shot"><h2>Plan {{ shot.position }} · {{ shot.seconds }} s</h2><p class="series-prompt">{{ shot.prompt }}</p></section>{% endfor %}</div><a class="account-secondary composer-back" href="{{ path('app_series_episode',{id:episode.id}) }}">← Modifier les scènes avant de confirmer</a>{% else %}
{{ form_start(storyForm,{attr:{class:'account-form story-form','data-controller':'unsaved shot-editor','data-shot-editor-model-value':model|json_encode,'data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit input->shot-editor#update change->shot-editor#update'}}) }}{{ form_errors(storyForm) }}{{ form_row(storyForm.title) }}
<p class="library-note" role="status" aria-live="polite" data-shot-editor-target="summary">Les durées et le coût total seront vérifiés avant confirmation. De 1 à 8 plans, jusqu’à 60 secondes.</p>
<div data-shot-editor-target="list">{% for shotForm in storyForm.shots %}<section class="story-shot" data-shot-editor-row><h2 data-shot-heading>Plan {{ loop.index }}</h2>{{ form_errors(shotForm) }}{{ form_row(shotForm.prompt) }}{{ form_row(shotForm.seconds) }}{% include 'ai/_shot_references.html.twig' %}<div class="story-row-actions"><button class="account-secondary" type="submit" name="plan_action" value="up:{{ loop.index0 }}" data-action="shot-editor#act"{% if loop.first %} disabled{% endif %}>Monter</button><button class="account-secondary" type="submit" name="plan_action" value="down:{{ loop.index0 }}" data-action="shot-editor#act"{% if loop.last %} disabled{% endif %}>Descendre</button><button class="account-secondary" type="submit" name="plan_action" value="remove:{{ loop.index0 }}" data-action="shot-editor#act"{% if storyForm.shots|length == 1 %} disabled{% endif %}>Retirer ce plan</button></div></section>{% endfor %}</div>
<template data-shot-editor-target="prototype"><section class="story-shot" data-shot-editor-row><h2 data-shot-heading></h2>{% set shotForm = storyForm.shots.vars.prototype %}{{ form_row(shotForm.prompt) }}{{ form_row(shotForm.seconds) }}{% include 'ai/_shot_references.html.twig' %}<div class="story-row-actions"><button class="account-secondary" type="submit" name="plan_action" value="up:0" data-action="shot-editor#act">Monter</button><button class="account-secondary" type="submit" name="plan_action" value="down:0" data-action="shot-editor#act">Descendre</button><button class="account-secondary" type="submit" name="plan_action" value="remove:0" data-action="shot-editor#act">Retirer ce plan</button></div></section></template>
<button class="account-secondary" type="submit" name="plan_action" value="add" data-action="shot-editor#act" data-shot-editor-target="add">Ajouter un plan +</button>
<div class="series-actions"><button class="account-secondary" type="submit" name="intent" value="save">Enregistrer les scènes</button><button class="button" type="submit" name="intent" value="estimate">Vérifier l’estimation totale →</button></div>{{ form_end(storyForm) }}
{% endif %}
{% else %}
{% if episode.flowState not in ['running','assembling','paused'] %}<p class="library-note">Les résultats et les scènes restent enregistrés.</p>{% endif %}
<div class="story-shot-list">{% for shot in shots %}<article class="story-shot" id="shot-{{ shot.position }}"><header><h2><span>{{ '%02d'|format(shot.position) }}</span> Plan {{ shot.position }} · {{ shot.seconds }} s prévues</h2><span class="series-status">{{ shot.generation ? constant('App\\Entity\\AiGeneration::LABELS')[shot.generation.status] : 'À générer' }}</span></header><p class="series-prompt">{{ shot.prompt }}</p>
{% if shot.generation and shot.generation.video %}{% include 'ai/_framing_warning.html.twig' with {video:shot.generation.video,requestedRatio:recipe.ratio} %}{% endif %}
{% if shot.generation and shot.generation.issue %}<p class="library-note" role="status">{{ shot.generation.issue }}</p>{% endif %}
{% if shot.generation and shot.generation.video %}<details><summary>Voir ce plan</summary><video class="story-player" controls playsinline preload="none" src="{{ path('app_video_stream',{id:shot.generation.video.id}) }}"></video></details>{% endif %}
{% if episode.flowState in ['ready','paused'] and shot.generation and shot.generation.video %}<a class="account-secondary composer-back" href="{{ path('app_series_episode',{id:episode.id,redo:shot.id}) }}#story-quote">Refaire uniquement ce plan ↗</a>{% endif %}
{% if shot.previousGenerations %}<p class="library-note">{{ shot.previousGenerations|length }} version(s) précédente(s) conservée(s) dans l’historique IA.</p>{% endif %}</article>{% endfor %}</div>
{% if episode.flowState in ['running','assembling'] %}<form method="post" class="story-controls"><input type="hidden" name="_token" value="{{ csrf_token('episode_flow_' ~ episode.id) }}"><button class="account-secondary" type="submit" name="intent" value="pause">Suspendre les étapes suivantes</button><p class="library-note">Une génération déjà transmise peut se terminer et être facturée. La pause n’annule pas les demandes en cours.</p></form>{% elseif episode.flowState == 'paused' %}<form method="post" class="account-form story-controls"><input type="hidden" name="_token" value="{{ csrf_token('episode_flow_' ~ episode.id) }}"><label><input type="checkbox" name="confirm" value="1" required> Je confirme la reprise des étapes restantes au coût déjà accepté. Un résultat incertain sera seulement récupéré si son identifiant est connu.</label><button class="button" type="submit" name="intent" value="resume">Reprendre la vidéo →</button></form>{% endif %}
{% endif %}
{% if episode.flowState in ['running','paused','assembling'] %}<details class="story-controls"><summary>Arrêter cette vidéo et libérer les réservations restantes</summary><form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('episode_flow_' ~ episode.id) }}"><label><input type="checkbox" name="confirm" value="1" required> J’arrête les étapes restantes. Les résultats sont conservés ; les demandes déjà transmises ne sont pas annulées.</label><button class="account-secondary" type="submit" name="intent" value="stop">Arrêter les étapes restantes</button></form></details>{% endif %}
{% if quote %}<section class="story-quote" id="story-quote" aria-labelledby="story-quote-title"><h2 id="story-quote-title">{{ quote.redo ? 'Nouvelle génération d’un plan' : 'Ton estimation avant lancement' }}</h2><p>{{ quote.count }} plan(s) · {{ quote.seconds }} s de génération prévues · {{ model.name }}</p><strong class="story-total">{{ (quote.cents / 100)|number_format(2,',',' ') }} $ US estimés</strong><p class="library-note">Facturés directement par ton fournisseur, hors taxes/conversion éventuelles. Les demandes sont indépendantes : un plan peut réussir même si un autre échoue. Les reprises payantes ne sont pas incluses.</p>{% if quote.redo %}<p>Le prompt exact affiché sera utilisé pour ce plan. Tu peux le corriger ci-dessous avant un nouveau devis. Les autres clips restent conservés et un nouvel assemblage sera créé. Les raccords seront à revérifier ; l’ancienne validation sera retirée.</p>{% else %}<p>Les scènes enregistrées ci-dessus et leur contexte commun seront envoyés au fournisseur. Le résultat sera assemblé automatiquement puis attendra ta validation.</p>{% endif %}
{% include 'ai/_repair_prompt.html.twig' %}<form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('episode_flow_' ~ episode.id) }}"><input type="hidden" name="quote" value="{{ quote.hash }}"><input type="hidden" name="redo" value="{{ quote.redo }}"><input type="hidden" name="intent" value="confirm"><label><input type="checkbox" name="confirm" value="1" required{% if not enabled %} disabled{% endif %}> Je confirme ces scènes et j’accepte ce coût total estimé.</label><button class="button" type="submit"{% if not enabled %} disabled{% endif %}>Confirmer et générer {{ quote.redo ? 'ce plan' : 'la vidéo' }} →</button></form>{% if not enabled %}<p class="library-note">Les générations payantes sont désactivées sur ce poste. Tes plans restent enregistrés.</p>{% endif %}</section>{% endif %}
{% if episode.flowState == 'ready' %}
<section class="story-result"><h2>{{ episode.approvedVideo ? 'Version validée' : 'Ta vidéo attend ta validation' }}</h2>{% set result = episode.approvedVideo ?: (episode.assembly ? episode.assembly.output : null) %}{% if result %}<video class="story-player" controls playsinline preload="metadata" src="{{ path('app_video_stream',{id:result.id}) }}"></video><p>{{ result.title }} · {{ result.duration|number_format(1,',',' ') }} s réelles</p><a class="account-secondary" href="{{ path('app_video_download',{id:result.id}) }}" download>Télécharger la vidéo ↓</a>{% endif %}
{% if episode.assembly %}<a class="account-secondary composer-back" href="{{ path('app_edit_show',{id:episode.assembly.id}) }}">Ouvrir le montage : musique, textes et sous-titres ↗</a>{% endif %}
<form method="post" class="account-form"><input type="hidden" name="_token" value="{{ csrf_token('episode_flow_' ~ episode.id) }}"><input type="hidden" name="revision" value="{{ episode.revision }}"><label for="episode-final-video">Version à valider</label><select id="episode-final-video" name="video" required>{% for video in library %}<option value="{{ video.id }}"{% if result and result.id == video.id %} selected{% endif %}>{{ video.title }} · {{ video.duration|number_format(1,',',' ') }} s</option>{% endfor %}</select><p class="library-note">Après avoir modifié et exporté une copie dans le montage, choisis ici cette nouvelle version de ta bibliothèque.</p><button class="button" type="submit" name="intent" value="approve">Valider cette version →</button></form>
{% if episode.approvedVideo %}<form method="post" action="{{ path('app_episode_publication',{id:episode.id}) }}" class="composer-back"><input type="hidden" name="_token" value="{{ csrf_token('episode_publication_' ~ episode.id) }}"><input type="hidden" name="revision" value="{{ episode.revision }}"><button class="button" type="submit">Préparer et programmer la publication →</button></form><p class="library-note">Le parcours habituel te laissera choisir les réseaux, les textes et la date avant confirmation.</p>{% endif %}</section>
{% endif %}
{% include 'series/_publications.html.twig' with {summaries:publicationSummaries|default([])} %}
{% endblock %}
