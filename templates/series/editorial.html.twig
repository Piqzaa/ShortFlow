{% extends 'studio/base.html.twig' %}
{% block title %}Textes de la série — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_series_show',{id:series.id}) }}">← {{ series.name }}</a>
<div class="workspace-heading"><div><span class="eyebrow">LE STYLE DES TEXTES</span><h1>Des textes qui te ressemblent.</h1><p>Ces indications facultatives guident les propositions de titres, descriptions et légendes. Elles ne règlent pas la voix audio des vidéos.</p></div></div>
{{ form_start(form,{attr:{class:'account-form series-config','data-controller':'unsaved','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}{{ form_errors(form) }}{{ form_row(form.language) }}{{ form_row(form.tone) }}
<details class="creation-details"{% if (form.vars.submitted and not form.vars.valid) or not form.audience.vars.valid or not form.keywords.vars.valid or not form.brand.vars.valid or not form.cta.vars.valid or not form.allowedHashtags.vars.valid or not form.excludedHashtags.vars.valid %} open{% endif %}><summary>Consignes avancées et règles de hashtags</summary>{{ form_row(form.audience) }}{{ form_row(form.keywords) }}{{ form_row(form.brand) }}{{ form_row(form.cta) }}{{ form_row(form.allowedHashtags) }}{{ form_row(form.excludedHashtags) }}</details>
<p class="library-note">Sépare les hashtags par des espaces ou des virgules, dix maximum par liste. Une liste autorisée non vide limite les propositions à ces hashtags. Le rédacteur ne regarde pas la vidéo et ne choisit ni visibilité, ni audience réglementaire, ni déclarations.</p>
<button class="button" type="submit">Enregistrer le style des textes</button>{{ form_end(form) }}
{% endblock %}
