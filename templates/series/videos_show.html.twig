{% extends 'studio/base.html.twig' %}
{% block title %}{{ series.name }} — Mes séries{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_series') }}">← Mes séries</a>
<div class="workspace-heading"><div><span class="eyebrow">AVEC TES VIDÉOS</span><h1>{{ series.name }}</h1><p>{{ episodes|length }} épisode{{ episodes|length > 1 ? 's' : '' }} · Dans l’ordre de ta série.</p></div><a class="button" href="{{ path('app_video_series_edit',{id:series.id}) }}">Ajouter ou organiser les épisodes</a></div>
{% include 'series/_destinations_summary.html.twig' with {seriesConfigurationRoute:'app_video_series_edit'} %}
<p><a class="account-secondary" href="{{ path('app_video_series_editorial',{id:series.id}) }}">Style des textes ↗</a></p>
<div class="series-episodes" data-controller="video-thumbnails">{% for episode in episodes %}{% set summaries = publicationSummaries[episode.id]|default([]) %}{% set currentPublication = (summaries|filter(item => item.current))|first|default(null) %}<section class="series-episode series-video-episode" id="video-episode-{{ episode.id }}">{% include 'ai/_cover.html.twig' with {videoId:episode.video.id} %}<div><span class="eyebrow">ÉPISODE {{ loop.index }}</span><h2>{{ episode.video.title }}</h2><p class="library-note">{{ episode.video.duration|number_format(1,',') }} s · {{ currentPublication ? currentPublication.label : 'Publication à préparer' }}</p><div class="series-actions">{% include 'series/_publication_action.html.twig' with {publicationRoute:'app_video_episode_publication',publicationEpisodeId:episode.id,publicationToken:'video_episode_publication_' ~ episode.id,publicationRevision:series.revision,publicationVideo:null} %}<a class="account-secondary" href="{{ path('app_video_show',{id:episode.video.id}) }}">Voir la vidéo ↗</a></div>{% include 'series/_publications.html.twig' %}</div></section>{% else %}<p class="library-note">Aucun épisode disponible. Ajoute des vidéos pour continuer ta série.</p>{% endfor %}</div>
{% endblock %}
