{% set complete = shots|filter(shot => shot.generation and shot.generation.status == 'available' and shot.generation.video and shot.generation.video.matchesRatio(recipe.ratio))|length %}
<section class="episode-progress story-watch" aria-labelledby="episode-progress-title"{% if episode.flowState in ['running','assembling'] %} data-controller="episode-watch" data-episode-watch-url-value="{{ path('app_series_episode_state',{id:episode.id}) }}" data-episode-watch-revision-value="{{ watchRevision }}" aria-busy="true"{% endif %}>
  <div class="episode-progress-heading"><span class="episode-progress-icon" aria-hidden="true">{% if episode.flowState in ['running','assembling'] %}<span class="story-spinner"></span>{% else %}Ⅱ{% endif %}</span><div><span class="eyebrow">SUIVI DE TA VIDÉO</span><h2 id="episode-progress-title">{{ episode.flowState == 'assembling' ? 'Assemblage en cours…' : (episode.flowState == 'paused' ? 'Étapes suivantes en pause' : 'Génération en cours…') }}</h2></div><strong>{{ complete }} / {{ shots|length }} <small>plans prêts</small></strong></div>
  <progress max="{{ shots|length ?: 1 }}" value="{{ complete }}" aria-label="Plans vidéo prêts"></progress>
  <ol class="episode-progress-plans">{% for shot in shots %}{% set job = shot.generation %}{% set ready = job and job.status == 'available' and job.video and job.video.matchesRatio(recipe.ratio) %}{% set active = job and job.status in ['queued','submitting','processing'] %}<li class="{{ ready ? 'is-complete' : (active ? 'is-active' : '') }}"><span aria-hidden="true">{{ ready ? '✓' : '%02d'|format(shot.position) }}</span><div><strong>Scène {{ shot.position }}</strong><small>{% if job and job.video and not job.video.matchesRatio(recipe.ratio) %}Format à vérifier{% elseif ready %}Prête{% elseif job and job.status == 'processing' %}{{ {queued:'En file chez le fournisseur',running:'Création de la vidéo',importing:'Récupération de la vidéo'}[job.providerStage|default('')]|default('Génération chez le fournisseur') }}{% elseif job %}{{ {queued:'En attente de départ',submitting:'Envoi au fournisseur',prepared:'À confirmer',waiting_key:'Connexion à vérifier',review:'À vérifier',available:'Vidéo retirée'}[job.status]|default('À vérifier') }}{% else %}{{ episode.flowState == 'paused' ? 'En pause' : 'À venir' }}{% endif %}</small></div></li>{% endfor %}</ol>
  <p class="library-note" role="status" aria-live="polite" data-episode-watch-target="message">{{ episode.flowState == 'assembling' ? 'Les clips sont prêts. VydFlow prépare la vidéo finale ; elle attendra ta validation.' : (episode.flowState == 'paused' ? 'Les résultats restent enregistrés. Une demande déjà transmise peut encore se terminer.' : 'Demande prise en compte. Les scènes sont générées dans l’ordre, puis assemblées. Tu peux quitter cette page et revenir.') }}</p>
  <div class="episode-progress-footer"><span>Suivi des étapes réelles · aucune publication automatique</span><a class="account-secondary" href="{{ path('app_series_episode',{id:episode.id}) }}">Actualiser le suivi ↻</a></div>
</section>
