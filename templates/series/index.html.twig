{% extends 'studio/base.html.twig' %}
{% block title %}Mes séries — VydFlow{% endblock %}
{% block studio_content %}
<div class="workspace-heading"><div><span class="eyebrow">PRODUCTION RÉCURRENTE</span><h1>Mes séries</h1><p>Un univers commun, des épisodes préparés à ton rythme.</p></div><a class="button" href="{{ path('app_series_new') }}">Créer une série +</a></div>
<p class="library-note">Cet espace prépare des séries générées par IA. Pour tes vidéos déjà créées, <a href="{{ path('app_library') }}">importe-les dans la bibliothèque</a>, prépare leurs publications puis choisis leurs dates dans le calendrier.</p>
{% if seriesList is empty %}
<section class="series-empty"><span class="series-mark" aria-hidden="true">↻</span><h2>Pose le décor une seule fois.</h2><p>Garde ton thème, tes personnages et tes réglages IA. Choisis le nombre d’épisodes puis prépare leurs prompts au même endroit.</p><a class="button" href="{{ path('app_series_new') }}">Configurer ma première série →</a><small>Préparation gratuite. Chaque génération demande ta confirmation du coût fournisseur.</small></section>
{% else %}
<div class="series-list" data-controller="video-thumbnails">{% for series in seriesList %}<a class="series-item" href="{{ path('app_series_show',{id:series.id}) }}">{% include 'ai/_cover.html.twig' with {videoId:covers[series.id]|default(null)} %}<div><h2>{{ series.name }}</h2><p>{{ series.theme|slice(0,160) ~ (series.theme|length > 160 ? '…' : '') }}</p><small>{{ models[series.recipe.model].name }} · {{ series.recipe.totalSeconds|default(30) }} s par épisode · {{ series.recipe.ratio }}</small></div><span aria-hidden="true">→</span></a>{% endfor %}</div>
{% if pages > 1 %}<nav class="series-actions" aria-label="Pagination des séries">{% if page > 1 %}<a class="account-secondary" href="{{ path('app_series',{page:page-1}) }}">← Précédent</a>{% endif %}<span>{{ page }} / {{ pages }}</span>{% if page < pages %}<a class="account-secondary" href="{{ path('app_series',{page:page+1}) }}">Suivant →</a>{% endif %}</nav>{% endif %}
{% endif %}
{% endblock %}
