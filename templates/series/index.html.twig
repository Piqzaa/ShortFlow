{% extends 'studio/base.html.twig' %}
{% block title %}Mes séries — VydFlow{% endblock %}
{% block studio_content %}
<div class="workspace-heading"><div><span class="eyebrow">TES ÉPISODES, AU MÊME ENDROIT</span><h1>Mes séries</h1><p>Avec tes vidéos ou avec l’IA, prépare tes épisodes à ton rythme.</p></div><a class="button" href="{{ path('app_series_choose') }}">Créer une série +</a></div>
{% if entries is empty %}
<section class="series-empty"><span class="series-mark" aria-hidden="true">↻</span><h2>Donne une suite à tes vidéos.</h2><p>Organise tes vidéos en épisodes ou prépare une série avec l’IA.</p><a class="button" href="{{ path('app_series_choose') }}">Créer ma première série →</a></section>
{% else %}
<div class="series-list" data-controller="video-thumbnails">{% for entry in entries %}{% set series = entry.series %}<a class="series-item" href="{{ path(entry.kind == 'ai' ? 'app_series_show' : 'app_video_series_show',{id:series.id}) }}">{% include 'ai/_cover.html.twig' with {videoId:entry.videoId} %}<div><h2>{{ series.name }}</h2>{% if entry.kind == 'ai' %}<p>{{ series.theme|slice(0,160) ~ (series.theme|length > 160 ? '…' : '') }}</p><small>Avec l’IA · {{ models[series.recipe.model].name }} · {{ series.recipe.totalSeconds|default(30) }} s par épisode · {{ series.recipe.ratio }}</small>{% else %}<small>Avec mes vidéos · {{ entry.episodes }} épisode{{ entry.episodes > 1 ? 's' : '' }}</small>{% endif %}</div><span aria-hidden="true">→</span></a>{% endfor %}</div>
{% if pages > 1 %}<nav class="series-actions" aria-label="Pagination des séries">{% if page > 1 %}<a class="account-secondary" href="{{ path('app_series',{page:page-1}) }}">← Précédent</a>{% endif %}<span>{{ page }} / {{ pages }}</span>{% if page < pages %}<a class="account-secondary" href="{{ path('app_series',{page:page+1}) }}">Suivant →</a>{% endif %}</nav>{% endif %}
{% endif %}
{% endblock %}
