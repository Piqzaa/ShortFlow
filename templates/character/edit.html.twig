{% extends 'studio/base.html.twig' %}
{% block title %}{{ character ? 'Modifier le personnage' : 'Ajouter un personnage' }} — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_characters',{archives:character and character.archived ? 1 : 0}) }}">← Mes personnages</a>
<div class="workspace-heading"><div><span class="eyebrow">SON APPARENCE, TES RÉFÉRENCES</span><h1>{{ character ? character.name : 'Nouveau personnage.' }}</h1></div></div>
{% if character %}<div class="character-images"><img src="{{ path('app_character_image',{id:character.id,slot:'portrait'}) }}" alt="Portrait de {{ character.name }}" width="240" height="240">{% for view in character.views %}<img src="{{ path('app_character_image',{id:character.id,slot:loop.index0}) }}" alt="Vue {{ loop.index }} de {{ character.name }}" width="160" height="160">{% endfor %}</div>{% endif %}
{% if character and character.archived %}<section class="account-panel"><h2>Personnage archivé</h2><p>{{ character.description }}</p><p>Restaure-le depuis la liste des archives pour le modifier.</p></section>{% else %}
{{ form_start(characterForm,{attr:{class:'account-form character-form'}}) }}{{ form_errors(characterForm) }}{% if quick|default(false) %}<p class="library-note">Un nom et un portrait suffisent. Reviens ensuite à l’onglet de préparation pour le sélectionner.</p>{% endif %}{{ form_row(characterForm.name) }}{% include 'character/_image_field.html.twig' with {field:characterForm.portrait} only %}{% if quick|default(false) %}<details class="creation-details"><summary>Description et vues supplémentaires · facultatif</summary>{% endif %}{{ form_row(characterForm.description) }}{% include 'character/_image_field.html.twig' with {field:characterForm.views} only %}{% if character and character.views|length %}<div class="character-toggle">{{ form_widget(characterForm.clearViews) }}{{ form_label(characterForm.clearViews) }}</div>{% else %}{{ form_widget(characterForm.clearViews,{attr:{hidden:true}}) }}{% endif %}{% if quick|default(false) %}</details>{% endif %}{{ form_widget(characterForm.revision) }}<button type="submit" class="button">Enregistrer le personnage</button>{{ form_end(characterForm) }}
<p class="library-note">Les images remplacées restent conservées pour les anciennes préparations. Aucun appel IA lors de cet enregistrement.</p>
{% endif %}
{% endblock %}
