{% extends 'studio/base.html.twig' %}
{% block title %}Mes personnages — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary composer-back" href="{{ path('app_studio') }}">← Studio</a>
<div class="workspace-heading"><div><span class="eyebrow">TA BIBLIOTHÈQUE PRIVÉE</span><h1>Mes personnages.</h1><p>Garde leurs portraits et leur apparence au même endroit.</p></div><a class="button" href="{{ path('app_character_new') }}">Ajouter un personnage</a></div>
<nav class="series-actions" aria-label="État des personnages"><a class="account-secondary" href="{{ path('app_characters') }}"{% if not archived %} aria-current="page"{% endif %}>Actifs</a><a class="account-secondary" href="{{ path('app_characters',{archives:1}) }}"{% if archived %} aria-current="page"{% endif %}>Archivés</a></nav>
<p class="library-note">Ces fiches sont privées. Choisis-les dans le Studio ou une série, puis indique leur présence dans chaque scène. Aucun import ne lance de génération.</p>
<div class="character-grid">
{% for character in characters %}
<article class="account-panel character-card"><a href="{{ path('app_character_edit',{id:character.id}) }}"><img src="{{ path('app_character_image',{id:character.id,slot:'portrait'}) }}" alt="Portrait de {{ character.name }}" width="360" height="360" loading="lazy"><h2>{{ character.name }}</h2></a><p>{{ character.description }}</p><a class="account-secondary" href="{{ path('app_character_edit',{id:character.id}) }}">{{ archived ? 'Consulter' : 'Modifier' }}</a><form method="post" action="{{ path('app_character_archive',{id:character.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('character_archive_' ~ character.id) }}"><input type="hidden" name="revision" value="{{ character.revision }}"><input type="hidden" name="archive" value="{{ archived ? 0 : 1 }}"><button class="account-secondary" type="submit">{{ archived ? 'Restaurer' : 'Archiver' }}</button></form></article>
{% else %}<section class="account-panel"><h2>{{ archived ? 'Aucun personnage archivé.' : 'Ton premier personnage.' }}</h2><p>{{ archived ? 'Les personnages archivés restent disponibles pour leurs anciennes préparations.' : 'Ajoute un portrait et quelques mots pour retrouver son apparence.' }}</p></section>{% endfor %}
</div>
{% if pages > 1 %}<nav class="series-actions" aria-label="Pages des personnages">{% if page > 1 %}<a href="{{ path('app_characters',{page:page-1,archives:archived ? 1 : 0}) }}">← Précédente</a>{% endif %}<span>Page {{ page }} sur {{ pages }}</span>{% if page < pages %}<a href="{{ path('app_characters',{page:page+1,archives:archived ? 1 : 0}) }}">Suivante →</a>{% endif %}</nav>{% endif %}
{% endblock %}
