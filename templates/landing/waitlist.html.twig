{% extends 'base.html.twig' %}
{% block title %}Gardons le contact — VydFlow{% endblock %}
{% block body %}
<header class="account-header"><a class="wordmark" href="{{ path('app_home') }}">vydflow /</a><a href="{{ path('app_register') }}">Créer mon compte ↗</a></header><main id="contenu"><section class="join section" id="rejoindre" aria-labelledby="join-title"><div class="wrap join-inner"><span class="eyebrow">GARDONS LE CONTACT</span><h1 id="join-title">La suite de VydFlow.</h1><p>La bêta permet déjà de créer ton compte.<br>Tu peux aussi laisser ton email pour suivre la suite.</p>{% for message in app.flashes('success') %}<div class="notice success" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="notice" role="alert">{{ message }}</div>{% endfor %}{{ form_start(waitlist, {attr: {class: 'waitlist-form'}}) }}{{ form_errors(waitlist) }}<div class="email-field">{{ form_label(waitlist.email) }}<div class="input-row">{{ form_widget(waitlist.email) }}<button class="button" type="submit">Rejoindre la liste <span aria-hidden="true">↗</span></button></div>{{ form_errors(waitlist.email) }}</div><div class="honeypot" aria-hidden="true">{{ form_row(waitlist.website) }}</div>{{ form_end(waitlist) }}<small>Aucun email automatique de suivi dans cette version.<br><a href="{{ path('app_privacy') }}">Utilisation de tes données</a></small></div></section></main>
<footer class="wrap footer">{% include 'legal/_links.html.twig' with {compact:true} %}</footer>
{% endblock %}
