{% extends 'base.html.twig' %}
{% block body %}
<header class="nav wrap">
  <a href="/" class="wordmark" aria-label="VydFlow, accueil"><span class="brand-symbol" aria-hidden="true">∨</span>vydflow<span class="brand-dot">/</span></a>
  <nav aria-label="Navigation principale"><a href="#studio">L’expérience</a><a href="#organisation">Le studio</a><a href="#vision">La vision</a></nav>
  <a class="button small" href="#rejoindre">Rejoindre l’aventure <span aria-hidden="true">↗</span></a>
</header>
<main id="contenu">
<div class="story" data-controller="studio" data-video-src="/media/films/hero-v4.webm">
  <div class="world" data-studio-target="stage" aria-hidden="true">
    <div class="world-grid"></div><div class="world-orbit orbit-one"></div><div class="world-orbit orbit-two"></div>
    <div class="world-type">CREATE<br>IN FLOW.</div>
    <div class="fallback-phone" data-studio-target="fallback"><div class="phone-screen"><img src="/media/screens/screen-0.webp" alt="" width="540" height="960"><video class="preview-video hero-native" data-mobile-only data-preview-src="/media/films/hero-v4.webm" muted loop playsinline preload="none" aria-hidden="true"></video><span class="island"></span></div></div>
    <canvas data-studio-target="canvas"></canvas><span class="capture-caption" data-studio-target="framing">TON IDÉE, PLEIN CADRE · 9:16</span>
  </div>
  <button class="motion-toggle" data-studio-target="toggle" data-action="studio#toggleMotion" aria-pressed="false" hidden>Mettre les animations en pause</button>
  <section class="scene hero" data-scene="hero" aria-labelledby="hero-title">
    <div class="hero-top wrap"><span class="eyebrow"><i></i> LE FUTUR STUDIO DES CRÉATEURS</span><span class="edition">IMPORTE · PRÉPARE · PUBLIE</span></div>
    <div class="hero-heading"><p class="micro-label">UN SEUL STUDIO POUR TES VIDÉOS COURTES.</p><h1 id="hero-title">Tes vidéos.<br><span>Trois réseaux.</span></h1></div>
    <div class="hero-mobile-cta"><p>Importe et prépare tes vidéos pour TikTok,<br>Instagram Reels et YouTube Shorts.</p><a class="button" href="#rejoindre">Rejoindre l’aventure <span aria-hidden="true">↗</span></a><a class="mobile-explore" href="#studio">Explorer le studio ↓</a></div>
    <div class="hero-bottom wrap"><div><p>Importe tes vidéos, prépare tes publications<br>et choisis tes réseaux depuis un seul studio.</p><a class="text-link" href="#studio">Explorer l’expérience <span aria-hidden="true">↘</span></a></div><div class="hero-note"><span class="cross" aria-hidden="true">✳</span><p>TikTok · Instagram Reels<br>YouTube Shorts</p></div></div>
  </section>
  <section class="scene transformation wrap" id="studio" data-scene="transform" aria-labelledby="transform-title">
    <div class="scene-copy"><p class="section-label">01 / L’IMPULSION</p><h2 id="transform-title">Tout commence<br>par <em>ton idée.</em></h2><p>Tu crées ta vidéo. VydFlow prépare la suite.<br>Importe-la dans ta bibliothèque privée.</p><div class="technical-label"><span class="record-dot"></span> FORMAT VERTICAL <span>9:16</span></div></div>
    <div class="mobile-edit-showcase"><div class="edit-reel"><div class="mobile-editor-phone"><img src="/media/screens/screen-1.webp" alt="Illustration du montage d’un oiseau en papier irisé en quatre plans" width="540" height="960" loading="lazy"><canvas class="edit-canvas" data-studio-target="edit" width="540" height="960" aria-hidden="true"></canvas><span class="island"></span></div><div class="edit-annotation">01 / CADRE TON HISTOIRE<small data-studio-target="editLabel">PLAN 01 · PRÉPARATION · 00:00</small></div><div class="edit-scrub" aria-hidden="true">{% for frame in 0..3 %}<i data-edit-frame="{{ frame }}"{% if frame == 0 %} class="is-current"{% endif %}><img src="/media/edit/edit-{{ frame }}-thumb.webp" alt="" width="135" height="240" loading="lazy"></i>{% endfor %}<b></b></div></div></div>
    <div class="capture-fallback"><img src="/media/screens/screen-1.webp" alt="Aperçu du montage au format vertical" width="540" height="960" loading="lazy"></div>
  </section>
  <section class="scene distribution wrap" data-scene="distribute" aria-labelledby="distribution-title">
    <div class="scene-copy"><p class="section-label">02 / LA RÉSONANCE</p><h2 id="distribution-title">Un seul élan.<br><em>Trois horizons.</em></h2><p>Une vidéo, un, deux ou trois réseaux.<br>Choisis tes destinations et adapte ton message.</p></div>
    <div class="destinations" aria-label="Trois versions illustratives de contenus pour TikTok, Reels et Shorts">
      {% for network in [
        {name: 'TikTok', icon: '♪', tag: '01 / LE RYTHME', class: 'tiktok', media: 'dance', title: 'Trouve ton rythme.', description: 'Prépare ta légende et choisis TikTok comme destination.'},
        {name: 'Instagram Reels', icon: '◎', tag: '02 / LA SIGNATURE', class: 'reels', media: 'object', title: 'Le détail change tout.', description: 'Adapte ton message pour Instagram et ajoute Reels à ta sélection.'},
        {name: 'YouTube Shorts', icon: '▷', tag: '03 / LA PERSPECTIVE', class: 'shorts', media: 'architecture', title: 'Ouvre le cadre.', description: 'Prépare ton titre et ajoute YouTube Shorts à ta sélection.'}
      ] %}
      <article class="destination {{ network.class }}">
        <div class="destination-top"><span aria-hidden="true">{{ network.icon }}</span><span>{{ network.name }} / 9:16</span></div>
        <div class="media-window"><img src="/media/creators/{{ network.media }}.webp" alt="{{ network.title }} — création visuelle originale" width="720" height="1280" loading="lazy"><video class="preview-video" data-preview-src="/media/films/{{ network.class }}.webm" muted loop playsinline preload="none" aria-hidden="true"></video><span class="media-play" aria-hidden="true">↗</span></div>
        <div class="destination-title"><small>{{ network.tag }}</small><h3>{{ network.name }}</h3><p>{{ network.description }}</p><span class="destination-duration">FILM DE DÉMONSTRATION · 00:05</span></div>
      </article>
      {% endfor %}
    </div>
    <p class="scene-disclaimer">Objectif V1 : publication immédiate sur les réseaux sélectionnés, sous réserve des autorisations des plateformes. Produit en développement ; aucune publication disponible actuellement.</p>
  </section>
  <section class="scene organization wrap" id="organisation" data-scene="organize" aria-labelledby="organization-title">
    <div class="scene-copy"><p class="section-label">03 / LE STUDIO</p><h2 id="organization-title">Tes idées en liberté.<br><em>Tout le reste, en place.</em></h2><p>Connecte-toi à ton espace, retrouve tes vidéos<br>et suis le résultat de chaque publication.</p></div>
    <ol class="product-steps" aria-label="Le parcours prévu dans VydFlow">
      <li><span>01</span><div><strong>Importe</strong><p>Retrouve tes vidéos dans ta bibliothèque privée.</p></div></li>
      <li><span>02</span><div><strong>Prépare</strong><p>Adapte tes textes et sélectionne jusqu’à trois réseaux.</p></div></li>
      <li><span>03</span><div><strong>Publie</strong><p>Lance l’envoi et suis le résultat pour chaque plateforme.</p></div></li>
    </ol>
    <div class="studio-preview" aria-label="Illustration du futur studio : bibliothèque et calendrier non disponibles">
      <aside><span class="wordmark">vydflow /</span><span class="preview-active">▦ &nbsp; Bibliothèque</span><span>▤ &nbsp; Brouillons</span><span>▦ &nbsp; Calendrier</span><small>TON ESPACE CRÉATIF</small></aside>
      <div class="preview-content"><div class="preview-title"><span>La suite s’écrit ici.</span><span class="pill">Aperçu du futur produit</span></div>
      <div class="preview-workspace"><div class="library-panel"><div class="panel-heading"><span>Ta bibliothèque</span><small>06 / CRÉATIONS</small></div><div class="library-grid">
      {% for video in [{media:'craft', title:'Le geste', state:'Brouillon'}, {media:'surf', title:'À l’aube', state:'À préparer'}, {media:'street', title:'Après la pluie', state:'Brouillon'}, {media:'sound', title:'Le son', state:'À préparer'}, {media:'taste', title:'À table', state:'Brouillon'}, {media:'botanic', title:'Respire', state:'À préparer'}] %}
        <div class="library-video"><div><img src="/media/creators/{{ video.media }}-thumb.webp" alt="{{ video.title }}, visuel de démonstration" width="270" height="480" loading="lazy"><span>↗</span></div><strong>{{ video.title }}</strong><small>{{ video.state }}</small></div>
      {% endfor %}
      </div></div>
      <div class="preview-calendar"><div class="panel-heading"><span>Ta prochaine semaine</span><small>APERÇU</small></div><div class="week"><b>L</b><b>M</b><b>M</b><b>J</b><b>V</b><b>S</b><b>D</b></div><div class="calendar-date">MARDI <strong>14</strong></div><div class="calendar-block"><img src="/media/creators/craft-thumb.webp" alt="" width="270" height="480" loading="lazy"><div>Le geste<small>Reel · 18:00 · À préparer</small></div></div><div class="calendar-block muted"><img src="/media/creators/sound-thumb.webp" alt="" width="270" height="480" loading="lazy"><div>Le son<small>Short · Jeudi / 12:00</small></div></div><div class="calendar-empty">+ La prochaine idée</div><p class="calendar-note">Ton rythme, en un regard.</p></div>
      </div><div class="preview-bottom"><span>6 créations de démonstration</span><span>IMPORTER → PRÉPARER → PUBLIER</span></div></div>
    </div><p class="scene-disclaimer">Aperçu illustratif du futur studio. Bibliothèque et brouillons prévus pour la V1 ; calendrier et programmation prévus ensuite.</p>
  </section>
  <section class="scene vision wrap" id="vision" data-scene="vision" aria-labelledby="vision-title">
    <div class="scene-copy"><p class="section-label">04 / L’HORIZON CRÉATIF</p><span class="pill">Bientôt disponible</span><h2 id="vision-title">De l’imagination<br><em>au mouvement.</em></h2><p>Et si une phrase devenait le début d’une vidéo&nbsp;?<br>Le studio IA fait partie de notre vision.</p><p class="honest-note">Concept exploratoire. Aucune génération IA disponible actuellement.</p></div>
    <div class="ai-composition" aria-label="Concept illustratif : instruction, génération, timeline et vidéo finale">
      <div class="prompt-card"><span>01 / TON INSTRUCTION <b>✳</b></span><p>« Une raie de verre dans un océan de nuit.<br>Des reflets irisés. Un mouvement fluide. »</p><small>CONCEPT · TEXTE VERS VIDÉO</small></div>
      <div class="generation-line"><span>02 / EXPLORATION</span><i></i><span>↘</span></div>
      <div class="horizon-runway"><div class="horizon-reel"><div class="ai-output"><img src="/media/horizon/horizon-0.webp" alt="Raie de verre irisée dans un océan de nuit, illustration conceptuelle du futur studio IA" width="540" height="960" loading="lazy"><canvas class="horizon-canvas" data-studio-target="horizon" width="540" height="960" aria-hidden="true"></canvas><span>FLOW STUDY / <small data-studio-target="timecode">00:00</small><br><b>Une idée prend forme.</b></span></div>
      <div class="timeline-preview"><div><span>03 / MONTAGE</span><span>00:00 — 00:06</span></div><div class="timeline-track">{% for frame in 0..5 %}<i><img src="/media/horizon/horizon-{{ frame }}-thumb.webp" alt="" width="135" height="240" loading="lazy"></i>{% endfor %}<b></b></div><small>FAIS DÉFILER POUR EXPLORER LES 6 PLANS ↓</small></div></div></div>
    </div>
  </section>
  <section class="scene finale wrap" data-scene="finale" aria-labelledby="finale-title"><div class="finale-mobile-device"><img src="/media/screens/screen-5.webp" alt="Ton prochain mouvement commence ici, au-dessus d’un paysage de rivière" width="540" height="960" loading="lazy"></div><p class="section-label">LA SUITE, ON L’ÉCRIT ENSEMBLE.</p><h2 id="finale-title">Fais de la place<br><em>à tes idées.</em></h2><a class="button" href="#rejoindre">Entrer dans l’aventure <span aria-hidden="true">↗</span></a><span class="finale-signature" aria-hidden="true">VYDFLOW /</span></section>
</div>
<section class="join section" id="rejoindre" aria-labelledby="join-title"><div class="wrap join-inner"><span class="eyebrow"><i></i> EN DÉVELOPPEMENT · ACCÈS À VENIR</span><h2 id="join-title">Ton prochain flow<br><em>commence ici.</em></h2><p>VydFlow prend forme. Rejoins la liste d’attente<br>pour découvrir le studio à son ouverture.</p>{% for message in app.flashes('success') %}<div class="notice success" role="status">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="notice" role="alert">{{ message }}</div>{% endfor %}{{ form_start(waitlist, {attr: {class: 'waitlist-form'}, action: path('app_home') ~ '#rejoindre'}) }}{{ form_errors(waitlist) }}<div class="email-field">{{ form_label(waitlist.email) }}<div class="input-row">{{ form_widget(waitlist.email) }}<button class="button" type="submit">Rejoindre la liste <span aria-hidden="true">↗</span></button></div>{{ form_errors(waitlist.email) }}</div><div class="honeypot" aria-hidden="true">{{ form_row(waitlist.website) }}</div>{{ form_end(waitlist) }}<small>Gratuit. Sans carte bancaire. Un email pour l’ouverture, rien de plus.<br>Ton email reste privé. <a href="{{ path('app_privacy') }}">Utilisation de tes données</a></small></div></section>
</main>
<footer class="wrap footer"><a href="/" class="wordmark">vydflow /</a><span>IMPORTE. PRÉPARE. PUBLIE.</span><a href="{{ path('app_privacy') }}">Confidentialité</a><small>© {{ 'now'|date('Y') }} VydFlow</small></footer>
{% endblock %}
