{% set platforms = publishedPlatforms[video.id]|default([]) %}
{% if platforms %}
<div class="video-published"><span>Déjà publiée</span>{% if 'youtube' in platforms %}<svg class="video-published-icon" viewBox="0 0 24 18" role="img" aria-label="YouTube"><title>YouTube</title><rect width="24" height="18" rx="5" fill="#ff0033"/><path d="m10 5 7 4-7 4Z" fill="#fff"/></svg>{% endif %}{% if 'instagram' in platforms %}<svg class="video-published-icon" viewBox="0 0 24 24" role="img" aria-label="Instagram" fill="none" stroke="#e879f9" stroke-width="1.8"><title>Instagram</title><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="#e879f9"/></svg>{% endif %}{% if 'tiktok' in platforms %}<svg class="video-published-icon" viewBox="0 0 24 24" role="img" aria-label="TikTok" fill="none" stroke="#67e8f9" stroke-width="2"><title>TikTok</title><path d="M14 3v13a4 4 0 1 1-4-4M14 3c0 4 3 6 6 6"/></svg>{% endif %}</div>
{% endif %}
