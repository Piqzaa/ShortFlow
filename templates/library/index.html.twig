{% extends 'studio/base.html.twig' %}
{% block title %}Ma bibliothèque — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading library-heading"><div><span class="eyebrow">TES CRÉATIONS, AU MÊME ENDROIT</span><h1>Ta bibliothèque.</h1><p>Retrouve tes vidéos. Garde le prochain mouvement à portée de main.</p></div><a class="button small" href="{{ path('app_video_upload') }}">Importer une vidéo <span aria-hidden="true">+</span></a></div>
<div class="library-toolbar"><span>{{ usage.count }} vidéo{{ usage.count > 1 ? 's' : '' }}</span><div class="storage-meter"><label for="storage-usage">{{ (usage.bytes / 1048576)|number_format(1, ',', ' ') }} Mo sur 1 Go</label><meter id="storage-usage" min="0" max="1073741824" value="{{ usage.bytes }}">{{ usage.bytes }} octets</meter></div></div>
{% if videos %}<form id="library-selection" tabindex="-1" action="{{ path('app_publication_prepare') }}" method="get" data-controller="selection"><div class="selection-bar"><div><label><input type="checkbox" data-selection-target="all" data-action="selection#toggleAll"> Tout sélectionner sur cette page</label><span data-selection-target="count">Choisis tes vidéos</span></div><button class="button small" type="submit" data-selection-target="submit">Préparer la publication ↗</button></div>{% include 'library/_cards.html.twig' with {selectable: true} %}</form>{% else %}<section class="studio-empty library-empty"><div class="studio-empty-art" aria-hidden="true"><span>+</span></div><h2>Ton prochain flow commence ici.</h2><p>Importe ta première vidéo.<br>Elle restera accessible uniquement dans ton compte.</p><a class="button" href="{{ path('app_video_upload') }}">Importer ma première vidéo <span aria-hidden="true">↗</span></a><small>MP4 ou WebM · 100 Mo maximum · jusqu’à 3 minutes</small></section>{% endif %}
{% if pages > 1 %}<nav class="library-pagination" aria-label="Pages de la bibliothèque">{% if page > 1 %}<a href="{{ path('app_library', {page: page - 1}) }}">← Précédente</a>{% endif %}<span>Page {{ page }} sur {{ pages }}</span>{% if page < pages %}<a href="{{ path('app_library', {page: page + 1}) }}">Suivante →</a>{% endif %}</nav>{% endif %}
{% endblock %}
