{% extends 'studio/base.html.twig' %}
{% block title %}{{ video.title }} — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary" href="{{ path('app_library') }}">← Revenir à la bibliothèque</a>
<div class="studio-heading"><div><span class="eyebrow">TA CRÉATION</span><h1 class="video-detail-title">{{ video.title }}</h1><p>Importée le {{ video.createdAt|date('d/m/Y à H:i') }}</p></div><span class="studio-status">Vidéo privée</span></div>
<div class="video-detail-layout"><section class="video-player-panel" aria-label="Prévisualisation"><video class="video-player" controls playsinline preload="metadata" src="{{ path('app_video_stream', {id: video.id}) }}" aria-label="Lire {{ video.title }}"></video><p>Si ton navigateur ne peut pas lire ce codec, essaie un export MP4 H.264 8 bits.</p></section><section class="video-details" aria-labelledby="details-title"><h2 id="details-title">Les détails du flow</h2><dl><div><dt>Durée</dt><dd>{{ video.duration|number_format(1, ',', ' ') }} s</dd></div><div><dt>Dimensions</dt><dd>{{ video.width }} × {{ video.height }}</dd></div><div><dt>Poids</dt><dd>{{ (video.byteSize / 1048576)|number_format(1, ',', ' ') }} Mo</dd></div><div><dt>Format</dt><dd>{{ video.mimeType == 'video/mp4' ? 'MP4' : 'WebM' }} · {{ video.codec|upper }}</dd></div></dl>
{% include 'library/_published.html.twig' %}
{{ form_start(form, {attr: {class: 'account-form'}}) }}{{ form_errors(form) }}{{ form_row(form.title) }}<button class="button" type="submit">Enregistrer le nom <span aria-hidden="true">↗</span></button>{{ form_end(form) }}
<p><a class="button small" href="{{ path('app_publication_prepare', {videos: [video.id]}) }}">Préparer la publication ↗</a></p><a class="video-delete-link" href="{{ path('app_video_delete', {id: video.id}) }}">Supprimer cette vidéo</a></section></div>
{% endblock %}
