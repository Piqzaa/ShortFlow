{% set privacyNames = {private:'Privée', unlisted:'Non répertoriée', public:'Publique', SELF_ONLY:'Moi uniquement', PUBLIC_TO_EVERYONE:'Tout le monde', MUTUAL_FOLLOW_FRIENDS:'Amis', FOLLOWER_OF_CREATOR:'Abonnés'} %}
{% for video in videos %}<section class="batch-review" aria-labelledby="review-video-{{ video.id }}"><h2 id="review-video-{{ video.id }}">{{ video.title }}</h2><div class="draft-review-layout">{% if video.source is defined %}{% include 'draft/_preview.html.twig' with {item:video} %}{% endif %}<div class="batch-review-grid">{% for network in networks %}{% set row = content[network].videos[video.id] %}<article><h3>{{ destinations[network].label }}</h3><p class="batch-account">{{ destinations[network].name ?: 'Compte à connecter' }}</p>
{% if network == 'youtube' %}<h4>{{ row.title }}</h4><p class="batch-caption">{{ row.description ?: 'Aucune description' }}</p><dl><div><dt>Visibilité</dt><dd>{{ row.privacy ? privacyNames[row.privacy] : 'À choisir' }}</dd></div><div><dt>Conçue pour les enfants</dt><dd>{{ row.audience == 'yes' ? 'Oui' : (row.audience == 'no' ? 'Non' : 'À choisir') }}</dd></div><div><dt>Contenu modifié ou généré artificiellement</dt><dd>{{ row.synthetic ? 'Oui' : 'Non' }}</dd></div></dl>
{% else %}<p class="batch-caption">{{ row.caption ?: 'Aucune légende' }}</p><dl>{% if network == 'instagram' %}<div><dt>Partager dans le fil</dt><dd>{{ row.shareToFeed ? 'Oui' : 'Non' }}</dd></div>{% else %}<div><dt>Visibilité</dt><dd>{{ row.privacy ? privacyNames[row.privacy] : 'À choisir après connexion' }}</dd></div>{% for flag,label in {comment:'Commentaires',duet:'Duos',stitch:'Collages',disclosure:'Contenu commercial',ownBrand:'Propre marque',partnerBrand:'Marque partenaire'} %}<div><dt>{{ label }}</dt><dd>{{ row[flag] ? 'Oui' : 'Non' }}</dd></div>{% endfor %}{% endif %}<div><dt>Contenu généré par IA</dt><dd>{{ row.synthetic ? 'Oui' : 'Non' }}</dd></div></dl>{% endif %}
</article>{% endfor %}</div></div></section>{% endfor %}
