{% extends 'studio/base.html.twig' %}
{% block title %}Préparer mes Reels — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary" href="{{ path('app_library') }}">← Revenir à la bibliothèque</a>
<div class="studio-heading"><div><span class="eyebrow">LE PROCHAIN MOUVEMENT</span><h1>Prêtes à partager.</h1><p>{{ videos|length }} vidéo{{ videos|length > 1 ? 's' : '' }} · Instagram Reels{% if connection %} · <strong>@{{ connection.username }}</strong>{% endif %}</p></div></div>
<nav class="publication-toolbar publication-destinations" aria-label="Destination"><a class="account-secondary" href="{{ path('app_publication_prepare', {videos: ids}) }}">YouTube</a><strong aria-current="page">Instagram Reels</strong></nav>
{% if not connection or connection.expired %}<div class="account-notice" role="status">Connecte ton compte Instagram Créateur ou Entreprise. <a href="{{ path('app_connections') }}">Mes connexions ↗</a></div>{% endif %}
{% if not mediaReady %}<div class="account-notice" role="status">L’envoi Instagram n’est pas encore activé. Tu peux préparer tes légendes ici.</div>{% endif %}
{{ form_start(form, {attr: {class: 'publication-form account-form'}}) }}{{ form_errors(form) }}
{% for video in videos %}{% set row = attribute(form.videos, video.id) %}
<section class="publication-editor" aria-labelledby="video-{{ video.id }}"><div class="publication-preview"><video controls playsinline preload="metadata" src="{{ path('app_video_stream', {id: video.id}) }}" aria-label="Aperçu de {{ video.title }}"></video><h2 id="video-{{ video.id }}">{{ video.title }}</h2><p>{{ video.width }} × {{ video.height }} · {{ video.duration|number_format(1, ',', ' ') }} s</p>{% if issues[video.id] is defined %}<p class="publication-notice" role="alert">{{ issues[video.id] }}</p>{% endif %}</div><div class="publication-fields">{{ form_errors(row) }}{{ form_row(row.caption) }}{{ form_row(row.shareToFeed) }}{{ form_row(row.synthetic) }}<p class="library-note">Le format vertical 9:16 est conseillé. Aucun recadrage ni ajout de musique automatique.</p></div></section>
{% endfor %}
<div class="publication-confirm"><p>Chaque vidéo sera publiée comme un Reel distinct sur le compte indiqué.</p>{{ form_row(form.confirm) }}<button class="button" type="submit"{% if not ready %} disabled{% endif %}>Publier {{ videos|length }} Reel{{ videos|length > 1 ? 's' : '' }} sur Instagram ↗</button></div>{{ form_end(form) }}
{% endblock %}
