{% extends 'studio/base.html.twig' %}
{% block title %}Préparer mes TikTok — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary" href="{{ path('app_library') }}">← Revenir à la bibliothèque</a>
<div class="studio-heading"><div><span class="eyebrow">LE PROCHAIN MOUVEMENT</span><h1>Prêtes à partager.</h1><p>{{ videos|length }} vidéo{{ videos|length > 1 ? 's' : '' }} · TikTok{% if creator.creator_nickname is defined %} · <strong>{{ creator.creator_nickname }}</strong>{% elseif connection %} · <strong>{{ connection.displayName }}</strong>{% endif %}</p></div></div>
<nav class="publication-toolbar publication-destinations" aria-label="Destination"><a class="account-secondary" href="{{ path('app_youtube_prepare', {videos: ids}) }}">YouTube</a><a class="account-secondary" href="{{ path('app_instagram_prepare', {videos: ids}) }}">Instagram Reels</a><strong aria-current="page">TikTok</strong></nav>
{% if not connection or connection.expired %}<div class="account-notice" role="status">Connecte ton compte TikTok. <a href="{{ path('app_connections') }}">Mes connexions ↗</a></div>{% endif %}
{% if not mediaReady %}<div class="account-notice" role="status">L’envoi TikTok n’est pas encore activé. Tu peux préparer tes légendes ici ; les visibilités seront disponibles après connexion.</div>{% endif %}
{{ form_start(form, {attr: {class: 'publication-form account-form'}}) }}{{ form_errors(form) }}
{% for video in videos %}{% set row = attribute(form.videos, video.id) %}
<section class="publication-editor" aria-labelledby="video-{{ video.id }}"><div class="publication-preview"><video controls playsinline preload="metadata" src="{{ path('app_video_stream', {id: video.id}) }}" aria-label="Aperçu de {{ video.title }}"></video><h2 id="video-{{ video.id }}">{{ video.title }}</h2><p>{{ video.width }} × {{ video.height }} · {{ video.duration|number_format(1, ',', ' ') }} s</p>{% if issues[video.id] is defined %}<p class="publication-notice" role="alert">{{ issues[video.id] }}</p>{% endif %}</div><div class="publication-fields">{{ form_errors(row) }}{{ form_row(row.caption) }}{{ form_row(row.privacy) }}<p class="library-note">Les essais avant validation de l’application TikTok sont privés. Choisis explicitement la visibilité pour chaque vidéo.</p>{{ form_row(row.comment) }}{{ form_row(row.duet) }}{{ form_row(row.stitch) }}<fieldset><legend>Contenu commercial</legend>{{ form_row(row.disclosure) }}{{ form_row(row.ownBrand) }}{{ form_row(row.partnerBrand) }}<p class="library-note">Active la déclaration puis indique au moins une marque. Un partenariat rémunéré ne peut pas être privé. TikTok affichera la mention promotionnelle ou partenariat correspondante.</p></fieldset>{{ form_row(row.synthetic) }}</div></section>
{% endfor %}
<div class="publication-confirm"><p>Chaque vidéo sera publiée séparément sur le compte indiqué. Aucun envoi ne démarre avant ta confirmation.</p><p class="library-note">Consulte la <a href="https://www.tiktok.com/legal/page/global/music-usage-confirmation/en" target="_blank" rel="noopener noreferrer">confirmation d’utilisation de la musique ↗</a> et la <a href="https://www.tiktok.com/legal/page/global/bc-policy/en" target="_blank" rel="noopener noreferrer">politique relative aux contenus de marque ↗</a>.</p>{{ form_row(form.confirm) }}<button class="button" type="submit"{% if not ready %} disabled{% endif %}>Publier {{ videos|length }} vidéo{{ videos|length > 1 ? 's' : '' }} sur TikTok ↗</button></div>{{ form_end(form) }}
{% endblock %}
