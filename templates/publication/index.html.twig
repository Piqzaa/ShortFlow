{% extends 'studio/base.html.twig' %}
{% block title %}Mes publications — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading"><div><span class="eyebrow">TES ENVOIS, LEUR AVANCEMENT</span><h1>Publications.</h1><p>Un historique commun, un résultat par vidéo et par réseau.</p></div><a class="button small" href="{{ path('app_library') }}">Choisir des vidéos +</a></div>
<form method="get" action="{{ path('app_publications') }}" class="publication-filters">
  <div><label for="publication-network">Réseau</label><select id="publication-network" name="network"><option value="">Tous les réseaux</option>{% for value,label in {youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'} %}<option value="{{ value }}"{{ network == value ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
  <div><label for="publication-state">État</label><select id="publication-state" name="state"><option value="">Tous les états</option>{% for value,label in {active:'En cours',attention:'À traiter',published:'Publiées',cancelled:'Arrêtées'} %}<option value="{{ value }}"{{ state == value ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
  <button class="button small" type="submit">Filtrer</button>{% if network or state %}<a class="account-secondary" href="{{ path('app_publications') }}">Effacer les filtres</a>{% endif %}
</form>
{% set statisticsActive = network ? statisticsNetworks[network]|default(false) : true in statisticsNetworks|default([]) %}
{% if feed.items and not statisticsActive %}<p class="library-note publication-stats-info">Statistiques non connectées : aucun relevé réel pour le moment. Les intégrations sont préparées et testées localement.</p>{% elseif feed.items %}<p class="library-note publication-stats-info">— : donnée non fournie. Les vues suivent les règles de chaque réseau.</p>{% endif %}
<div class="publication-toolbar"><span>{{ feed.total }} envoi{{ feed.total > 1 ? 's' : '' }}</span><a class="account-secondary" href="{{ path('app_publications', {network:network,state:state,page:feed.page}) }}">Actualiser ↻</a></div>
{% if feed.items %}<div class="publication-list">{% for job in feed.items %}{% include 'publication/_job.html.twig' %}{% endfor %}</div>{% else %}<section class="studio-empty"><h2>{{ network or state ? 'Aucun envoi avec ces filtres.' : 'Ta prochaine vidéo attend son public.' }}</h2><p>{{ network or state ? 'Essaie un autre réseau ou un autre état.' : 'Sélectionne tes vidéos dans la bibliothèque, puis prépare leur publication.' }}</p><a class="button small" href="{{ path(network or state ? 'app_publications' : 'app_library') }}">{{ network or state ? 'Voir tous les envois' : 'Choisir mes vidéos ↗' }}</a></section>{% endif %}
{% if feed.pages > 1 %}<nav class="library-pagination" aria-label="Pages des publications">{% if feed.page > 1 %}<a href="{{ path('app_publications', {network:network,state:state,page:feed.page-1}) }}">← Précédente</a>{% endif %}<span>Page {{ feed.page }} sur {{ feed.pages }}</span>{% if feed.page < feed.pages %}<a href="{{ path('app_publications', {network:network,state:state,page:feed.page+1}) }}">Suivante →</a>{% endif %}</nav>{% endif %}
{% endblock %}
