{% extends 'studio/base.html.twig' %}
{% block title %}Mes publications — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading"><div><span class="eyebrow">DE L’IDÉE À L’ÉCRAN</span><h1>Publications.</h1><p>Chaque vidéo, chaque envoi, au même endroit.</p></div><a class="button small" href="{{ path('app_library') }}">Choisir des vidéos +</a></div>
{% if jobs %}<div class="publication-toolbar"><span>Les 100 derniers envois</span><a class="account-secondary" href="{{ path('app_publications') }}">Actualiser ↻</a></div><div class="publication-list">{% for job in jobs %}{% set statuses = {queued:'En attente', uploading:'Transfert en cours', processing:'Traitement YouTube', published:'Disponible sur YouTube', paused:'Envoi suspendu', failed:'Refusée / indisponible', review:'À vérifier dans YouTube Studio', cancelled:'Envoi arrêté'} %}<article class="publication-item"><div><span class="eyebrow">YOUTUBE · {{ job.channelTitle }}</span><h2>{{ job.title }}</h2><p>{{ job.createdAt|date('d/m/Y à H:i') }} · Visibilité demandée : {{ {private:'Privée',unlisted:'Non répertoriée',public:'Publique'}[job.privacy] }}</p>{% if job.notice %}<p class="publication-notice">{{ job.notice }}</p>{% endif %}</div><div class="publication-result"><strong class="publication-state state-{{ job.status }}">{{ statuses[job.status] }}</strong>{% if job.status == 'uploading' and job.source %}<span>{{ (100 * job.sentBytes / job.source.byteSize)|round }} % transférés</span>{% endif %}{% if job.remoteId %}<a class="account-secondary" href="https://www.youtube.com/watch?v={{ job.remoteId }}" target="_blank" rel="noopener noreferrer">Voir sur YouTube ↗</a>{% endif %}{% if job.status == 'paused' %}<form action="{{ path('app_publication_resume', {id: job.id}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('resume_' ~ job.id) }}"><button class="button small" type="submit">Reprendre ↻</button></form>{% endif %}{% if job.status in ['queued','uploading','processing','paused'] %}<a class="account-secondary" href="{{ path('app_publication_stop', {id: job.id}) }}">Arrêter l’envoi / le suivi</a>{% endif %}</div></article>{% endfor %}</div>{% else %}<section class="studio-empty"><h2>Ta prochaine vidéo attend son public.</h2><p>Sélectionne tes vidéos dans la bibliothèque, puis prépare leur publication.</p><a class="button small" href="{{ path('app_library') }}">Choisir mes vidéos ↗</a></section>{% endif %}
{% endblock %}
