{% if instagramJobs %}<h2>Instagram Reels</h2><div class="publication-list">{% for job in instagramJobs %}{% set statuses = {queued:'En attente', processing:'Traitement Instagram', publishing:'Confirmation Instagram', published:'Disponible sur Instagram', paused:'Envoi suspendu', failed:'Refusée / indisponible', review:'À vérifier sur Instagram', cancelled:'Suivi arrêté'} %}
<article class="publication-item"><div><span class="eyebrow">INSTAGRAM · @{{ job.username }}</span><h2>{{ job.title }}</h2><p>{{ job.createdAt|date('d/m/Y à H:i') }} · Reel{{ job.shareToFeed ? ' et fil' : '' }}</p>{% if job.notice %}<p class="publication-notice">{{ job.notice }}</p>{% endif %}</div><div class="publication-result"><strong class="publication-state state-{{ job.status }}">{{ statuses[job.status] }}</strong><a class="account-secondary" href="https://www.instagram.com/{{ job.username }}/" target="_blank" rel="noopener noreferrer">Voir le profil ↗</a>{% if job.status == 'paused' %}<form method="post" action="{{ path('app_instagram_job_action', {id: job.id, action:'reprendre'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('instagram_reprendre_' ~ job.id) }}"><button class="button small" type="submit">Reprendre le suivi ↻</button></form>{% endif %}{% if job.status in ['queued','processing','publishing','paused','review'] %}<form method="post" action="{{ path('app_instagram_job_action', {id: job.id, action:'arreter'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('instagram_arreter_' ~ job.id) }}"><button class="account-secondary" type="submit">Arrêter le suivi</button></form>{% endif %}</div></article>
{% endfor %}</div>{% endif %}
