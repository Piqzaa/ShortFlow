{% extends 'studio/base.html.twig' %}
{% block title %}Mes connexions — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading"><div><span class="eyebrow">TES COMPTES, TON CONTRÔLE</span><h1>Connexions.</h1><p>Connecte plusieurs comptes et choisis le destinataire de chaque vidéo avant publication.</p></div></div>
{% set labels = {youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'} %}
{% for network,connections in socialConnections %}
<section class="social-connection-group {{ network == 'instagram' ? 'instagram-connection' : '' }}" aria-labelledby="{{ network }}-title"><h2 id="{{ network }}-title">{{ labels[network] }}</h2>
{% if connections is empty %}<p class="library-note">Connecte {{ network == 'youtube' ? 'ta chaîne YouTube' : (network == 'instagram' ? 'ton compte Créateur ou Entreprise avec Instagram' : 'ton compte TikTok') }} pour préparer tes publications.</p>{% endif %}
{% for connection in connections %}
{% set identity = network == 'youtube' ? connection.channelId : (network == 'instagram' ? connection.instagramId : connection.openId) %}
{% set label = network == 'youtube' ? connection.channelTitle : (network == 'instagram' ? '@' ~ connection.username : connection.displayName) %}
<article class="connection-panel" aria-label="{{ labels[network] }} · {{ label }}"><div class="connection-brand" aria-hidden="true">{{ network == 'youtube' ? '▶' : (network == 'instagram' ? '◎' : '♪') }}</div><div><h3>{{ label }}</h3><p class="library-note">Identifiant : {{ identity }}</p>
{% if network != 'youtube' and connection.expired %}<p class="connection-warning" role="status">Autorisation expirée. Reconnecte ce compte.</p>{% elseif network == 'instagram' and connection.expiring %}<p class="connection-warning" role="status">Autorisation valable jusqu’au {{ connection.expiresAt|date('d/m/Y',app.user.timezone) }}. Reconnecte ce compte pour la renouveler.</p>{% else %}<p class="library-note">Compte connecté{% if network == 'instagram' %} · {{ connection.accountType == 'MEDIA_CREATOR' ? 'Créateur' : 'Entreprise' }}{% endif %}</p>{% endif %}
<a class="account-secondary" href="{{ network == 'youtube' ? 'https://www.youtube.com/channel/' ~ identity : (network == 'instagram' ? 'https://www.instagram.com/' ~ connection.username ~ '/' : path('app_tiktok_profile',{account:identity})) }}" target="_blank" rel="noopener noreferrer">{{ network == 'youtube' ? 'Voir la chaîne' : 'Voir le profil' }} ↗</a></div>
<div class="connection-actions">{% if socialReady[network] %}<form action="{{ path('app_' ~ network ~ '_connect') }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token(network ~ '_connect') }}"><input type="hidden" name="account" value="{{ identity }}"><button class="button small" type="submit">Reconnecter {{ labels[network] }} ↗</button></form>{% endif %}<form action="{{ path('app_' ~ network ~ '_disconnect') }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token(network ~ '_disconnect') }}"><input type="hidden" name="account" value="{{ identity }}"><button class="account-secondary" type="submit">Déconnecter de VydFlow</button></form></div></article>
{% endfor %}
{% if socialReady[network] %}<form action="{{ path('app_' ~ network ~ '_connect') }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token(network ~ '_connect') }}"><button class="button small" type="submit">{{ connections is empty ? 'Connecter ' ~ labels[network] : 'Ajouter un compte ' ~ labels[network] }} ↗</button></form>{% else %}<button class="button small" type="button" disabled>Connecter {{ labels[network] }} ↗</button><p class="library-note">La connexion {{ labels[network] }} attend son activation.</p>{% endif %}
<p class="library-note">Ajouter conserve les autres comptes. Reconnecter renouvelle uniquement le compte choisi. Déconnecter retire ses accès de VydFlow et bloque ses prochains envois ; les contenus déjà publiés restent sur le réseau.</p></section>
{% endfor %}
<section class="ai-connections-link" aria-labelledby="ai-connections-title"><div><h2 id="ai-connections-title">Comptes IA</h2><p>Choisis tes modèles et utilise ton propre compte fournisseur.</p></div><a class="account-secondary" href="{{ path('app_ai_keys') }}">Connecter mon fournisseur IA ↗</a></section>
{% endblock %}
