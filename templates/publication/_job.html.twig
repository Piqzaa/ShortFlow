{% set instagram = job.network == 'instagram' %}
{% set tiktok = job.network == 'tiktok' %}
{% set networkName = {youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'}[job.network] %}
{% set labels = {queued:'En attente', uploading:'Transfert en cours', processing:'Traitement ' ~ networkName, publishing:'Confirmation ' ~ networkName, published:'Disponible sur ' ~ networkName, paused:'Envoi suspendu', failed:'En échec', review:'À vérifier sur le réseau', cancelled:'Suivi arrêté'} %}
{% if job.network == 'youtube' and job.status == 'published' %}{% set labels = labels|merge({published:job.effective_privacy ? 'Traitement confirmé · ' ~ {private:'Privée',unlisted:'Non répertoriée',public:'Publique'}[job.effective_privacy] : 'Traitement confirmé · visibilité à vérifier'}) %}{% endif %}
<article class="publication-item" data-network="{{ job.network }}">
  {% if job.source_id %}
    <details open class="publication-preview publication-media" data-controller="publication-preview" data-action="toggle->publication-preview#toggle">
      <summary>Aperçu vidéo</summary>
      <video controls playsinline preload="metadata" src="{{ path('app_video_stream', {id:job.source_id}) }}" aria-label="Aperçu de {{ job.title }}">Ton navigateur ne permet pas de lire cette vidéo.</video>
    </details>
  {% else %}<div class="publication-media publication-media-missing"><span>Source supprimée</span></div>{% endif %}
  <div><span class="eyebrow publication-network">{% include 'shared/_network_icon.html.twig' with {network:job.network} only %}<span>{{ networkName|upper }} · {{ instagram ? '@' : '' }}{{ job.account }}</span></span><h2>{{ job.title }}</h2><p>{{ job.created_at|date('d/m/Y à H:i') }}{% if not instagram %} · Visibilité demandée : {{ {private:'Privée',unlisted:'Non répertoriée',public:'Publique',SELF_ONLY:'Moi uniquement',PUBLIC_TO_EVERYONE:'Tout le monde',MUTUAL_FOLLOW_FRIENDS:'Amis',FOLLOWER_OF_CREATOR:'Abonnés'}[job.privacy]|default(job.privacy) }}{% else %} · Reel{% endif %}</p>
    {% if job.notice %}<p class="publication-notice">{{ job.notice }}</p>{% endif %}
    {% if job.network == 'youtube' and job.status == 'published' %}<p class="library-note">{% if job.effective_privacy %}Visibilité confirmée par YouTube : {{ {private:'Privée',unlisted:'Non répertoriée',public:'Publique'}[job.effective_privacy] }}.{% else %}La visibilité demandée ne confirme pas la visibilité effective. Vérifie YouTube Studio.{% endif %}</p>{% endif %}
    {% if job.status == 'review' %}<p class="library-note">Vérifie le résultat sur le réseau avant tout nouvel envoi. Reprendre le suivi, lorsqu’il est disponible, ne republie pas la vidéo.</p>{% endif %}
    {% if job.status == 'published' %}{% include 'publication/_statistics.html.twig' with {statisticsEnabled: statisticsNetworks[job.network]|default(false)} %}{% endif %}
  </div>
  <div class="publication-result"><strong class="publication-state state-{{ job.status }}">{{ labels[job.status]|default(job.status) }}</strong>
    {% if job.status == 'uploading' and job.byte_size %}<span>{{ (100 * job.sent_bytes / job.byte_size)|round }} % transférés</span>{% endif %}
    {% if instagram and job.status == 'published' and job.remote_id %}<a class="account-secondary" href="{{ path('app_instagram_view',{id:job.id}) }}" target="_blank" rel="noopener noreferrer">Voir sur Instagram ↗</a>{% elseif instagram %}<a class="account-secondary" href="https://www.instagram.com/{{ job.account }}/" target="_blank" rel="noopener noreferrer">Voir le profil ↗</a>{% elseif tiktok %}{% if job.remote_id %}<a class="account-secondary" href="https://www.tiktok.com/player/v1/{{ job.remote_id }}" target="_blank" rel="noopener noreferrer">Voir sur TikTok ↗</a>{% elseif job.status == 'published' %}<span class="library-note">Publication confirmée par TikTok. Le lien public n’est pas disponible pour cette vidéo.</span>{% endif %}{% elseif job.remote_id %}<a class="account-secondary" href="https://www.youtube.com/watch?v={{ job.remote_id }}" target="_blank" rel="noopener noreferrer">Voir sur YouTube ↗</a>{% endif %}
    {% if job.can_resume %}<form method="post" action="{{ instagram or tiktok ? path(tiktok ? 'app_tiktok_job_action' : 'app_instagram_job_action', {id:job.id, action:'reprendre'}) : path('app_publication_resume', {id:job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token(instagram or tiktok ? job.network ~ '_reprendre_' ~ job.id : 'resume_' ~ job.id) }}"><button class="button small" type="submit">{{ job.resume_label }} ↻</button></form>{% endif %}
    {% if job.can_prepare_again %}<a class="button small" href="{{ path('app_composer_start',{retryNetwork:job.network,retryJob:job.id}) }}">Corriger et préparer à nouveau →</a>{% elseif job.status == 'failed' %}<span class="library-note">La source n’est plus disponible. Importe une vidéo pour préparer un nouvel envoi.</span>{% endif %}
    {% if (instagram or tiktok) and job.status in ['queued','processing','publishing','paused','review'] %}<form method="post" action="{{ path(tiktok ? 'app_tiktok_job_action' : 'app_instagram_job_action', {id:job.id, action:'arreter'}) }}"><input type="hidden" name="_token" value="{{ csrf_token(job.network ~ '_arreter_' ~ job.id) }}"><button class="account-secondary" type="submit">Arrêter le suivi</button></form>{% elseif not instagram and not tiktok and job.status in ['queued','uploading','processing','paused'] %}<a class="account-secondary" href="{{ path('app_publication_stop', {id:job.id}) }}">Arrêter l’envoi / le suivi</a>{% endif %}
  </div>
</article>
