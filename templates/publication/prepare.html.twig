{% extends 'studio/base.html.twig' %}
{% block title %}Préparer ma publication — VydFlow{% endblock %}
{% block studio_content %}
<a class="account-secondary" href="{{ path('app_library') }}">← Revenir à la bibliothèque</a>
<div class="studio-heading"><div><span class="eyebrow">LE PROCHAIN MOUVEMENT</span><h1>Prêtes à partager.</h1><p>{{ videos|length }} vidéo{{ videos|length > 1 ? 's' : '' }} · Destination : YouTube{% if connection %} · <strong>{{ connection.channelTitle }}</strong>{% endif %}</p></div></div>
{% if not ready %}<div class="account-notice" role="status">Connecte ta chaîne YouTube pour lancer les envois. <a class="account-secondary" href="{{ path('app_connections') }}">Mes connexions ↗</a></div>{% endif %}
<nav class="publication-toolbar publication-destinations" aria-label="Destination"><strong aria-current="page">YouTube</strong><a class="account-secondary" href="{{ path('app_instagram_prepare', {videos: videos|map(video => video.id)}) }}">Instagram Reels ↗</a><a class="account-secondary" href="{{ path('app_tiktok_prepare', {videos: videos|map(video => video.id)}) }}">TikTok ↗</a></nav>
{{ form_start(form, {attr: {class: 'publication-form account-form'}}) }}{{ form_errors(form) }}
{% for video in videos %}{% set row = attribute(form.videos, video.id) %}
<section class="publication-editor" aria-labelledby="video-{{ video.id }}"><div class="publication-preview"><video controls playsinline preload="metadata" src="{{ path('app_video_stream', {id: video.id}) }}" aria-label="Aperçu de {{ video.title }}"></video><h2 id="video-{{ video.id }}">{{ video.title }}</h2><p>{{ video.width }} × {{ video.height }} · {{ video.duration|number_format(1, ',', ' ') }} s</p></div><div class="publication-fields">{{ form_errors(row) }}{{ form_row(row.title) }}{{ form_row(row.description) }}<div class="publication-options">{{ form_row(row.privacy) }}{{ form_row(row.audience) }}</div>{{ form_row(row.synthetic) }}</div></section>
{% endfor %}
<div class="publication-confirm"><p>Chaque vidéo sera envoyée séparément à la chaîne indiquée. YouTube décidera de son classement en Short selon son format. Aucun recadrage ni ajout de musique ne sera effectué.</p>{{ form_row(form.confirm) }}<button class="button" type="submit"{% if not ready %} disabled{% endif %}>Publier {{ videos|length }} vidéo{{ videos|length > 1 ? 's' : '' }} sur YouTube <span aria-hidden="true">↗</span></button><p class="library-note">En publiant, tu acceptes les <a href="https://www.youtube.com/t/terms" target="_blank" rel="noopener noreferrer">conditions d’utilisation de YouTube</a>.</p></div>
{{ form_end(form) }}
{% endblock %}
