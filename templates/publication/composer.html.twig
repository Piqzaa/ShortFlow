{% extends 'studio/base.html.twig' %}
{% block title %}Préparer ma publication — VydFlow{% endblock %}
{% block studio_content %}
{% if sourceEpisode|default(null) %}<a class="account-secondary composer-back" href="{{ path('app_series_episode',{id:sourceEpisode.id}) }}">← {{ sourceEpisode.title }}</a><p class="library-note">Cette préparation conserve la version validée de ton épisode. Pour monter une autre version, retourne dans l’épisode.</p>{% endif %}
<a class="account-secondary composer-back" href="{{ path('app_dashboard') }}">← Studio</a><div class="workspace-heading"><div><span class="eyebrow">UNE VIDÉO, PLUSIEURS DESTINATIONS</span><h1>Prépare la suite.</h1><p>{{ videos|length }} vidéo{{ videos|length > 1 ? 's' : '' }} · réseaux, textes et créneau au même endroit.</p></div><span class="composer-save-state">{{ state.persistentId ? 'Brouillon enregistré' : 'Non enregistré' }}</span></div>
{{ form_start(form,{attr:{class:'composer-form account-form','data-controller':'composer unsaved','data-action':'input->unsaved#change change->unsaved#change submit->unsaved#submit'}}) }}
{{ form_errors(form) }}{{ form_row(form.revision) }}
<div class="composer-layout"><aside class="composer-preview"><h2>Ta sélection</h2>{% for video in videos %}<div class="composer-preview-item"><video controls playsinline preload="{{ loop.first ? 'metadata' : 'none' }}" src="{{ path('app_video_stream',{id:video.id}) }}" aria-label="Aperçu de {{ video.title }}"></video><h3>{{ video.title }}</h3><p>{{ video.mimeType == 'video/mp4' ? 'MP4' : 'WebM' }} · {{ video.width }} × {{ video.height }} · {{ video.duration|number_format(1,',',' ') }} s</p>{% if not sourceEpisode|default(null) %}<button class="account-secondary" type="submit" name="intent" value="edit_{{ video.id }}" formnovalidate>Modifier la vidéo</button>{% endif %}</div>{% endfor %}{% if not sourceEpisode|default(null) %}<a class="account-secondary" href="{{ path('app_dashboard',{choose:1}) }}">Choisir d’autres vidéos ↗</a>{% endif %}</aside>
<div class="composer-editor"><section class="composer-section"><h2><span>01</span> Tes destinations</h2><div class="composer-networks" data-action="change->composer#networks"><div class="composer-network-choices">{% for choice in form.networks %}<label>{{ form_widget(choice) }}<span>{{ choice.vars.label }}</span></label>{% endfor %}</div></div>{{ form_errors(form.networks) }}<button type="submit" name="intent" value="refresh" class="account-secondary composer-refresh{{ accountChanged ? " composer-refresh-needed" : "" }}" formnovalidate data-composer-target="refresh">Actualiser les réseaux</button><div class="composer-network-status">{% for network in selectedNetworks %}<span>{{ networkLabels[network] }} · {{ destinations[network].name ?: 'Compte à connecter' }}</span>{% endfor %}</div></section>
{% include 'publication/_batch_issues.html.twig' %}
<section class="composer-section"><h2><span>02</span> Tes textes et réglages</h2>{{ form_row(form.settings.draft_key) }}<details class="composer-draft-title"><summary>Nommer ce brouillon</summary>{{ form_row(form.settings.draft_title) }}</details>
{% include 'publication/_editorial.html.twig' %}
<p class="library-note">YouTube utilise un titre et une description ; Instagram et TikTok utilisent une légende. Ajoute tes hashtags dans la description ou la légende, puis relis les textes avant confirmation.</p>
{% if not selectedNetworks %}<p class="composer-placeholder">Choisis un réseau pour préparer ses textes. Tu peux enregistrer un brouillon avant de connecter tes comptes.</p>{% endif %}
{% for video in videos %}{% if videos|length > 1 %}<h3 class="composer-video-title">{{ video.title }}</h3>{% endif %}{% for network in selectedNetworks %}{% set row = attribute(form.settings,network).videos[video.id] %}<fieldset class="composer-network-fields"><legend>{{ networkLabels[network] }}</legend>{{ form_errors(row) }}
{% if network == 'youtube' %}{{ form_row(row.title) }}{{ form_row(row.description) }}<div class="composer-field-grid">{{ form_row(row.privacy) }}{{ form_row(row.audience) }}</div><details><summary>Déclaration de contenu</summary>{{ form_row(row.synthetic) }}</details>
{% elseif network == 'instagram' %}{{ form_row(row.caption) }}<details><summary>Options Instagram</summary>{{ form_row(row.shareToFeed) }}{{ form_row(row.synthetic) }}</details>
{% else %}{{ form_row(row.caption) }}{{ form_row(row.privacy) }}<details><summary>Interactions et déclarations</summary>{{ form_row(row.comment) }}{{ form_row(row.duet) }}{{ form_row(row.stitch) }}{{ form_row(row.disclosure) }}{{ form_row(row.ownBrand) }}{{ form_row(row.partnerBrand) }}{{ form_row(row.synthetic) }}</details>{% endif %}
</fieldset>{% endfor %}{% endfor %}</section>
<section class="composer-section"><h2><span>03</span> Le bon moment</h2><div class="composer-timing" data-action="change->composer#timing"><div class="composer-network-choices">{% for choice in form.mode %}<label>{{ form_widget(choice) }}<span>{{ choice.vars.label }}</span></label>{% endfor %}</div></div>{{ form_errors(form.mode) }}<div class="composer-date" data-composer-target="date">{{ form_row(form.local,{attr:{'data-local-datetime':'true'}}) }}{{ form_row(form.timezone) }}<p class="library-note">Le créneau sera vérifié avant confirmation. Modifier ton fuseau par défaut ne déplace pas une programmation existante.</p></div></section>
<div class="composer-actions"><button class="account-secondary" type="submit" name="intent" value="save" formnovalidate>Enregistrer le brouillon</button><button class="button" type="submit" name="intent" value="review">Vérifier avant de confirmer →</button></div><p class="composer-safe-note">Aucun envoi avant la confirmation finale.</p>
</div></div>{{ form_end(form) }}
{% endblock %}
