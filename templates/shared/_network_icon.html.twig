{% set isDecorative = decorative ?? true %}
{% set iconName = {youtube:'YouTube',instagram:'Instagram',tiktok:'TikTok'}[network] %}
<svg class="network-icon network-icon-{{ network }} {{ iconClass|default('') }}" viewBox="0 0 24 24"{% if isDecorative %} aria-hidden="true"{% else %} role="img" aria-label="{{ iconName }}"{% endif %} focusable="false">{% if not isDecorative %}<title>{{ iconName }}</title>{% endif %}{% if network == 'youtube' %}<rect y="3" width="24" height="18" rx="5" fill="currentColor"/><path d="m10 8 7 4-7 4Z" fill="#fff"/>{% elseif network == 'instagram' %}<g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></g><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/>{% else %}<path d="M14 3v13a4 4 0 1 1-4-4M14 3c0 4 3 6 6 6" fill="none" stroke="currentColor" stroke-width="2"/>{% endif %}</svg>
