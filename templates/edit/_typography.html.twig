{% set style = style|default({}) %}
<div class="editor-type-controls" data-type-controls data-type-kind="{{ kind }}">
<label>Police<select name="{{ prefix }}[font]" data-type-font data-action="focus->edit#remember change->edit#typographyChange">{% for value,label in {'anton':'Anton','bebas':'Bebas Neue','oswald':'Oswald','sans':'Sans','sans-bold':'Sans · gras','serif':'Serif','serif-bold':'Serif · gras','mono':'Mono','mono-bold':'Mono · gras'} %}<option value="{{ value }}"{% if style.font|default('sans-bold') == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<div class="editor-cue-times">{% for key,label in {color:'Couleur',background:'Couleur du fond'} %}<label>{{ label }}<input type="color" name="{{ prefix }}[{{ key }}]" value="{{ attribute(style,key)|default(key == 'color' ? '#ffffff' : '#000000') }}" data-type-{{ key }} data-action="focus->edit#remember input->edit#typographyChange"></label>{% endfor %}</div>
<label>Alignement<select name="{{ prefix }}[align]" data-type-align data-action="focus->edit#remember change->edit#typographyChange">{% for value,label in {left:'Gauche',center:'Centré',right:'Droite'} %}<option value="{{ value }}"{% if style.align|default('center') == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<div class="editor-type-toggles">{% for key,label in {bold:'Gras',italic:'Italique',box:'Fond'} %}<label>{{ label }}<select name="{{ prefix }}[{{ key }}]" data-type-{{ key }} data-action="focus->edit#remember change->edit#typographyChange"><option value="0"{% if not attribute(style,key)|default(false) %} selected{% endif %}>Non</option><option value="1"{% if attribute(style,key)|default(false) %} selected{% endif %}>Oui</option></select></label>{% endfor %}</div>
<details class="editor-precise"><summary>Largeur, contour et opacité</summary><div class="editor-cue-times">{% for key,label in {width:'Largeur · %',outline:'Contour',shadow:'Ombre',opacity:'Opacité · %'} %}<label>{{ label }}<input type="number" name="{{ prefix }}[{{ key }}]" value="{{ attribute(style,key)|default(key == 'width' ? 80 : (key == 'opacity' ? 100 : 2)) }}" min="{{ key == 'width' ? 10 : 0 }}" max="{{ key == 'width' ? 95 : (key == 'opacity' ? 100 : 6) }}" step="1" data-type-{{ key }} data-action="focus->edit#remember input->edit#typographyChange"></label>{% endfor %}</div></details>
<div class="editor-type-presets"><select aria-label="Styles de texte" data-type-preset><option value="clean">Sobre</option><option value="hook">Accroche</option><option value="boxed">Encadré</option></select><button type="button" class="account-secondary" data-action="edit#applyTypePreset">Appliquer</button><button type="button" class="account-secondary" data-action="edit#saveTypePreset">Enregistrer ce style</button></div>
</div>
