{% set style = style|default({}) %}{% set chosenFont = style.font|default('sans-bold') %}
<div class="editor-type-controls" data-type-controls data-type-kind="{{ kind }}">
<label>Police<select name="{{ prefix }}[font]" data-type-font data-action="focus->edit#remember change->edit#typographyChange">{% for value,label in {'inter':'Inter','montserrat':'Montserrat','poppins':'Poppins','roboto':'Roboto','lato':'Lato','opensans':'Open Sans','anton':'Anton','bebas':'Bebas Neue','oswald':'Oswald','sans':'Sans','serif':'Serif','mono':'Mono'} %}<option value="{{ value }}"{% if chosenFont|replace({'-bold':''}) == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<div class="editor-cue-times editor-colours">{% for key,label in {color:'Couleur',background:'Couleur du fond'} %}<label>{{ label }}<span class="editor-colour-field"><input type="color" name="{{ prefix }}[{{ key }}]" value="{{ attribute(style,key)|default(key == 'color' ? '#ffffff' : '#000000') }}" data-type-{{ key }} data-action="focus->edit#remember input->edit#typographyChange"><input type="text" aria-label="{{ label }} · hexadécimal" value="{{ attribute(style,key)|default(key == 'color' ? '#ffffff' : '#000000') }}" maxlength="7" data-edit-ui data-color-hex="{{ key }}" data-action="focus->edit#remember input->edit#colourHex"></span></label>{% endfor %}</div>

<div class="editor-type-toggles">{% for key,label in {bold:'Gras',italic:'Italique',box:'Fond'} %}<label>{{ label }}<select name="{{ prefix }}[{{ key }}]" data-type-{{ key }} data-action="focus->edit#remember change->edit#typographyChange"><option value="0"{% if not (attribute(style,key)|default(false) or (key == 'bold' and chosenFont ends with '-bold')) %} selected{% endif %}>Non</option><option value="1"{% if attribute(style,key)|default(false) or (key == 'bold' and chosenFont ends with '-bold') %} selected{% endif %}>Oui</option></select></label>{% endfor %}</div>
<label class="editor-outline-switch"><input type="checkbox" data-edit-ui data-outline-toggle{% if style.outline|default(kind == 'caption' ? 2 : 0) > 0 %} checked{% endif %} data-action="change->edit#toggleOutline"> Contour du texte</label><details class="editor-precise"><summary>Options du texte</summary><label>Alignement<select name="{{ prefix }}[align]" data-type-align data-action="focus->edit#remember change->edit#typographyChange">{% for value,label in {left:'Gauche',center:'Centré',right:'Droite'} %}<option value="{{ value }}"{% if style.align|default('center') == value %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><div class="editor-cue-times editor-colours">{% for key,label in {width:'Largeur · %',outline:'Contour',shadow:'Ombre',opacity:'Opacité · %'} %}<label>{{ label }}<input type="number" name="{{ prefix }}[{{ key }}]" value="{{ attribute(style,key)|default(key == 'width' ? 80 : (key == 'opacity' ? 100 : (key == 'outline' and kind == 'caption' ? 2 : 0))) }}" min="{{ key == 'width' ? 10 : 0 }}" max="{{ key == 'width' ? 95 : (key == 'opacity' ? 100 : 6) }}" step="1" data-type-{{ key }} data-action="focus->edit#remember input->edit#typographyChange"></label>{% endfor %}</div></details>
<div class="editor-type-presets"><div data-saved-style-picker hidden><label>Mes styles<select aria-label="Mes styles enregistrés" data-type-preset data-edit-ui><option value="">Choisir un style enregistré</option></select></label><button type="button" class="account-secondary" data-action="edit#applyTypePreset">Appliquer mon style</button></div><button type="button" class="account-secondary" data-action="edit#saveTypePreset">Enregistrer ce style</button></div>
</div>
