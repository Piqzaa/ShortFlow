{% extends 'studio/base.html.twig' %}
{% block title %}Assembler les clips — VydFlow{% endblock %}
{% block studio_content %}
<div class="studio-heading"><div><span class="eyebrow">LE STUDIO</span><h1>Assembler les clips.</h1><p>Assemble tes clips importés ou générés en une seule vidéo.</p></div><a class="account-secondary" href="{{ path('app_dashboard') }}">Mes vidéos ↗</a></div>
{% if projects %}<details class="creation-details edit-projects"><summary>Reprendre un montage · {{ projects|length }}</summary>{% for item in projects %}<a class="ai-history-item" href="{{ path('app_edit_show',{id:item.id}) }}"><strong>{{ item.title }}</strong><span>{{ labels[item.status] }} ↗</span></a>{% endfor %}</details>{% endif %}
<h2 class="edit-section-title">1. Choisis tes clips</h2><p class="library-note">De 1 à 8 clips. Sources importées et IA peuvent être mélangées. Tu choisiras ensuite leur ordre et leurs coupes.</p>
<form method="get" class="library-search edit-search"><label for="edit-search">Rechercher dans mes vidéos</label><div><input id="edit-search" name="q" type="search" value="{{ query }}" maxlength="120" placeholder="Nom de la vidéo"><button class="account-secondary">Rechercher</button></div></form>
<form method="post" data-controller="edit-picker"><input type="hidden" name="_token" value="{{ csrf_token('edit_create') }}"><div class="edit-pick-grid" data-controller="video-thumbnails">{% for video in results.items %}<label class="edit-pick"><video data-video-thumbnails-target="video" data-preview-src="{{ path('app_video_stream',{id:video.id}) }}#t=0.1" preload="none" muted playsinline aria-hidden="true"></video><span><input type="checkbox" name="videos[]" value="{{ video.id }}"{% if video.id in selected %} checked{% endif %} data-action="edit-picker#change"><strong>{{ video.title }}</strong><small>{{ video.duration|number_format(1,',') }} s · {{ video.width }} × {{ video.height }}</small></span></label>{% else %}<p>{{ query ? 'Aucun résultat. Essaie un autre nom.' : 'Importe ou génère une vidéo pour commencer.' }}</p>{% endfor %}</div><p class="library-note" role="status" data-edit-picker-target="count">Choisis jusqu’à 8 clips sur cette page. Tu pourras en ajouter depuis le montage.</p>{% if results.items %}<button class="button" type="submit">Continuer le montage →</button>{% endif %}</form>
{% if results.pages > 1 %}<nav class="library-pagination" aria-label="Pages des vidéos">{% if results.page > 1 %}<a class="account-secondary" href="{{ path('app_edit_index',{q:query,page:results.page-1}) }}">← Précédente</a>{% endif %}<span>{{ results.page }} / {{ results.pages }}</span>{% if results.page < results.pages %}<a class="account-secondary" href="{{ path('app_edit_index',{q:query,page:results.page+1}) }}">Suivante →</a>{% endif %}</nav>{% endif %}
<p><a class="account-secondary" href="{{ path('app_video_upload',{next:'edit'}) }}">Importer une vidéo +</a></p>
{% endblock %}
