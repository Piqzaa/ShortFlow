{% extends 'studio/base.html.twig' %}
{% block title %}{{ project.title }} — Montage — VydFlow{% endblock %}
{% block studio_content %}
{% set publication = project.publicationContext %}
{% set returnUrl = publication ? path('app_composer_start',{draft:publication.draft}) : path('app_dashboard') %}

<div class="studio-heading edit-heading{% if (not project.active or project.status == 'transcribing') and project.status != 'ready' %} editor-old-heading{% endif %}"><div><span class="eyebrow">STUDIO · MONTAGE</span><h1>{{ project.title }}</h1><p>{{ labels[project.status] }}</p></div><a class="account-secondary" href="{{ returnUrl }}">{{ publication ? 'Revenir à la préparation' : 'Mes vidéos' }} ↗</a></div>
{% if project.issue %}<p class="account-notice" role="alert">{{ project.issue }}</p>{% endif %}
{% if project.active and project.status != 'transcribing' %}<section class="ai-status" data-controller="edit-watch" data-edit-watch-url-value="{{ path('app_edit_state',{id:project.id}) }}"><div class="edit-loader" aria-hidden="true"></div><h2 role="status" data-edit-watch-target="status">{{ labels[project.status] }}</h2><p>{{ project.status == 'transcribing' ? 'Le son est transcrit sur ce serveur. Tu pourras relire les sous-titres avant d’exporter.' : 'Tu peux quitter cette page. L’export continue et la vidéo rejoindra ta bibliothèque.' }}</p><a class="account-secondary" href="{{ path('app_edit_show',{id:project.id}) }}">Actualiser le suivi ↻</a></section>
{% elseif project.status == 'ready' %}{% if project.output %}<video class="ai-result-player" controls playsinline preload="metadata" src="{{ path('app_video_stream',{id:project.output.id}) }}" aria-label="Montage exporté"></video><div class="workspace-heading-actions">{% if publication %}<form method="post" action="{{ path('app_edit_apply',{id:project.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('edit_apply_' ~ project.id) }}"><button class="button">{{ publication.applied ? 'Revenir à la préparation →' : 'Appliquer et revenir →' }}</button></form>{% else %}<a class="button" href="{{ path('app_composer_start',{videos:[project.output.id]}) }}">Préparer la publication →</a>{% endif %}<a class="account-secondary" href="{{ path('app_video_download',{id:project.output.id}) }}" download>Télécharger ↓</a><a class="account-secondary" href="{{ path('app_video_show',{id:project.output.id}) }}">Voir dans mes vidéos ↗</a></div>{% else %}<p>La vidéo exportée a été retirée de la bibliothèque. Les réglages du projet restent conservés.</p>{% endif %}
<form method="post" action="{{ path('app_edit_copy',{id:project.id}) }}" class="edit-copy"><input type="hidden" name="_token" value="{{ csrf_token('edit_copy_' ~ project.id) }}"><button class="account-secondary">Modifier une copie</button></form>
{% else %}
<div data-controller="edit" data-edit-focus-clip-value="{{ focusClip|default(0) }}" data-edit-styles-value="{{ editorStyles|default(null) ? editorStyles|json_encode : '{}' }}" data-edit-styles-url-value="{{ path('app_edit_style') }}" data-edit-styles-token-value="{{ csrf_token('edit_style') }}" data-edit-state-url-value="{{ path('app_edit_state',{id:project.id}) }}" data-edit-transcribing-value="{{ project.status == 'transcribing' ? 'true' : 'false' }}" data-action="video-cover->edit#cover input->edit#scheduleSave change->edit#scheduleSave click@window->edit#leave keydown@window->edit#shortcut" data-edit-initial-panel-value="clip" class="edit-workspace editor-workspace editor-desk"><h1 class="visually-hidden">Monter une vidéo</h1>
{{ form_start(form,{attr:{class:'account-form edit-form','data-edit-target':'form','data-action':'submit->edit#submit'}}) }}{{ form_errors(form) }}<input type="hidden" name="edit_revision" data-edit-target="revision" value="{{ project.revision }}"><input type="hidden" name="captions_current" data-edit-target="captionsCurrent" value="0">
<div class="editor-project-bar"><a href="{{ returnUrl }}" class="editor-back" data-action="edit#saveBeforeLink" aria-label="{{ publication ? 'Revenir à la préparation' : 'Mes vidéos' }}">←</a><div class="editor-name">{{ form_row(form.title,{attr:{'data-action':'input->edit#change'}}) }}<span data-edit-target="notice" role="status">{{ project.status == 'transcribing' ? 'Création des sous-titres… Tu peux lire le montage.' : 'Montage enregistré' }}</span></div><button data-edit-lock class="account-secondary editor-project-menu" type="button" data-action="edit#openProject" data-edit-control hidden aria-label="Actions du projet">⋯</button><button data-edit-lock class="account-secondary editor-save" aria-label="Enregistrer le montage" type="submit" name="intent" value="save">Enregistrer le montage</button><button data-edit-lock class="button editor-export" type="button" data-action="edit#openExport" data-edit-control hidden>Exporter ↗</button></div>
<div class="editor-grid">
<section class="editor-screen" data-edit-target="screen" hidden aria-label="Aperçu du montage"><div class="editor-canvas" data-edit-target="canvas" data-action="pointerdown->edit#panVideo"><video data-edit-target="stage" playsinline preload="metadata" data-action="loadedmetadata->edit#stageReady timeupdate->edit#stageTime ended->edit#stageEnd" aria-label="Aperçu du clip sélectionné"></video><span class="editor-hook" data-edit-target="hook" hidden></span><button type="button" class="editor-captions editor-overlay" data-edit-target="captionText" data-action="pointerdown->edit#beginOverlayDrag keydown->edit#overlayKey" aria-label="Déplacer les sous-titres" hidden></button><div class="editor-text-overlays" data-edit-target="textOverlays"></div></div><div class="editor-transport"><button class="account-secondary" type="button" data-action="edit#preview" data-edit-target="preview" hidden>Lire l’assemblage ▶</button><output data-edit-target="current">0:00</output><span data-edit-target="summary">{{ project.duration|number_format(1,',') }} s</span></div></section>
<section class="editor-timeline-panel" data-edit-target="timelinePanel" hidden aria-label="Timeline du montage"><p class="editor-selection-label" data-edit-target="selectionLabel" role="status">Sélectionne un élément dans une piste</p><div class="editor-timeline-heading"><div class="editor-cut-tools" data-edit-lock><button class="account-secondary" type="button" data-action="edit#split" data-edit-target="splitButton" title="Séparer l’élément sélectionné au curseur">✂ Couper le clip</button><button class="account-secondary" type="button" data-action="edit#removeSelected">⌫ Retirer</button><button class="account-secondary" type="button" data-action="edit#rippleRemove">Retirer et rapprocher</button><button class="account-secondary" type="button" data-action="edit#duplicateLayer">Dupliquer</button><button class="account-secondary" type="button" data-action="edit#undo" data-edit-target="undoButton" disabled>↶ Annuler</button></div><button class="account-secondary" type="button" data-edit-target="redoButton" data-action="edit#redo" disabled>↷ Rétablir</button><span class="editor-timeline-hint">Tire les bords pour raccourcir · glisse pour déplacer</span></div>
<div class="editor-timeline-options"><button type="button" class="account-secondary" data-action="edit#zoomOut" aria-label="Dézoomer la timeline">−</button><button type="button" class="account-secondary" data-action="edit#zoomIn" aria-label="Zoomer la timeline">+</button><button type="button" class="account-secondary" data-action="edit#zoomFit">Tout voir</button><label><input type="checkbox" checked data-edit-target="snap"> Aimantation</label><button type="button" class="account-secondary" data-action="edit#packClipsAction">Fermer les espaces</button></div><div class="editor-time-scroll"><div data-edit-target="timeContent"><label class="editor-playhead"><span class="visually-hidden">Position dans le montage</span><input aria-label="Position dans le montage" data-edit-target="playhead" type="range" min="0" max="{{ project.duration }}" step="0.01" value="0" data-action="input->edit#scrub"></label><div class="editor-ruler" data-edit-target="ruler" data-action="click->edit#seekTimeline" aria-hidden="true"></div><div class="editor-tracks" data-edit-target="tracks" data-action="click->edit#seekTimeline"><div class="editor-time-cursor" data-edit-target="cursor" aria-hidden="true"></div><div class="editor-track-label">VIDÉO</div><div class="editor-timeline" data-edit-lock data-controller="video-thumbnails" data-edit-target="timeline" data-action="dragover->edit#dragOver drop->edit#drop"></div><div class="editor-track-label">TEXTES</div><div class="editor-caption-track" data-edit-target="textTrack" data-edit-lock></div><div class="editor-track-label">SOUS-TITRES</div><div class="editor-caption-track" data-edit-lock data-edit-target="captionTrack"></div><div class="editor-track-label">AUDIO</div><div class="editor-audio-lanes" data-edit-target="audioTrack" data-edit-lock></div></div></div></div></section><aside class="editor-inspector" data-edit-lock aria-label="Réglages du montage"><div class="editor-tabs" role="group" aria-label="Panneaux de montage"><button class="editor-mobile-media" type="button" data-action="edit#media" aria-expanded="false">Médias</button><button type="button" aria-pressed="true" data-panel="clip" data-action="edit#panel">Clip</button><button type="button" aria-pressed="false" data-panel="effects" data-action="edit#panel">Effets</button><button type="button" aria-pressed="false" data-panel="text" data-action="edit#panel">Textes</button><button type="button" aria-pressed="false" data-panel="captions" data-action="edit#panel">Sous-titres</button><button type="button" aria-pressed="false" data-panel="style" data-action="edit#panel">Style</button><button type="button" aria-pressed="false" data-panel="audio" data-action="edit#panel">Audio</button></div>
<section data-editor-panel="clip"><h2 class="editor-panel-title">Clip sélectionné</h2><div data-edit-target="list">{% set clipAt = 0 %}{% for clip in clips %}{% include 'edit/_clip.html.twig' with {index:loop.index0,source:sources[clip.id]} %}{% set clipAt = clip.at|default(clipAt) + (clip.end-clip.start)/clip.rate|default(1) %}{% endfor %}</div></section>
<section data-editor-panel="text"><h2 class="editor-panel-title">Textes libres</h2><button type="button" class="button" data-action="edit#addText" data-edit-control hidden>Ajouter un texte +</button><p class="library-note">Déplace le texte sur l’image. Dans la timeline, glisse son bloc ou ses bords pour choisir quand il apparaît.</p><label>Texte sélectionné<select data-element-choice="text" data-edit-ui data-action="change->edit#selectElementChoice"></select></label><div data-edit-target="textRows">{% for text in project.texts %}{% include 'edit/_text.html.twig' with {index:loop.index0} %}{% endfor %}</div><template data-edit-target="textTemplate">{% include 'edit/_text.html.twig' with {index:0,text:{id:'new',text:'Ton texte',start:0,end:min(2,project.duration),x:0.5,y:0.2,size:4,color:'#ffffff'}} %}</template></section>
<section data-editor-panel="captions"><h2 class="editor-panel-title">Sous-titres automatiques</h2><p class="library-note">Transcription locale gratuite. Aucun fichier envoyé à un fournisseur. Relis le texte avant l’export.</p><button class="button" type="submit" formnovalidate name="intent" value="captions"{% if not captionsEnabled|default(false) %} disabled{% endif %}>{{ project.captions ? 'Régénérer les sous-titres' : 'Générer les sous-titres' }}</button>{% if not captionsEnabled|default(false) %}<p class="library-note">Le moteur local attend son activation.</p>{% endif %}
{{ form_row(form.language) }}{% include 'edit/_typography.html.twig' with {prefix:'caption_appearance',kind:'caption',style:project.settings.typography|default({color:project.settings.captionStyle == 'social' ? '#ffff00' : '#ffffff'})} %}<label>Déplacer<select data-edit-target="captionScope" data-edit-ui><option value="all">Tous les sous-titres</option><option value="one">Le bloc sélectionné</option></select></label><div class="editor-position-presets" role="group" aria-label="Position des sous-titres"><button class="account-secondary" type="button" data-y="0.15" data-action="edit#captionPreset">Haut</button><button class="account-secondary" type="button" data-y="0.5" data-action="edit#captionPreset">Centre</button><button class="account-secondary" type="button" data-y="0.85" data-action="edit#captionPreset">Bas</button></div><details class="editor-precise"><summary>Position et taille</summary>{{ form_row(form.captionX,{attr:{'data-edit-target':'captionX','data-action':'focus->edit#remember input->edit#captionChange'}}) }}{{ form_row(form.captionY,{attr:{'data-edit-target':'captionY','data-action':'focus->edit#remember input->edit#captionChange'}}) }}{{ form_row(form.captionSize,{attr:{'data-edit-target':'captionSize','data-action':'focus->edit#remember input->edit#captionChange'}}) }}</details><div class="editor-caption-list" data-edit-target="captionRows">{% for cue in project.captions %}{% include 'edit/_caption.html.twig' with {cue:cue,index:loop.index0} %}{% else %}<p class="library-note" data-caption-empty>Aucune parole transcrite pour le moment. Une vidéo sans voix peut rester sans sous-titres.</p><noscript>{% include 'edit/_caption.html.twig' with {cue:{start:0,end:min(2,project.duration),text:''},index:0} %}</noscript>{% endfor %}</div><button class="account-secondary" type="button" data-action="edit#addCaption" data-edit-control hidden>Ajouter un sous-titre +</button><button type="button" class="account-secondary" data-action="edit#mergeCaption">Fusionner avec le suivant</button>{% if project.captions %}<a class="creation-key-link" href="{{ path('app_edit_srt',{id:project.id}) }}" download>Télécharger les sous-titres SRT ↓</a>{% endif %}
</section>
<section data-editor-panel="style"><h2 class="editor-panel-title">Cadre et habillage</h2>{{ form_row(form.format,{attr:{'data-edit-target':'format','data-action':'change->edit#change'}}) }}{{ form_row(form.background) }}{{ form_row(form.fit,{attr:{'data-edit-target':'fit','data-action':'change->edit#change'}}) }}{{ form_row(form.captionStyle,{attr:{'data-edit-target':'captionStyle','data-action':'change->edit#change'}}) }}<div{% if not project.settings.intro %} hidden{% endif %}>{{ form_row(form.intro,{attr:{'data-edit-target':'intro','data-action':'change->edit#change'}}) }}<button type="button" class="account-secondary" data-action="edit#convertLegacyIntro">Convertir l’ancien titre en texte libre</button></div><p class="library-note">Le recadrage « Remplir » peut couper les bords de l’image. Vérifie l’aperçu.</p></section>
<section data-editor-panel="audio"><h2 class="editor-panel-title">Son et musique</h2>{{ form_row(form.sourceVolume,{attr:{'data-edit-target':'sourceVolume','data-action':'focus->edit#remember input->edit#audioChange'}}) }}
<button type="button" class="account-secondary" data-action="edit#detachAudio" data-edit-control hidden>Détacher le son des clips</button>
<p class="library-note">Le son détaché se monte indépendamment. Les clips sans piste sonore restent silencieux. Après avoir déplacé la voix, régénère les sous-titres pour les recaler.</p>
<button type="button" class="account-secondary" data-action="edit#openMusic">{{ project.musicName ? 'Gérer la musique' : 'Importer une musique +' }}</button>{% if project.musicFiles %}<label>Musique<select data-edit-target="musicChoice" data-edit-ui>{% for key,track in project.musicFiles %}<option value="{{ key }}" data-duration="{{ track.duration }}">{{ track.title }}</option>{% endfor %}</select></label><button type="button" class="account-secondary" data-action="edit#addMusicSegment" data-edit-control hidden>Ajouter un fragment musical +</button>{% endif %}
<input type="hidden" name="audio_current" value="1"><label>Fragment sélectionné<select data-element-choice="audio" data-edit-ui data-action="change->edit#selectElementChoice"></select></label><div data-edit-target="audioRows">{% for audio in project.audioClips %}{% include 'edit/_audio.html.twig' with {index:loop.index0,audioSource:audio.kind == 'video' ? sources[audio.source]|default(null) : null} %}{% endfor %}</div>
<template data-edit-target="audioTemplate">{% include 'edit/_audio.html.twig' with {index:0,audio:{id:'new',kind:'music',source:0,start:0,end:1,offset:0,volume:20,loop:true},audioSource:null} %}</template>
<div hidden>{{ form_widget(form.musicVolume) }}{{ form_widget(form.musicOffset) }}{{ form_widget(form.musicLoop) }}</div></section>
</aside></div>

<dialog open class="editor-export-dialog" data-edit-target="exportDialog" aria-labelledby="edit-export-title"><div class="editor-dialog-heading"><h2 id="edit-export-title">Exporter le montage</h2><button class="account-secondary" type="button" data-action="edit#closeExport" data-edit-control hidden aria-label="Fermer">×</button></div><details class="editor-bottom" data-edit-target="exportPanel" open><summary>Options d’export</summary><div class="editor-auto"><div><strong>Assemblage automatique</strong><p>Assemble tes clips dans l’ordre choisi, avec tes coupes et tes réglages.</p><label class="editor-auto-captions"><input type="checkbox" name="autoCaptions" value="1"{% if not captionsEnabled|default(false) %} disabled{% endif %}> Ajouter les sous-titres automatiques</label></div><button class="account-secondary" name="intent" value="auto" type="submit" formnovalidate>Préparer l’assemblage ✦</button></div><div class="edit-confirm"><label><input type="checkbox" name="confirm" value="1"> Créer une nouvelle vidéo. Mes sources sont conservées.</label><button class="button" type="submit" name="intent" value="export">Exporter ma vidéo →</button><small>MP4 · 1080p · moins de 3 minutes · 100 Mo max.</small>{% if publication %}<p class="library-note">Après l’export, clique sur « Appliquer et revenir » pour remplacer la vidéo dans ta préparation. Tes textes, réseaux et créneau sont conservés.</p>{% endif %}</div></details></dialog>
<noscript><p class="library-note">Les positions et coupes de chaque clip sont modifiables sans JavaScript. Enregistre avant de quitter. Le fichier exporté fournit l’aperçu assemblé.</p></noscript>
{{ form_end(form) }}
<dialog open class="editor-music-dialog" data-edit-target="musicDialog" aria-label="Importer une musique"><button class="account-secondary editor-music-close" type="button" data-action="edit#closeMusic" data-edit-control hidden aria-label="Fermer l’import musical">×</button><details id="edit-music" class="creation-details edit-music"><summary>Importer une musique ♫</summary><p class="library-note">Tes coupes sont enregistrées avant l’import. MP3, WAV, M4A ou OGG · 20 Mo · 10 min max.</p><form method="post" enctype="multipart/form-data" data-action="submit->edit#saveBeforeMusic" action="{{ path('app_edit_music',{id:project.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('edit_music_' ~ project.id) }}"><label>Piste musicale<input type="file" name="music" accept=".mp3,.wav,.m4a,.ogg,audio/*" required></label><label><input type="checkbox" name="rights" value="1" required> Je dispose des droits pour utiliser cette piste sur les réseaux choisis.</label><button class="account-secondary">Importer la piste</button></form>{% for key,track in project.musicFiles %}<form method="post" data-action="submit->edit#saveBeforeMusic" action="{{ path('app_edit_music',{id:project.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('edit_music_' ~ project.id) }}"><input type="hidden" name="musicId" value="{{ key }}"><button class="account-secondary" name="remove" value="1">Retirer {{ track.title }}</button></form>{% endfor %}<p class="library-note">Trouver une piste gratuite sur <a href="https://pixabay.com/music/" target="_blank" rel="noopener noreferrer">Pixabay ↗</a>. Vérifie sa licence et conserve ton justificatif de téléchargement.</p></details></dialog>

<aside class="editor-media" data-edit-lock aria-label="Médias du montage"><div class="editor-media-heading"><h2>Médias</h2><a href="{{ path('app_video_upload',{next:'edit',montage:project.id}) }}" class="account-secondary" data-action="edit#saveBeforeLink">Importer +</a></div><details class="editor-still-import"><summary>Ajouter une image +</summary><form method="post" enctype="multipart/form-data" action="{{ path('app_edit_image',{id:project.id}) }}" data-action="submit->edit#saveBeforeMusic"><input type="hidden" name="_token" value="{{ csrf_token('edit_image_' ~ project.id) }}"><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required></label><label>Durée · secondes<input type="number" name="seconds" min="1" max="30" value="4" step="0.1" required></label><button class="account-secondary">Ajouter l’image</button></form></details><details class="editor-still-import"><summary>Ajouter un carton de texte +</summary><form method="post" action="{{ path('app_edit_image',{id:project.id}) }}" data-action="submit->edit#saveBeforeMusic"><input type="hidden" name="_token" value="{{ csrf_token('edit_image_' ~ project.id) }}"><input type="hidden" name="solid" value="1"><label>Fond du carton<input type="color" name="color" value="#241833"></label><label>Durée · secondes<input type="number" name="seconds" min="1" max="30" value="4" step="0.1" required></label><button class="account-secondary">Ajouter le carton</button></form></details><form method="get" class="editor-media-search" data-action="submit->edit#searchMedia"><label class="visually-hidden" for="edit-add-search">Rechercher mes vidéos</label><input type="search" name="q" id="edit-add-search" value="{{ query }}" placeholder="Rechercher mes vidéos" maxlength="120"><button class="account-secondary" aria-label="Rechercher">⌕</button></form><div class="edit-add-list editor-media-list" data-controller="video-thumbnails">{% for video in results.items %}<form method="post" action="{{ path('app_edit_add',{id:project.id}) }}" data-action="submit->edit#addSource"><input type="hidden" name="_token" value="{{ csrf_token('edit_add_' ~ project.id) }}"><input type="hidden" name="video" value="{{ video.id }}"><video data-video-thumbnails-target="video" data-preview-src="{{ path('app_video_stream',{id:video.id}) }}" preload="none" muted playsinline aria-hidden="true"></video><span>{{ video.title }}<small>{{ video.duration|number_format(1,',') }} s</small></span><button class="account-secondary" aria-label="Ajouter {{ video.title }}">Ajouter</button><template data-clip-template>{% include 'edit/_clip.html.twig' with {clip:{id:video.id,start:0,end:video.duration},source:video,index:0} %}</template></form>{% else %}<p class="library-note">Aucune vidéo trouvée.</p>{% endfor %}</div>{% if results.pages > 1 %}<nav class="library-pagination" aria-label="Pages des médias">{% if results.page > 1 %}<a data-action="edit#saveBeforeLink" href="{{ path('app_edit_show',{id:project.id,q:query,page:results.page-1}) }}">←</a>{% endif %}<span>{{ results.page }} / {{ results.pages }}</span>{% if results.page < results.pages %}<a data-action="edit#saveBeforeLink" href="{{ path('app_edit_show',{id:project.id,q:query,page:results.page+1}) }}">→</a>{% endif %}</nav>{% endif %}</aside>
<dialog open class="editor-project-dialog" data-edit-target="projectDialog" aria-label="Actions du projet"><button class="account-secondary" type="button" data-action="edit#closeProject" data-edit-control hidden aria-label="Fermer les actions du projet">×</button><h2>Actions du projet</h2><details class="creation-details edit-remove"><summary>Retirer ce projet</summary><form method="post" action="{{ path('app_edit_remove',{id:project.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('edit_remove_' ~ project.id) }}"><label><input type="checkbox" name="confirm" value="1" required> Retirer uniquement le projet. Sources et exports conservés.</label><button class="account-secondary">Retirer le projet</button></form></details></dialog></div>{% endif %}
{% if project.status == 'ready' %}<details class="creation-details edit-remove"><summary>Retirer ce projet</summary><form method="post" action="{{ path('app_edit_remove',{id:project.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('edit_remove_' ~ project.id) }}"><label><input type="checkbox" name="confirm" value="1" required> Retirer uniquement le projet. Sources et exports conservés.</label><button class="account-secondary">Retirer le projet</button></form></details>{% endif %}
{% endblock %}
