<div class="editor-text-row" data-text-row><input type="hidden" name="texts[{{ index }}][id]" value="{{ text.id }}" data-text-id><label>Texte<textarea name="texts[{{ index }}][text]" maxlength="160" rows="2" data-text-text data-action="focus->edit#remember input->edit#textChange">{{ text.text }}</textarea></label><details class="editor-precise"><summary>Durée, position et taille</summary><div class="editor-cue-times">{% for key,label in {start:'Début',end:'Fin',x:'Position X',y:'Position Y',size:'Taille · %'} %}<label>{{ label }}<input type="number" name="texts[{{ index }}][{{ key }}]" value="{{ attribute(text,key) }}" min="{{ key in ['x','y'] ? 0.05 : (key == 'size' ? 2 : 0) }}" max="{{ key in ['x','y'] ? 0.95 : (key == 'size' ? 10 : project.duration) }}" step="{{ key in ['start','end'] ? 0.01 : (key == 'size' ? 0.5 : 0.01) }}" data-text-{{ key }} data-action="focus->edit#remember input->edit#textChange"></label>{% endfor %}</div></details>{% include 'edit/_typography.html.twig' with {prefix:'texts[' ~ index ~ ']',kind:'text',style:text} %}<button type="button" class="account-secondary" data-text-id="{{ text.id }}" data-action="edit#selectTextRow">Sélectionner ce texte</button></div>
