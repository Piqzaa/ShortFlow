<article class="editor-text-row editor-audio-row" data-audio-row data-audio-url="{{ audio.kind == 'music' ? path('app_edit_music_stream',{id:project.id}) : (audioSource ? path('app_video_stream',{id:audioSource.id}) : '') }}" data-audio-duration="{{ audioSource ? audioSource.duration : musicDuration|default(0) }}">
{% for key in ['id','kind','source'] %}<input type="hidden" name="audio[{{ index }}][{{ key }}]" value="{{ attribute(audio,key) }}" data-audio-{{ key }}>{% endfor %}
<input type="hidden" data-audio-text value="{{ audio.kind == 'music' ? (project.musicTitle ?: 'Musique') : (audioSource ? audioSource.title : 'Source retirée') }}">
<button type="button" class="account-secondary" data-audio-id="{{ audio.id }}" data-action="edit#selectAudioRow">♫ {{ audio.kind == 'music' ? (project.musicTitle ?: 'Musique') : (audioSource ? audioSource.title : 'Source retirée') }}</button>
<div class="editor-cue-times">
{% for key,label in {start:'Début dans le montage · s',end:'Fin dans le montage · s',offset:'Début dans le fichier · s',volume:'Volume · %'} %}<label>{{ label }}<input type="number" name="audio[{{ index }}][{{ key }}]" value="{{ attribute(audio,key) }}" min="0" max="{{ key == 'volume' ? 100 : (key == 'offset' ? 600 : 180) }}" step="{{ key == 'volume' ? 1 : 0.001 }}" required data-audio-{{ key }} data-action="focus->edit#remember input->edit#audioChange"></label>{% endfor %}
</div>
<label{% if audio.kind == 'video' %} hidden{% endif %}>Répétition<select name="audio[{{ index }}][loop]" data-audio-loop data-action="focus->edit#remember change->edit#audioChange"><option value="0"{% if not audio.loop %} selected{% endif %}>Lire une fois</option><option value="1"{% if audio.loop %} selected{% endif %}>Répéter</option></select></label>
</article>
