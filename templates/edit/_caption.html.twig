<div class="editor-caption-row" data-caption-row><div class="editor-cue-times"><label>Début<input type="number" name="captions[{{ index }}][start]" value="{{ cue.start }}" min="0" step="0.001" data-caption-start data-action="change->edit#captionChange"></label><label>Fin<input type="number" name="captions[{{ index }}][end]" value="{{ cue.end }}" min="0" step="0.001" data-caption-end data-action="change->edit#captionChange"></label></div><label>Texte du sous-titre<textarea name="captions[{{ index }}][text]" maxlength="160" rows="2" data-caption-text data-action="input->edit#captionChange">{{ cue.text }}</textarea></label></div>
