<form method="post" action="{{ path('app_edit_video',{id:video.id}) }}" class="edit-entry"{% if external|default(false) %} id="edit-video-{{ video.id }}" hidden{% endif %}><input type="hidden" name="_token" value="{{ csrf_token('edit_video_' ~ video.id) }}">{% if not external|default(false) %}<button class="account-secondary" type="submit">Éditer la vidéo</button>{% endif %}</form>
