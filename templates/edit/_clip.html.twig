<article class="edit-clip" data-edit-target="clip" data-id="{{ clip.id }}">
<input type="hidden" name="clips[{{ index }}][id]" value="{{ clip.id }}">
<div class="edit-clip-top"><span class="edit-clip-number" data-edit-number>{{ index+1 }}</span><strong>{{ source ? source.title : 'Source retirée' }}</strong><div class="edit-order"><button class="account-secondary" type="button" data-action="edit#up" aria-label="Monter le clip {{ index+1 }}" hidden data-edit-control>↑</button><button class="account-secondary" type="button" data-action="edit#down" aria-label="Descendre le clip {{ index+1 }}" hidden data-edit-control>↓</button></div></div>
<div class="edit-clip-body">{% if source %}<video style="--edit-ratio:{{ project.format == '16:9' ? 1.777778 : (project.format == '1:1' ? 1 : 0.5625) }};aspect-ratio:{{ project.format|replace({':':'/'}) }}" controls playsinline preload="none" src="{{ path('app_video_stream',{id:source.id}) }}" data-edit-player data-action="timeupdate->edit#limit loadedmetadata->edit#seek play->edit#seek" aria-label="Aperçu de {{ source.title }}"></video>{% else %}<p role="alert">La source a été retirée. Retire ce clip du montage pour continuer.</p>{% endif %}<details class="editor-precise"><summary>Réglages précis des coupes</summary><div class="edit-trims"><label class="editor-trim-slider" data-edit-control hidden>Couper le début<input type="range" min="0" max="{{ source ? source.duration : 180 }}" step="0.05" value="{{ clip.start }}" data-trim="start" data-action="input->edit#trim"></label><label class="editor-trim-slider" data-edit-control hidden>Couper la fin<input type="range" min="0" max="{{ source ? source.duration : 180 }}" step="0.05" value="{{ clip.end }}" data-trim="end" data-action="input->edit#trim"></label><label>Début (secondes)<input type="number" name="clips[{{ index }}][start]" value="{{ clip.start }}" min="0" max="{{ source ? source.duration : 180 }}" step="0.001" required data-edit-start data-action="focus->edit#remember input->edit#change change->edit#seekClip"></label><label>Fin (secondes)<input type="number" name="clips[{{ index }}][end]" value="{{ clip.end }}" min="0.1" max="{{ source ? source.duration : 180 }}" step="0.001" required data-edit-end data-action="focus->edit#remember input->edit#change"></label><label>Position<input type="number" name="clips[{{ index }}][position]" value="{{ index+1 }}" min="1" max="8" step="1" data-edit-position data-action="change->edit#sort"></label><label class="edit-omit"><input type="checkbox" name="clips[{{ index }}][omit]" value="1" data-edit-omit data-action="change->edit#change"> Retirer ce clip du montage</label></div></details></div></article>
