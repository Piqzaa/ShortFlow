<article class="edit-clip" data-edit-target="clip" data-id="{{ clip.id }}">
<input type="hidden" name="clips[{{ index }}][id]" value="{{ clip.id }}"><input type="hidden" name="clips[{{ index }}][origin]" data-edit-origin value="{{ clip.origin|default('new-' ~ clip.id) }}">
<label class="editor-clip-at">Position dans le montage · s<input type="number" name="clips[{{ index }}][at]" value="{{ clip.at|default(clipAt|default(0)) }}" min="0" max="179.4" step="0.01" data-edit-at data-action="focus->edit#remember change->edit#change"></label><label>Vitesse<select name="clips[{{ index }}][rate]" data-edit-rate data-action="focus->edit#remember change->edit#change">{% for rate in [0.25,0.5,0.75,1,1.25,1.5,2,3,4] %}<option value="{{ rate }}"{% if clip.rate|default(1) == rate %} selected{% endif %}>{{ rate }}×</option>{% endfor %}</select></label><div class="edit-clip-top"><span class="edit-clip-number" data-edit-number>{{ index+1 }}</span><strong>{{ source ? source.title : 'Source retirée' }}</strong><div class="edit-order"><button class="account-secondary" type="button" data-action="edit#up" aria-label="Monter le clip {{ index+1 }}" hidden data-edit-control>↑</button><button class="account-secondary" type="button" data-action="edit#down" aria-label="Descendre le clip {{ index+1 }}" hidden data-edit-control>↓</button></div></div>
<div class="edit-clip-body">{% if source %}<video style="--edit-ratio:{{ project.format == '16:9' ? 1.777778 : (project.format == '1:1' ? 1 : 0.5625) }};aspect-ratio:{{ project.format|replace({':':'/'}) }}" controls playsinline preload="none" src="{{ path('app_video_stream',{id:source.id}) }}" data-edit-player data-action="timeupdate->edit#limit loadedmetadata->edit#seek play->edit#seek" aria-label="Aperçu de {{ source.title }}"></video>{% else %}<p role="alert">La source a été retirée. Retire ce clip du montage pour continuer.</p>{% endif %}<details class="editor-precise"><summary>Réglages précis des coupes</summary><div class="edit-trims"><label class="editor-trim-slider" data-edit-control hidden>Couper le début<input type="range" min="0" max="{{ source ? source.duration : 180 }}" step="0.05" value="{{ clip.start }}" data-trim="start" data-action="input->edit#trim"></label><label class="editor-trim-slider" data-edit-control hidden>Couper la fin<input type="range" min="0" max="{{ source ? source.duration : 180 }}" step="0.05" value="{{ clip.end }}" data-trim="end" data-action="input->edit#trim"></label><label>Début (secondes)<input type="number" name="clips[{{ index }}][start]" value="{{ clip.start }}" min="0" max="{{ source ? source.duration : 180 }}" step="0.001" required data-edit-start data-action="focus->edit#remember input->edit#change change->edit#seekClip"></label><label>Fin (secondes)<input type="number" name="clips[{{ index }}][end]" value="{{ clip.end }}" min="0.1" max="{{ source ? source.duration : 180 }}" step="0.001" required data-edit-end data-action="focus->edit#remember input->edit#change"></label><label>Position<input type="number" name="clips[{{ index }}][position]" value="{{ index+1 }}" min="1" max="8" step="1" data-edit-position data-action="change->edit#sort"></label><label class="edit-omit"><input type="checkbox" name="clips[{{ index }}][omit]" value="1" data-edit-omit data-action="change->edit#change"> Retirer ce clip du montage</label></div></details></div>

{% set look = clip.look|default({}) %}<details class="editor-precise"><summary>Cadrage et effets</summary><div class="editor-clip-look">
{% for key,label in {zoom:'Zoom',x:'Cadrage horizontal',y:'Cadrage vertical',brightness:'Luminosité',contrast:'Contraste',saturation:'Saturation',intensity:'Intensité du filtre · %',fadeIn:'Fondu d’entrée · s',fadeOut:'Fondu de sortie · s'} %}<label>{{ label }}<input type="range" name="clips[{{ index }}][look][{{ key }}]" min="{{ key == 'zoom' ? 1 : (key in ['brightness','contrast'] ? 0.5 : 0) }}" max="{{ key == 'zoom' ? 3 : (key == 'intensity' ? 100 : (key in ['x','y'] ? 1 : 2)) }}" step="{{ key == 'intensity' ? 1 : 0.01 }}" value="{{ attribute(look,key)|default(key in ['zoom','brightness','contrast','saturation'] ? 1 : (key in ['x','y'] ? 0.5 : (key == 'intensity' ? 100 : 0))) }}" data-look-{{ key }} data-action="focus->edit#remember input->edit#lookChange"></label>{% endfor %}
<label>Rotation<select name="clips[{{ index }}][look][rotation]" data-look-rotation data-action="focus->edit#remember change->edit#lookChange">{% for rotation in [0,90,180,270] %}<option value="{{ rotation }}"{% if look.rotation|default(0) == rotation %} selected{% endif %}>{{ rotation }}°</option>{% endfor %}</select></label><label>Miroir<select name="clips[{{ index }}][look][flip]" data-look-flip data-action="focus->edit#remember change->edit#lookChange"><option value="0">Non</option><option value="1"{% if look.flip|default(false) %} selected{% endif %}>Oui</option></select></label>
<label>Filtre<select name="clips[{{ index }}][look][filter]" data-look-filter data-action="focus->edit#remember change->edit#lookChange">{% for key,label in {none:'Original',warm:'Chaud',cool:'Froid',vivid:'Vif',soft:'Doux',bw:'Noir et blanc'} %}<option value="{{ key }}"{% if look.filter|default('none') == key %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label></div></details></article>
